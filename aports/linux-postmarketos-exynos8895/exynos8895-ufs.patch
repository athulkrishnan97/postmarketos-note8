+static u8 exynos_ufs_get_upmcrs(struct ufs_hba *hba,
+				const struct uic_command *cmd)
+{
+	struct exynos_ufs *ufs = ufshcd_get_variant(hba);
+
+	if (ufs && (ufs->opts & EXYNOS_UFS_OPT_UNIPRO_DIRECT_RESULT)) {
+		switch (cmd->command) {
+		case UIC_CMD_DME_SET:
+			return unipro_readl(ufs, UNIP_DME_PWR_IND_RESULT);
+		case UIC_CMD_DME_HIBER_ENTER:
+			return unipro_readl(ufs, UNIP_DME_HIBERN8_ENTER_IND_RESULT);
+		case UIC_CMD_DME_HIBER_EXIT:
+			return unipro_readl(ufs, UNIP_DME_HIBERN8_EXIT_IND_RESULT);
+		}
+	}
+
+	return (ufshcd_readl(hba, REG_CONTROLLER_STATUS) >> 8) & 0x7;
+}
