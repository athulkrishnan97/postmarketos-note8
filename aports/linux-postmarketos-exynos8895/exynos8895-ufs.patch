@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * UFS PHY driver data for Samsung Exynos 8895
+ *
+ * The M-PHY PMA/PCS setup for this SoC is interleaved with UniPro
+ * attribute writes and is applied by the ufs-exynos host driver from the
+ * downstream tables, which also releases the PHY isolation once at probe.
+ * This entry only provides the PHY to the host, with no calibration and a
+ * zero isolation mask so the PMA configuration survives link restarts.
+ */
+
+#include "phy-samsung-ufs.h"
+
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL	0x724
+
+static const struct samsung_ufs_phy_cfg *exynos8895_ufs_phy_cfgs[CFG_TAG_MAX];
+
+const struct samsung_ufs_phy_drvdata exynos8895_ufs_phy = {
+	.cfgs = exynos8895_ufs_phy_cfgs,
+	.isol = {
+		.offset = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL,
+		.mask = 0,
+		.en = 0,
+	},
+};
