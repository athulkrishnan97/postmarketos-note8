+static int exynos8895_ufs_drv_init(struct exynos_ufs *ufs)
+{
+	struct device *dev = ufs->hba->dev;
+	struct platform_device *pdev = to_platform_device(dev);
+	struct regmap *pmu;
+	struct resource *res;
+
+	/* the PMA is also the PHY provider's; map it without claiming it */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "pma");
+	if (!res)
+		return -ENODEV;
+	ufs->reg_pma = devm_ioremap(dev, res->start, resource_size(res));
+	if (!ufs->reg_pma)
+		return -ENOMEM;
+
+	/*
+	 * Release the M-PHY isolation once, like downstream does at probe;
+	 * the PHY provider leaves it alone so the PMA setup survives link
+	 * retries.
+	 */
+	pmu = syscon_regmap_lookup_by_phandle(dev->of_node,
+					      "samsung,pmu-syscon");
+	if (IS_ERR(pmu))
+		return PTR_ERR(pmu);
+	regmap_update_bits(pmu, EXYNOS8895_PMU_UFS_PHY_CTRL, BIT(0), BIT(0));
+
+	/*
+	 * Downstream does not divide the UniPro APB clock on this host
+	 * revision (pclk = the full 166 MHz ACLK); the PCS clock-period
+	 * values in the tables derive from that.
+	 */
+	/* M-PHY reference clock from the TCXO alternative path */
+	if (ufs->sysreg)
+		regmap_update_bits(ufs->sysreg, EXYNOS8895_SYSREG_UFS_TCXO_SEL,
+				   BIT(0), BIT(0));
+
+	return 0;
+}
+
+static int exynos8895_ufs_pre_link(struct exynos_ufs *ufs)
+{
+	struct ufs_hba *hba = ufs->hba;
+
+	if (ufs->avail_ln_rx == 0 || ufs->avail_ln_tx == 0) {
+		ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILRXDATALANES),
+			       &ufs->avail_ln_rx);
+		ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILTXDATALANES),
+			       &ufs->avail_ln_tx);
+	}
+
+	hci_writel(ufs, hci_readl(ufs, HCI_MPHY_REFCLK_SEL) | MPHY_REFCLK_SEL,
+		   HCI_MPHY_REFCLK_SEL);
+
+	/*
+	 * The HW auto clock gating reset default flipped to "enabled" on this
+	 * SoC; downstream disables it before link startup, otherwise the
+	 * UniPro/M-PHY clocks can be gated and link startup never completes.
+	 */
+	hci_writel(ufs, hci_readl(ufs, HCI_UFS_ACG_DISABLE) |
+		   HCI_UFS_ACG_DISABLE_EN, HCI_UFS_ACG_DISABLE);
+
+	exynos8895_ufs_config(ufs, exynos8895_phy_init, NULL);
+	return 0;
+}
+
+static int exynos8895_ufs_post_link(struct exynos_ufs *ufs)
+{
+	exynos8895_ufs_config(ufs, exynos8895_post_phy_init, NULL);
+	return 0;
+}
+
+static int exynos8895_ufs_pre_pwr_change(struct exynos_ufs *ufs,
+					 struct ufs_pa_layer_attr *pwr)
+{
+	const struct exynos8895_ufs_cfg *tbl;
+
+	if (pwr->pwr_rx == FAST_MODE || pwr->pwr_rx == FASTAUTO_MODE)
+		tbl = pwr->hs_rate == PA_HS_MODE_A ? exynos8895_calib_of_hs_rate_a :
+						     exynos8895_calib_of_hs_rate_b;
+	else
+		tbl = exynos8895_calib_of_pwm;
+
+	exynos8895_ufs_config(ufs, tbl, pwr);
+	return 0;
+}
