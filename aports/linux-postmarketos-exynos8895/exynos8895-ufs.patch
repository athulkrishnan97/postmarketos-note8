+static bool exynos8895_ufs_match_mode(const struct ufs_pa_layer_attr *pmd,
+				      u32 flg)
+{
+	bool hs = pmd->pwr_rx == FAST_MODE || pmd->pwr_rx == FASTAUTO_MODE;
+	u32 g = pmd->gear_rx, l = pmd->lane_rx;
+
+	if (flg == E8895_PMD_ALL)
+		return true;
+	if (flg == E8895_PMD_HS)
+		return hs;
+	if (flg == E8895_PMD_PWM)
+		return !hs;
+	if (!g || !l || l > 2 || g > (hs ? 3 : 5))
+		return false;
+
+	return flg & (hs ? E8895_PMD_HS_BIT(g, l) : E8895_PMD_PWM_BIT(g, l));
+}
+
+static void exynos8895_ufs_config(struct exynos_ufs *ufs,
+				  const struct exynos8895_ufs_cfg *cfg,
+				  const struct ufs_pa_layer_attr *pmd)
+{
+	struct ufs_hba *hba = ufs->hba;
+	u32 mclk_period = NSEC_PER_SEC / ufs->mclk_rate;
+	u32 pclk_period = NSEC_PER_SEC / ufs->pclk_rate;
+	int lanes = ufs->avail_ln_rx ?: 1;
+	int i;
+
+	for (; cfg->lyr != E8895_END; cfg++) {
+		if (pmd && !exynos8895_ufs_match_mode(pmd, cfg->flg))
+			continue;
+
+		for (i = 0; i < lanes; i++) {
+			switch (cfg->lyr) {
+			case E8895_UNIPRO_STD_MIB:
+			case E8895_UNIPRO_DBG_MIB:
+			case E8895_PCS_COMN:
+				if (!i)
+					ufshcd_dme_set(hba, UIC_ARG_MIB(cfg->addr),
+						       cfg->val);
+				break;
+			case E8895_PCS_RXTX:
+				ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(cfg->addr, i),
+					       cfg->val);
+				break;
+			case E8895_UNIPRO_DBG_PRD:
+				if (!i)
+					ufshcd_dme_set(hba, UIC_ARG_MIB(cfg->addr),
+						       mclk_period);
+				break;
+			case E8895_PCS_RX:
+				ufshcd_dme_set(hba,
+					UIC_ARG_MIB_SEL(cfg->addr, RX_LANE_0 + i),
+					cfg->val);
+				break;
+			case E8895_PCS_TX:
+				ufshcd_dme_set(hba,
+					UIC_ARG_MIB_SEL(cfg->addr, TX_LANE_0 + i),
+					cfg->val);
+				break;
+			case E8895_PCS_RX_PRD:
+				ufshcd_dme_set(hba,
+					UIC_ARG_MIB_SEL(cfg->addr, RX_LANE_0 + i),
+					pclk_period);
+				break;
+			case E8895_PCS_TX_PRD:
+				ufshcd_dme_set(hba,
+					UIC_ARG_MIB_SEL(cfg->addr, TX_LANE_0 + i),
+					pclk_period);
+				break;
+			case E8895_PMA_COMN:
+				if (!i)
+					writel(cfg->val, ufs->reg_pma + cfg->addr);
+				break;
+			case E8895_PMA_TRSV:
+				writel(cfg->val, ufs->reg_pma + cfg->addr +
+				       EXYNOS8895_PMA_TRSV_STRIDE * i);
+				break;
+			case E8895_UNIPRO_DBG_APB:
+				if (!i)
+					unipro_writel(ufs, cfg->val, cfg->addr);
+				break;
+			case E8895_WAIT:
+				if (!i)
+					udelay(cfg->val);
+				break;
+			}
+		}
+	}
+}
