+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 8895 DSIM0 MIPI-DSI host driver
+ *
+ * Minimal command-mode DSI host sufficient to probe, reset, initialize
+ * and read the Galaxy Note 8 (greatlte) S6E3HA6 panel.  The register
+ * map and init sequence follow the downstream Exynos 8895 DSIM
+ * (drivers/video/fbdev/exynos/dpu, CONFIG_SOC_EXYNOS8895 path), not the
+ * legacy DSIM found in samsung-dsim.c.
+ *
+ * Copyright (c) 2026 The postmarketOS project
+ */
+
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/spinlock.h>
+
+#include <drm/drm_mipi_dsi.h>
+
+#include <video/mipi_display.h>
+
+#include "exynos8895-dsim.h"
+
+/* DSIM register offsets (Exynos 8895) */
+#define DSIM_SWRST			0x04
+#define DSIM_DPHY_RST			BIT(16)
+#define DSIM_SWRST_RESET		BIT(0)
+
+#define DSIM_LINK_STATUS3		0x14
+#define DSIM_LINK_STATUS3_PLL_STABLE	BIT(0)
+
+#define DSIM_CLK_CTRL			0x20
+#define DSIM_CLK_CTRL_NONCONT_CLOCK_LANE	BIT(25)
+#define DSIM_CLK_CTRL_TX_REQUEST_HSCLK	BIT(20)
+#define DSIM_CLK_CTRL_WORDCLK_EN	BIT(17)
+#define DSIM_CLK_CTRL_ESCCLK_EN		BIT(16)
+#define DSIM_CLK_CTRL_LANE_ESCCLK_EN(x)	((x) << 8)
+#define DSIM_CLK_CTRL_LANE_ESCCLK_EN_MASK	(0x1f << 8)
+#define DSIM_CLK_CTRL_ESC_PRESCALER(x)	((x) << 0)
+#define DSIM_CLK_CTRL_ESC_PRESCALER_MASK	(0xff << 0)
+
+#define DSIM_TIMEOUT			0x28
+#define DSIM_TIMEOUT_BTA_TOUT(x)	((x) << 16)
+#define DSIM_TIMEOUT_LPDR_TOUT(x)	((x) << 0)
+
+#define DSIM_ESCMODE			0x2c
+#define DSIM_ESCMODE_STOP_STATE_CNT(x)	((x) << 21)
+
+#define DSIM_NUM_OF_TRANSFER		0x30
+#define DSIM_UNDERRUN_CTRL		0x34
+#define DSIM_THRESHOLD			0x38
+#define DSIM_RESOL			0x3c
+#define DSIM_RESOL_VRESOL(x)		(((x) & 0x1fff) << 16)
+#define DSIM_RESOL_HRESOL(x)		(((x) & 0x1fff) << 0)
+
+#define DSIM_CONFIG			0x4c
+#define DSIM_CONFIG_CPRS_EN		BIT(19)
+#define DSIM_CONFIG_VIDEO_MODE		BIT(18)
+#define DSIM_CONFIG_PIXEL_FORMAT_MASK	(0x3 << 13)
+#define DSIM_CONFIG_PER_FRAME_READ_EN	BIT(8)
+#define DSIM_CONFIG_EOTP_EN		BIT(7)
+#define DSIM_CONFIG_NUM_OF_DATA_LANE(x)	((x) << 5)
+#define DSIM_CONFIG_NUM_OF_DATA_LANE_MASK	(0x3 << 5)
+#define DSIM_CONFIG_LANES_EN_MASK	0x1f
+
+#define DSIM_INTSRC			0x50
+#define DSIM_INTSRC_SFR_PH_FIFO_EMPTY	BIT(28)
+#define DSIM_INTSRC_RX_DATA_DONE	BIT(18)
+#define DSIM_INTSRC_ERR_RX_ECC		BIT(15)
+#define DSIM_INTSRC_UNDER_RUN		BIT(19)
+#define DSIM_INTMSK			0x54
+#define DSIM_INTMSK_SW_RST_RELEASE	BIT(30)
+#define DSIM_INTMSK_SFR_PL_FIFO_EMPTY	BIT(29)
+#define DSIM_INTMSK_SFR_PH_FIFO_EMPTY	BIT(28)
+#define DSIM_INTMSK_FRAME_DONE		BIT(24)
+#define DSIM_INTMSK_INVALID_SFR_VALUE	BIT(23)
+#define DSIM_INTMSK_UNDER_RUN		BIT(19)
+#define DSIM_INTMSK_RX_DATA_DONE	BIT(18)
+#define DSIM_INTMSK_ERR_RX_ECC		BIT(15)
+#define DSIM_INTMSK_VT_STATUS		BIT(13)
+
+#define DSIM_PKTHDR			0x58
+#define DSIM_PKTHDR_BTA_TYPE(x)		((x) << 24)
+#define DSIM_PKTHDR_DATA1(x)		((x) << 16)
+#define DSIM_PKTHDR_DATA0(x)		((x) << 8)
+#define DSIM_PKTHDR_ID(x)		((x) << 0)
+#define DSIM_PKTHDR_DATA_MASK		0x1ffffff
+
+#define DSIM_CPRS_CTRL			0x74
+#define DSIM_CPRS_CTRL_MULI_SLICE_PACKET	BIT(3)
+#define DSIM_CPRS_CTRL_NUM_OF_SLICE(x)	((x) << 0)
+#define DSIM_CPRS_CTRL_NUM_OF_SLICE_MASK	(0x7 << 0)
+
+#define DSIM_SLICE01			0x78
+#define DSIM_SLICE23			0x7c
+#define DSIM_SLICE01_SIZE_OF_SLICE1(x)	((x) << 16)
+#define DSIM_SLICE01_SIZE_OF_SLICE0(x)	((x) << 0)
+
+#define DSIM_PAYLOAD			0x5c
+#define DSIM_RXFIFO			0x60
+
+#define DSIM_SFR_CTRL			0x64
+#define DSIM_CMD_TE_CTRL0		0x84
+#define DSIM_CMD_TE_CTRL1		0x88
+
+#define DSIM_FIFOCTRL			0x68
+#define DSIM_FIFOCTRL_EMPTY_RX		BIT(12)
+#define DSIM_FIFOCTRL_EMPTY_PH_SFR	BIT(10)
+#define DSIM_FIFOCTRL_EMPTY_PL_SFR	BIT(8)
+
+#define DSIM_PLLCTRL			0xa0
+#define DSIM_PLLCTRL_PLL_EN		BIT(23)
+#define DSIM_PLLCTRL_PMS_MASK		0x7ffff
+
+#define DSIM_PLL_CTRL1			0xa4
+#define DSIM_PLL_CTRL2			0xa8
+#define DSIM_PLLTMR			0xac
+#define DSIM_PHYCTRL_B1			0xb0
+#define DSIM_PHYCTRL_B2			0xb4
+#define DSIM_PHYCTRL_B3			0xb8
+#define DSIM_PHYCTRL_B4			0xbc
+#define DSIM_PHYCTRL_M1			0xc0
+#define DSIM_PHYCTRL_M2			0xc4
+#define DSIM_PHYCTRL_M3			0xc8
+#define DSIM_PHYCTRL_M4			0xcc
+#define DSIM_PHY_TIMING			0xd0
+#define DSIM_PHY_TIMING1		0xd4
+#define DSIM_PHY_TIMING2		0xd8
+
+/* DPU0 CMU (second reg range) */
+#define DPU0_CMU_USER_MUX		0x100
+#define DPU0_CMU_USER_MUX_SW_USER	BIT(4)
+#define DPU0_CMU_USER_MUX_BUSY		BIT(7)
+#define DPU0_CMU_BUSP_DIV		0x1808
+#define DPU0_CMU_BUSP_DIV_AUTOGATE	BIT(28)
+#define DPU0_CMU_DPU1_BUSD_GATE	0x2000
+#define DPU0_CMU_DPU1_BUSP_GATE	0x2004
+#define DPU0_CMU_DPU0_PCLK_GATE	0x2008
+#define DPU0_CMU_AXI2APB_P0_GATE	0x2054
+#define DPU0_CMU_AXI2APB_P1_GATE	0x2058
+#define DPU0_CMU_DSIM0_PCLK_GATE	0x204c
+#define DPU0_CMU_LHM_AXI_P0_GATE	0x20a8
+#define DPU0_CMU_RSTNSYNC_BUSP_GATE	0x20dc
+#define DPU0_CMU_GATE_ON		(0x3 << 20)
+
+/* DPU1 CMU (DSIM0 is in pd_dpu1) */
+#define DPU1_CMU_BUSD_USER_MUX		0x100
+#define DPU1_CMU_BUSP_USER_MUX		0x120
+#define DPU1_CMU_USER_MUX_SW_USER	BIT(4)
+#define DPU1_CMU_USER_MUX_BUSY		BIT(7)
+#define DPU1_CMU_DPU1_PCLK_GATE	0x2000
+#define DPU1_CMU_GATE_ON		(0x3 << 20)
+
+/* PMU */
+#define PMU_DPU0_CONFIGURATION		0x4060
+#define PMU_DPU0_STATUS			0x4064
+#define PMU_DPU1_CONFIGURATION		0x4080
+#define PMU_DPU1_STATUS			0x4084
+#define PMU_MIPI_PHY_M4S4_ISOLATION	0x710
+#define PMU_LOCAL_PWR_CFG		0xf
+
+/* DISP_SS sysreg */
+#define DISP_SS_LPMUX			0x0
+#define DISP_SS_LPMUX_VAL		0x1201
+#define DISP_SS_PHY_OWNER		0x8
+#define DISP_SS_PHY_OWNER_DSI		0
+
+/* PLL / panel constants (greatlte S6E3HA6, 26 MHz ref -> 898 MHz HS) */
+#define DSIM_PLL_P			5
+#define DSIM_PLL_M			691
+#define DSIM_PLL_S			2
+#define DSIM_ESC_PRESCALER		3	/* 56 MHz / 3 = ~18.7 MHz */
+#define DSIM_PLL_STABLE_TIME		0x13880
+#define DSIM_STOP_STATE_CNT		0xa
+#define DSIM_BTA_TIMEOUT		0xff
+#define DSIM_LP_RX_TIMEOUT		0xffff
+#define DSIM_CMD_UNDERRUN_LP_REF	3022
+#define DSIM_HRESOL			1440
+#define DSIM_VRESOL			2960
+#define DSIM_THRESHOLD_LEVEL		(DSIM_HRESOL / 3)	/* DSC */
+#define DSIM_NUM_OF_TRANSFER_LINE	DSIM_VRESOL
+
+#define DSIM_INT_UNMASK		(DSIM_INTMSK_SW_RST_RELEASE | \
+				 DSIM_INTMSK_SFR_PL_FIFO_EMPTY | \
+				 DSIM_INTMSK_SFR_PH_FIFO_EMPTY | \
+				 DSIM_INTMSK_FRAME_DONE | \
+				 DSIM_INTMSK_INVALID_SFR_VALUE | \
+				 DSIM_INTMSK_RX_DATA_DONE | \
+				 DSIM_INTMSK_ERR_RX_ECC | \
+				 DSIM_INTMSK_VT_STATUS)
+
+#define DSIM_WR_TIMEOUT_MS		250
+#define DSIM_RD_TIMEOUT_MS		100
+#define DSIM_RX_FIFO_DEPTH		64
+
+/*
+ * DSC scanout configuration: 2 slices of 720px -> 480 bytes per line at
+ * 8bpp (720 * 8 / 12), matching the S6E3HA6 PPS (GREAT_A2_S3).
+ */
+#define DSIM_DSC_NUM_OF_SLICE		2
+#define DSIM_DSC_SIZE_OF_SLICE		720
+#define DSIM_DSC_BYTES_PER_LINE		480
+
+struct exynos8895_dsim {
+	struct device *dev;
+	struct mipi_dsi_host host;
+
+	void __iomem *regs;
+	void __iomem *cmu;
+	void __iomem *cmu1;
+
+	struct regmap *pmu;
+	struct regmap *disp_ss;
+
+	struct clk *dpu_bus;
+	int irq;
+
+	struct mutex cmd_lock;
+	spinlock_t slock;
+	struct completion ph_wr_comp;
+	struct completion rd_comp;
+
+	bool powered;
+	bool attached;
+};
+
+static inline struct exynos8895_dsim *host_to_dsim(struct mipi_dsi_host *host)
+{
+	return container_of(host, struct exynos8895_dsim, host);
+}
+
+static inline void dsim_write(struct exynos8895_dsim *dsim, u32 reg, u32 val)
+{
+	writel(val, dsim->regs + reg);
+}
+
+static inline u32 dsim_read(struct exynos8895_dsim *dsim, u32 reg)
+{
+	return readl(dsim->regs + reg);
+}
+
+static inline void dsim_write_mask(struct exynos8895_dsim *dsim, u32 reg,
+				   u32 val, u32 mask)
+{
+	u32 v = dsim_read(dsim, reg);
+
+	v &= ~mask;
+	v |= val & mask;
+	dsim_write(dsim, reg, v);
+}
+
+static int dsim_enable_power_domain(struct exynos8895_dsim *dsim,
+				    u32 cfg_off, u32 stat_off, const char *name)
+{
+	u32 val;
+	int ret;
+
+	regmap_write(dsim->pmu, cfg_off, PMU_LOCAL_PWR_CFG);
+	ret = regmap_read_poll_timeout(dsim->pmu, stat_off, val,
+				       (val & PMU_LOCAL_PWR_CFG) == PMU_LOCAL_PWR_CFG,
+				       1000, 50000);
+	if (ret) {
+		dev_err(dsim->dev, "%s failed to power on (status 0x%x)\n",
+			name, val);
+		return ret;
+	}
+
+	dev_info(dsim->dev, "%s on\n", name);
+	return 0;
+}
+
+static int dsim_setup_clocks(struct exynos8895_dsim *dsim)
+{
+	static const struct {
+		u32 offset;
+		const char *name;
+	} gates[] = {
+		{ DPU0_CMU_DPU0_PCLK_GATE, "DPU0 CMU pclk" },
+		{ DPU0_CMU_AXI2APB_P0_GATE, "DPU0 AXI2APB P0" },
+		{ DPU0_CMU_AXI2APB_P1_GATE, "DPU0 AXI2APB P1" },
+		{ DPU0_CMU_LHM_AXI_P0_GATE, "DPU0 LHM AXI P0" },
+		{ DPU0_CMU_RSTNSYNC_BUSP_GATE, "DPU0 BUSP reset sync" },
+		{ DPU0_CMU_DPU1_BUSD_GATE, "DPU1 BUSD" },
+		{ DPU0_CMU_DPU1_BUSP_GATE, "DPU1 BUSP" },
+		{ DPU0_CMU_DSIM0_PCLK_GATE, "DSIM0 pclk" },
+	};
+	u32 val;
+	int ret;
+	int i;
+
+	dev_info(dsim->dev, "step: DPU0 user mux switch\n");
+	writel(readl(dsim->cmu + DPU0_CMU_USER_MUX) | DPU0_CMU_USER_MUX_SW_USER,
+	       dsim->cmu + DPU0_CMU_USER_MUX);
+
+	ret = readl_poll_timeout(dsim->cmu + DPU0_CMU_USER_MUX, val,
+				 !(val & DPU0_CMU_USER_MUX_BUSY), 100, 10000);
+	if (ret) {
+		dev_err(dsim->dev, "DPU0 user mux switch timed out\n");
+		return ret;
+	}
+	dev_info(dsim->dev, "step: DPU0 user mux ready (0x%x)\n", val);
+
+	val = readl(dsim->cmu + DPU0_CMU_BUSP_DIV);
+	dev_info(dsim->dev, "step: DPU0 BUSP divider old 0x%x\n", val);
+	writel(val | DPU0_CMU_BUSP_DIV_AUTOGATE,
+	       dsim->cmu + DPU0_CMU_BUSP_DIV);
+	val = readl(dsim->cmu + DPU0_CMU_BUSP_DIV);
+	dev_info(dsim->dev, "step: DPU0 BUSP divider new 0x%x\n", val);
+
+	for (i = 0; i < ARRAY_SIZE(gates); i++) {
+		val = readl(dsim->cmu + gates[i].offset);
+		dev_info(dsim->dev, "step: %s gate old 0x%x\n", gates[i].name, val);
+		writel(val | DPU0_CMU_GATE_ON, dsim->cmu + gates[i].offset);
+		val = readl(dsim->cmu + gates[i].offset);
+		dev_info(dsim->dev, "step: %s gate new 0x%x\n", gates[i].name, val);
+	}
+
+	static const struct {
+		u32 offset;
+		const char *name;
+	} dpu1_muxes[] = {
+		{ DPU1_CMU_BUSD_USER_MUX, "DPU1 BUSD user mux" },
+		{ DPU1_CMU_BUSP_USER_MUX, "DPU1 BUSP user mux" },
+	};
+
+	for (i = 0; i < ARRAY_SIZE(dpu1_muxes); i++) {
+		dev_info(dsim->dev, "step: %s switch\n", dpu1_muxes[i].name);
+		writel(readl(dsim->cmu1 + dpu1_muxes[i].offset) |
+		       DPU1_CMU_USER_MUX_SW_USER,
+		       dsim->cmu1 + dpu1_muxes[i].offset);
+		ret = readl_poll_timeout(dsim->cmu1 + dpu1_muxes[i].offset, val,
+					 !(val & DPU1_CMU_USER_MUX_BUSY),
+					 100, 10000);
+		if (ret) {
+			dev_err(dsim->dev, "%s timed out\n", dpu1_muxes[i].name);
+			return ret;
+		}
+		dev_info(dsim->dev, "step: %s ready (0x%x)\n",
+			 dpu1_muxes[i].name, val);
+	}
+
+	val = readl(dsim->cmu1 + DPU1_CMU_DPU1_PCLK_GATE);
+	dev_info(dsim->dev, "step: DPU1 CMU pclk gate old 0x%x\n", val);
+	writel(val | DPU1_CMU_GATE_ON, dsim->cmu1 + DPU1_CMU_DPU1_PCLK_GATE);
+	val = readl(dsim->cmu1 + DPU1_CMU_DPU1_PCLK_GATE);
+	dev_info(dsim->dev, "step: DPU1 CMU pclk gate new 0x%x\n", val);
+
+	return 0;
+}
+
+static int dsim_pll_enable(struct exynos8895_dsim *dsim)
+{
+	u32 pms = (DSIM_PLL_P << 13) | (DSIM_PLL_M << 3) | DSIM_PLL_S;
+	u32 val;
+	int ret;
+
+	dev_info(dsim->dev, "step: DSIM escape clock setup\n");
+	dsim_write_mask(dsim, DSIM_CLK_CTRL,
+			DSIM_CLK_CTRL_ESCCLK_EN |
+			DSIM_CLK_CTRL_ESC_PRESCALER(DSIM_ESC_PRESCALER),
+			DSIM_CLK_CTRL_ESCCLK_EN |
+			DSIM_CLK_CTRL_ESC_PRESCALER_MASK);
+
+	dev_info(dsim->dev, "step: DSIM PHY timing setup\n");
+	dsim_write(dsim, DSIM_PHY_TIMING, (6 << 8) | 5);
+	dsim_write(dsim, DSIM_PHY_TIMING1, (8 << 24) | (14 << 16) | (7 << 8) | 6);
+	dsim_write(dsim, DSIM_PHY_TIMING2, (8 << 16) | (5 << 8) | 10);
+	dsim_write(dsim, DSIM_PHYCTRL_B1, 0x1a9);
+
+	dev_info(dsim->dev, "step: DSIM PHY characteristic setup\n");
+	dsim_write(dsim, DSIM_PLL_CTRL1, 0);
+	dsim_write(dsim, DSIM_PLL_CTRL2, 0x03800000);
+	dsim_write(dsim, DSIM_PHYCTRL_B2, 0x800);
+	dsim_write(dsim, DSIM_PHYCTRL_B3, 0x10001249);
+	dsim_write(dsim, DSIM_PHYCTRL_B4, 0x500000);
+	dsim_write(dsim, DSIM_PHYCTRL_M1, 0x1980);
+	dsim_write(dsim, DSIM_PHYCTRL_M2, 0);
+	dsim_write(dsim, DSIM_PHYCTRL_M3, 0);
+	dsim_write(dsim, DSIM_PHYCTRL_M4, 0);
+
+	dev_info(dsim->dev, "step: DSIM PLL enable PMS %d/%d/%d\n",
+		 DSIM_PLL_P, DSIM_PLL_M, DSIM_PLL_S);
+	dsim_write_mask(dsim, DSIM_PLLCTRL, pms | DSIM_PLLCTRL_PLL_EN,
+			DSIM_PLLCTRL_PMS_MASK | DSIM_PLLCTRL_PLL_EN);
+	dsim_write(dsim, DSIM_PLLTMR, DSIM_PLL_STABLE_TIME);
+
+	ret = readl_poll_timeout(dsim->regs + DSIM_LINK_STATUS3, val,
+				 val & DSIM_LINK_STATUS3_PLL_STABLE, 10, 10000);
+	if (ret) {
+		dev_err(dsim->dev, "DPHY PLL failed to stabilize\n");
+		return ret;
+	}
+
+	dev_info(dsim->dev, "DPHY PLL stable (status 0x%x)\n", val);
+	return 0;
+}
+
+static void dsim_setup_lanes(struct exynos8895_dsim *dsim)
+{
+	dev_info(dsim->dev, "step: DSIM lane enable\n");
+	dsim_write_mask(dsim, DSIM_CONFIG, 0x1f, DSIM_CONFIG_LANES_EN_MASK);
+	udelay(300);
+
+	dev_info(dsim->dev, "step: DSIM lane escape clocks + word clock\n");
+	dsim_write_mask(dsim, DSIM_CLK_CTRL,
+			DSIM_CLK_CTRL_LANE_ESCCLK_EN(0x1f) |
+			DSIM_CLK_CTRL_WORDCLK_EN,
+			DSIM_CLK_CTRL_LANE_ESCCLK_EN_MASK |
+			DSIM_CLK_CTRL_WORDCLK_EN);
+
+	dev_info(dsim->dev, "step: DSIM DPHY reset release\n");
+	dsim_write_mask(dsim, DSIM_SWRST, DSIM_DPHY_RST, DSIM_DPHY_RST);
+}
+
+static void dsim_setup_config(struct exynos8895_dsim *dsim)
+{
+	dev_info(dsim->dev, "step: DSIM command-mode clock config\n");
+	dsim_write_mask(dsim, DSIM_CLK_CTRL, DSIM_CLK_CTRL_NONCONT_CLOCK_LANE,
+			DSIM_CLK_CTRL_NONCONT_CLOCK_LANE);
+
+	dev_info(dsim->dev, "step: DSIM timeout/underrun/resolution config\n");
+	dsim_write(dsim, DSIM_TIMEOUT,
+		   DSIM_TIMEOUT_BTA_TOUT(DSIM_BTA_TIMEOUT) |
+		   DSIM_TIMEOUT_LPDR_TOUT(DSIM_LP_RX_TIMEOUT));
+	dsim_write_mask(dsim, DSIM_ESCMODE,
+			DSIM_ESCMODE_STOP_STATE_CNT(DSIM_STOP_STATE_CNT),
+			DSIM_ESCMODE_STOP_STATE_CNT(0x7ff));
+	dsim_write(dsim, DSIM_UNDERRUN_CTRL, DSIM_CMD_UNDERRUN_LP_REF);
+	dsim_write(dsim, DSIM_THRESHOLD, DSIM_HRESOL);
+	dsim_write(dsim, DSIM_RESOL,
+		   DSIM_RESOL_VRESOL(DSIM_VRESOL) |
+		   DSIM_RESOL_HRESOL(DSIM_HRESOL));
+	dsim_write(dsim, DSIM_NUM_OF_TRANSFER, DSIM_NUM_OF_TRANSFER_LINE);
+
+	dev_info(dsim->dev, "step: DSIM non-DSC EOTP/data-lane config for probe\n");
+	dsim_write_mask(dsim, DSIM_CONFIG,
+			DSIM_CONFIG_NUM_OF_DATA_LANE(3) |
+			DSIM_CONFIG_EOTP_EN,
+			DSIM_CONFIG_NUM_OF_DATA_LANE_MASK |
+			DSIM_CONFIG_EOTP_EN |
+			DSIM_CONFIG_PER_FRAME_READ_EN |
+			DSIM_CONFIG_CPRS_EN |
+			DSIM_CONFIG_VIDEO_MODE |
+			DSIM_CONFIG_PIXEL_FORMAT_MASK);
+
+	dev_info(dsim->dev, "step: DSIM command-mode TE timing\n");
+	dsim_write(dsim, DSIM_CMD_TE_CTRL0, 86);
+	dsim_write(dsim, DSIM_CMD_TE_CTRL1, (8867 << 16) | 10102);
+
+	dev_info(dsim->dev, "step: DSIM SFR shadow + HS clock request\n");
+	dsim_write(dsim, DSIM_SFR_CTRL, 0x3);
+	dsim_write_mask(dsim, DSIM_CLK_CTRL, DSIM_CLK_CTRL_TX_REQUEST_HSCLK,
+			DSIM_CLK_CTRL_TX_REQUEST_HSCLK);
+}
+
+static int dsim_hw_init(struct exynos8895_dsim *dsim)
+{
+	u32 val;
+	int ret;
+
+	dev_info(dsim->dev, "step: DSIM bootloader-state check\n");
+	val = dsim_read(dsim, DSIM_LINK_STATUS3);
+	dev_info(dsim->dev, "step: DSIM LINK_STATUS3 0x%x\n", val);
+	if (val & DSIM_LINK_STATUS3_PLL_STABLE)
+		dev_info(dsim->dev, "DPHY PLL was stable; reinitializing after panel reset\n");
+
+	dev_info(dsim->dev, "step: DSIM DPHY reset assert\n");
+	dsim_write_mask(dsim, DSIM_SWRST, 0, DSIM_DPHY_RST);
+
+	dev_info(dsim->dev, "step: DSIM software reset\n");
+	dsim_write_mask(dsim, DSIM_SWRST, DSIM_SWRST_RESET, DSIM_SWRST_RESET);
+	ret = readl_poll_timeout(dsim->regs + DSIM_SWRST, val,
+				 !(val & DSIM_SWRST_RESET), 10, 10000);
+	if (ret) {
+		dev_err(dsim->dev, "software reset timed out\n");
+		return ret;
+	}
+	dev_info(dsim->dev, "step: DSIM software reset done\n");
+
+	ret = dsim_pll_enable(dsim);
+	if (ret)
+		return ret;
+
+	dsim_setup_lanes(dsim);
+	dsim_setup_config(dsim);
+
+	dev_info(dsim->dev, "dsim hw init done\n");
+	return 0;
+}
+
+static int dsim_power_on(struct exynos8895_dsim *dsim)
+{
+	int ret;
+
+	if (dsim->powered)
+		return 0;
+
+	dev_info(dsim->dev, "step: pd_dpu0 request\n");
+	ret = dsim_enable_power_domain(dsim, PMU_DPU0_CONFIGURATION,
+				       PMU_DPU0_STATUS, "pd_dpu0");
+	if (ret)
+		return ret;
+
+	dev_info(dsim->dev, "step: pd_dpu1 request\n");
+	ret = dsim_enable_power_domain(dsim, PMU_DPU1_CONFIGURATION,
+				       PMU_DPU1_STATUS, "pd_dpu1");
+	if (ret)
+		return ret;
+
+	dev_info(dsim->dev, "step: MIPI PHY M4S4 isolation release\n");
+	regmap_update_bits(dsim->pmu, PMU_MIPI_PHY_M4S4_ISOLATION, BIT(0), BIT(0));
+	dev_info(dsim->dev, "mipi phy m4s4 isolation released\n");
+
+	dev_info(dsim->dev, "step: DISP_SS sysreg setup\n");
+	regmap_write(dsim->disp_ss, DISP_SS_LPMUX, DISP_SS_LPMUX_VAL);
+	dev_info(dsim->dev, "disp-ss sysreg configured (lpmux 0x%x)\n",
+		 DISP_SS_LPMUX_VAL);
+
+	dev_info(dsim->dev, "step: CMU_TOP DPU bus clock enable\n");
+	ret = clk_prepare_enable(dsim->dpu_bus);
+	if (ret) {
+		dev_err(dsim->dev, "failed to enable dpu_bus: %d\n", ret);
+		return ret;
+	}
+
+	ret = dsim_setup_clocks(dsim);
+	if (ret)
+		return ret;
+
+	ret = dsim_hw_init(dsim);
+	if (ret)
+		return ret;
+
+	dev_info(dsim->dev, "step: DSIM interrupt unmask\n");
+	dsim_write(dsim, DSIM_INTSRC, 0xffffffff);
+	dsim_write_mask(dsim, DSIM_INTMSK, 0, DSIM_INT_UNMASK);
+	enable_irq(dsim->irq);
+
+	dsim->powered = true;
+	dev_info(dsim->dev, "dsim0 powered\n");
+	return 0;
+}
+
+static irqreturn_t dsim_irq_handler(int irq, void *dev_id)
+{
+	struct exynos8895_dsim *dsim = dev_id;
+	u32 intsrc;
+
+	spin_lock(&dsim->slock);
+	intsrc = dsim_read(dsim, DSIM_INTSRC);
+	if (!intsrc) {
+		spin_unlock(&dsim->slock);
+		return IRQ_NONE;
+	}
+
+	if (dsim->powered) {
+		if (intsrc & DSIM_INTSRC_SFR_PH_FIFO_EMPTY)
+			complete(&dsim->ph_wr_comp);
+		if (intsrc & DSIM_INTSRC_RX_DATA_DONE)
+			complete(&dsim->rd_comp);
+		if (intsrc & DSIM_INTSRC_ERR_RX_ECC)
+			dev_err_ratelimited(dsim->dev, "RX ECC multi-bit error\n");
+		if (intsrc & DSIM_INTSRC_UNDER_RUN)
+			dev_err_ratelimited(dsim->dev, "under-run detected\n");
+	}
+
+	dsim_write(dsim, DSIM_INTSRC, intsrc);
+	spin_unlock(&dsim->slock);
+
+	return IRQ_HANDLED;
+}
+
+static int dsim_wait_ph_fifo_empty(struct exynos8895_dsim *dsim)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(dsim->regs + DSIM_FIFOCTRL, val,
+				 val & DSIM_FIFOCTRL_EMPTY_PH_SFR,
+				 100, DSIM_WR_TIMEOUT_MS * 1000);
+	if (ret)
+		dev_err(dsim->dev, "tx header fifo timeout (FIFOCTRL 0x%x)\n",
+			dsim_read(dsim, DSIM_FIFOCTRL));
+
+	return ret;
+}
+
+static int dsim_wait_pl_fifo_empty(struct exynos8895_dsim *dsim)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(dsim->regs + DSIM_FIFOCTRL, val,
+				 val & DSIM_FIFOCTRL_EMPTY_PL_SFR,
+				 100, DSIM_WR_TIMEOUT_MS * 1000);
+	if (ret)
+		dev_err(dsim->dev, "tx payload fifo timeout (FIFOCTRL 0x%x)\n",
+			dsim_read(dsim, DSIM_FIFOCTRL));
+
+	return ret;
+}
+
+static int dsim_tx_short(struct exynos8895_dsim *dsim, u8 id,
+			 u8 data0, u8 data1, bool bta)
+{
+	u32 hdr;
+
+	reinit_completion(&dsim->ph_wr_comp);
+	dsim_write(dsim, DSIM_INTSRC, DSIM_INTSRC_SFR_PH_FIFO_EMPTY);
+
+	hdr = DSIM_PKTHDR_ID(id) | DSIM_PKTHDR_DATA0(data0) |
+		DSIM_PKTHDR_DATA1(data1);
+	if (bta)
+		hdr |= DSIM_PKTHDR_BTA_TYPE(1);
+	dsim_write_mask(dsim, DSIM_PKTHDR, hdr, DSIM_PKTHDR_DATA_MASK);
+
+	return dsim_wait_ph_fifo_empty(dsim);
+}
+
+static int dsim_tx_long(struct exynos8895_dsim *dsim, u8 id,
+			const u8 *data, size_t len)
+{
+	size_t i;
+	u32 payload;
+	int ret;
+
+	for (i = 0; i < len; i += 4) {
+		payload = 0;
+		memcpy(&payload, data + i, min_t(size_t, len - i, 4));
+		dsim_write(dsim, DSIM_PAYLOAD, payload);
+	}
+
+	reinit_completion(&dsim->ph_wr_comp);
+	dsim_write(dsim, DSIM_INTSRC, DSIM_INTSRC_SFR_PH_FIFO_EMPTY);
+
+	dsim_write_mask(dsim, DSIM_PKTHDR,
+			DSIM_PKTHDR_ID(id) | DSIM_PKTHDR_DATA0(len & 0xff) |
+			DSIM_PKTHDR_DATA1((len >> 8) & 0xff),
+			DSIM_PKTHDR_DATA_MASK);
+
+	ret = dsim_wait_ph_fifo_empty(dsim);
+	if (ret)
+		return ret;
+
+	return dsim_wait_pl_fifo_empty(dsim);
+}
+
+static ssize_t dsim_rx(struct exynos8895_dsim *dsim, const struct mipi_dsi_msg *msg)
+{
+	const u8 *tx = msg->tx_buf;
+	u8 size_buf[2];
+	u32 rx_fifo;
+	size_t copied = 0;
+	u32 rx_fifo_depth = DSIM_RX_FIFO_DEPTH;
+	u32 rx_drain = DSIM_RX_FIFO_DEPTH;
+	int ret;
+
+	/* Discard stale responses so the first FIFO word is this read's packet. */
+	while (!(dsim_read(dsim, DSIM_FIFOCTRL) & DSIM_FIFOCTRL_EMPTY_RX) &&
+	       rx_drain--)
+		dsim_read(dsim, DSIM_RXFIFO);
+
+	reinit_completion(&dsim->rd_comp);
+	dsim_write(dsim, DSIM_INTSRC, DSIM_INTSRC_RX_DATA_DONE);
+
+	/* set maximum return packet size */
+	size_buf[0] = msg->rx_len & 0xff;
+	size_buf[1] = (msg->rx_len >> 8) & 0xff;
+	ret = dsim_tx_short(dsim, MIPI_DSI_SET_MAXIMUM_RETURN_PACKET_SIZE,
+			    size_buf[0], size_buf[1], false);
+	if (ret) {
+		dev_err(dsim->dev, "failed to set max return size: %d\n", ret);
+		return ret;
+	}
+
+	/* read request with bus turnaround */
+	ret = dsim_tx_short(dsim, msg->type, msg->tx_len ? tx[0] : 0,
+			    msg->tx_len > 1 ? tx[1] : 0, true);
+	if (ret) {
+		dev_err(dsim->dev, "failed to send read request: %d\n", ret);
+		return ret;
+	}
+
+	if (!wait_for_completion_timeout(&dsim->rd_comp,
+					 msecs_to_jiffies(DSIM_RD_TIMEOUT_MS))) {
+		dev_err(dsim->dev, "rx timeout (cmd 0x%02x)\n", tx[0]);
+		return -ETIMEDOUT;
+	}
+
+	do {
+		rx_fifo = dsim_read(dsim, DSIM_RXFIFO);
+
+		switch (rx_fifo & 0xff) {
+		case MIPI_DSI_RX_ACKNOWLEDGE_AND_ERROR_REPORT:
+			dev_err(dsim->dev, "peripheral error report 0x%06x\n",
+				(rx_fifo >> 8) & 0xffff);
+			return -EPROTO;
+		case MIPI_DSI_RX_END_OF_TRANSMISSION:
+			break;
+		case MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_1BYTE:
+		case MIPI_DSI_RX_GENERIC_SHORT_READ_RESPONSE_1BYTE:
+			if (copied < msg->rx_len)
+				((u8 *)msg->rx_buf)[copied++] =
+					(rx_fifo >> 8) & 0xff;
+			break;
+		case MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_2BYTE:
+		case MIPI_DSI_RX_GENERIC_SHORT_READ_RESPONSE_2BYTE:
+			if (copied < msg->rx_len) {
+				size_t n = min_t(size_t, msg->rx_len - copied, 2);
+
+				memcpy((u8 *)msg->rx_buf + copied,
+				       (char *)&rx_fifo + 1, n);
+				copied += n;
+			}
+			break;
+		case MIPI_DSI_RX_DCS_LONG_READ_RESPONSE:
+		case MIPI_DSI_RX_GENERIC_LONG_READ_RESPONSE: {
+			u32 rx_size = (rx_fifo >> 8) & 0xffff;
+			u32 i, j;
+
+			for (i = 0; i < rx_size / 4; i++) {
+				rx_fifo = dsim_read(dsim, DSIM_RXFIFO);
+				for (j = 0; j < 4; j++)
+					if (copied + j < msg->rx_len)
+						((u8 *)msg->rx_buf)[copied + j] =
+							(rx_fifo >> (j * 8)) & 0xff;
+				copied += min_t(size_t, 4, msg->rx_len - copied);
+			}
+			if (rx_size % 4) {
+				rx_fifo = dsim_read(dsim, DSIM_RXFIFO);
+				for (j = 0; j < rx_size % 4; j++)
+					if (copied + j < msg->rx_len)
+						((u8 *)msg->rx_buf)[copied + j] =
+							(rx_fifo >> (j * 8)) & 0xff;
+				copied += min_t(size_t, rx_size % 4,
+						msg->rx_len - copied);
+			}
+			break;
+		}
+		default:
+			dev_err(dsim->dev, "invalid rx packet 0x%08x\n", rx_fifo);
+			return -EBADMSG;
+		}
+	} while (!(dsim_read(dsim, DSIM_FIFOCTRL) & DSIM_FIFOCTRL_EMPTY_RX) &&
+		 --rx_fifo_depth);
+
+	if (!rx_fifo_depth)
+		return -EOVERFLOW;
+
+	return copied;
+}
+
+static ssize_t exynos8895_dsim_transfer(struct mipi_dsi_host *host,
+					const struct mipi_dsi_msg *msg)
+{
+	struct exynos8895_dsim *dsim = host_to_dsim(host);
+	const u8 *tx = msg->tx_buf;
+	int ret = 0;
+
+	if (!dsim->powered)
+		return -EPERM;
+
+	if (msg->tx_len > 2) {
+		switch (msg->type) {
+		case MIPI_DSI_GENERIC_LONG_WRITE:
+		case MIPI_DSI_DCS_LONG_WRITE:
+		case MIPI_DSI_PICTURE_PARAMETER_SET:
+			break;
+		default:
+			return -EINVAL;
+		}
+	}
+
+	mutex_lock(&dsim->cmd_lock);
+
+	switch (msg->type) {
+	case MIPI_DSI_DCS_READ:
+	case MIPI_DSI_GENERIC_READ_REQUEST_0_PARAM:
+	case MIPI_DSI_GENERIC_READ_REQUEST_1_PARAM:
+	case MIPI_DSI_GENERIC_READ_REQUEST_2_PARAM:
+		if (!msg->rx_buf || !msg->rx_len || !msg->tx_buf) {
+			ret = -EINVAL;
+			break;
+		}
+		ret = dsim_rx(dsim, msg);
+		break;
+
+	case MIPI_DSI_GENERIC_SHORT_WRITE_0_PARAM:
+		ret = dsim_tx_short(dsim, msg->type, 0, 0, false);
+		break;
+	case MIPI_DSI_GENERIC_SHORT_WRITE_1_PARAM:
+	case MIPI_DSI_DCS_SHORT_WRITE:
+		if (msg->tx_len < 1) {
+			ret = -EINVAL;
+			break;
+		}
+		ret = dsim_tx_short(dsim, msg->type, tx[0], 0, false);
+		break;
+	case MIPI_DSI_GENERIC_SHORT_WRITE_2_PARAM:
+	case MIPI_DSI_DCS_SHORT_WRITE_PARAM:
+	case MIPI_DSI_COMPRESSION_MODE:
+	case MIPI_DSI_COLOR_MODE_OFF:
+	case MIPI_DSI_COLOR_MODE_ON:
+	case MIPI_DSI_SHUTDOWN_PERIPHERAL:
+	case MIPI_DSI_TURN_ON_PERIPHERAL:
+		if (msg->tx_len < 1) {
+			ret = -EINVAL;
+			break;
+		}
+		ret = dsim_tx_short(dsim, msg->type, tx[0],
+				    msg->tx_len > 1 ? tx[1] : 0, false);
+		break;
+	case MIPI_DSI_SET_MAXIMUM_RETURN_PACKET_SIZE:
+		if (msg->tx_len != 2) {
+			ret = -EINVAL;
+			break;
+		}
+		ret = dsim_tx_short(dsim, msg->type, tx[0], tx[1], false);
+		break;
+
+	case MIPI_DSI_GENERIC_LONG_WRITE:
+	case MIPI_DSI_DCS_LONG_WRITE:
+	case MIPI_DSI_PICTURE_PARAMETER_SET:
+		ret = dsim_tx_long(dsim, msg->type, tx, msg->tx_len);
+		if (!ret)
+			ret = msg->tx_len;
+		break;
+
+	default:
+		dev_err(dsim->dev, "unsupported message type 0x%02x\n",
+			msg->type);
+		ret = -EINVAL;
+		break;
+	}
+
+	mutex_unlock(&dsim->cmd_lock);
+
+	return ret;
+}
+
+static int exynos8895_dsim_attach(struct mipi_dsi_host *host,
+				  struct mipi_dsi_device *dsi)
+{
+	struct exynos8895_dsim *dsim = host_to_dsim(host);
+	int ret;
+
+	if (dsim->attached)
+		return -EBUSY;
+
+	dev_info(dsim->dev, "step: dsi attach requested (channel %u)\n", dsi->channel);
+	ret = dsim_power_on(dsim);
+	if (ret)
+		return ret;
+
+	dsim->attached = true;
+	dev_info(dsim->dev, "dsi device attached (channel %u)\n", dsi->channel);
+
+	return 0;
+}
+
+static int exynos8895_dsim_detach(struct mipi_dsi_host *host,
+				  struct mipi_dsi_device *dsi)
+{
+	struct exynos8895_dsim *dsim = host_to_dsim(host);
+
+	dsim->attached = false;
+	return 0;
+}
+
+/**
+ * exynos8895_dsim_enable_dsc - switch a powered DSIM to DSC scanout config
+ * @dev: the DSIM platform device
+ *
+ * Converts the Stage 2 non-DSC command probe configuration to the
+ * compressed-stream scanout configuration used by DECON_f: compression
+ * enable, 2 slices of 720px in multi-slice packets, and threshold /
+ * horizontal resolution set to the DSC line byte count (480).  Command
+ * mode, EOTP, PLL/lanes and interrupt setup are left untouched.
+ *
+ * Must be called after the panel has received its PPS (panel init) and
+ * before the first DECON trigger.
+ *
+ * Returns 0 on success, -ENODEV if the DSIM is not powered/attached.
+ */
+int exynos8895_dsim_enable_dsc(struct device *dev)
+{
+	struct platform_device *pdev;
+	struct exynos8895_dsim *dsim;
+
+	if (!dev)
+		return -ENODEV;
+
+	pdev = to_platform_device(dev);
+	dsim = platform_get_drvdata(pdev);
+	if (!dsim || !dsim->powered || !dsim->attached)
+		return -ENODEV;
+
+	mutex_lock(&dsim->cmd_lock);
+
+	dsim_write_mask(dsim, DSIM_CONFIG, DSIM_CONFIG_CPRS_EN,
+			DSIM_CONFIG_CPRS_EN);
+	dsim_write(dsim, DSIM_CPRS_CTRL,
+		   DSIM_CPRS_CTRL_NUM_OF_SLICE(DSIM_DSC_NUM_OF_SLICE) |
+		   DSIM_CPRS_CTRL_MULI_SLICE_PACKET);
+	dsim_write(dsim, DSIM_SLICE01,
+		   DSIM_SLICE01_SIZE_OF_SLICE1(DSIM_DSC_SIZE_OF_SLICE) |
+		   DSIM_SLICE01_SIZE_OF_SLICE0(DSIM_DSC_SIZE_OF_SLICE));
+	/* downstream programs SLICE23 with the same width for 2-slice/2-enc */
+	dsim_write(dsim, DSIM_SLICE23,
+		   DSIM_SLICE01_SIZE_OF_SLICE1(DSIM_DSC_SIZE_OF_SLICE) |
+		   DSIM_SLICE01_SIZE_OF_SLICE0(DSIM_DSC_SIZE_OF_SLICE));
+	dsim_write(dsim, DSIM_THRESHOLD, DSIM_DSC_BYTES_PER_LINE);
+	dsim_write(dsim, DSIM_RESOL,
+		   DSIM_RESOL_VRESOL(DSIM_VRESOL) |
+		   DSIM_RESOL_HRESOL(DSIM_DSC_BYTES_PER_LINE));
+
+	mutex_unlock(&dsim->cmd_lock);
+
+	dev_info(dsim->dev, "DSC scanout config: %d slices x %d px, %d bytes/line\n",
+		 DSIM_DSC_NUM_OF_SLICE, DSIM_DSC_SIZE_OF_SLICE,
+		 DSIM_DSC_BYTES_PER_LINE);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(exynos8895_dsim_enable_dsc);
+
+static const struct mipi_dsi_host_ops exynos8895_dsim_host_ops = {
+	.attach = exynos8895_dsim_attach,
+	.detach = exynos8895_dsim_detach,
+	.transfer = exynos8895_dsim_transfer,
+};
+
+static int exynos8895_dsim_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos8895_dsim *dsim;
+	int ret;
+
+	dsim = devm_kzalloc(dev, sizeof(*dsim), GFP_KERNEL);
+	if (!dsim)
+		return -ENOMEM;
+
+	dsim->dev = dev;
+
+	dsim->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dsim->regs))
+		return dev_err_probe(dev, PTR_ERR(dsim->regs),
+				     "failed to map dsim registers\n");
+
+	dsim->cmu = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(dsim->cmu))
+		return dev_err_probe(dev, PTR_ERR(dsim->cmu),
+				     "failed to map DPU0 CMU registers\n");
+
+	dsim->cmu1 = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(dsim->cmu1))
+		return dev_err_probe(dev, PTR_ERR(dsim->cmu1),
+				     "failed to map DPU1 CMU registers\n");
+
+	dsim->pmu = syscon_regmap_lookup_by_phandle(dev->of_node,
+						    "samsung,pmu-syscon");
+	if (IS_ERR(dsim->pmu))
+		return dev_err_probe(dev, PTR_ERR(dsim->pmu),
+				     "failed to get pmu syscon\n");
+
+	dsim->disp_ss = syscon_regmap_lookup_by_phandle(dev->of_node,
+							"samsung,disp-syscon");
+	if (IS_ERR(dsim->disp_ss))
+		return dev_err_probe(dev, PTR_ERR(dsim->disp_ss),
+				     "failed to get disp-ss syscon\n");
+
+	dsim->dpu_bus = devm_clk_get(dev, "dpu_bus");
+	if (IS_ERR(dsim->dpu_bus))
+		return dev_err_probe(dev, PTR_ERR(dsim->dpu_bus),
+				     "failed to get dpu_bus clock\n");
+
+	dsim->irq = platform_get_irq(pdev, 0);
+	if (dsim->irq < 0)
+		return dsim->irq;
+
+	/*
+	 * The bootloader leaves the DSIM running; a stale pending interrupt
+	 * between request_irq() and power-on would be returned as IRQ_NONE
+	 * and storm "nobody cared", getting the line disabled and silently
+	 * breaking RX-driven panel reads.  Mask everything and clear all
+	 * pending sources up front.
+	 */
+	dsim_write(dsim, DSIM_INTMSK, 0);
+	dsim_write(dsim, DSIM_INTSRC, 0xffffffff);
+
+	ret = devm_request_irq(dev, dsim->irq, dsim_irq_handler, 0,
+			       dev_name(dev), dsim);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+	disable_irq(dsim->irq);
+
+	mutex_init(&dsim->cmd_lock);
+	spin_lock_init(&dsim->slock);
+	init_completion(&dsim->ph_wr_comp);
+	init_completion(&dsim->rd_comp);
+
+	platform_set_drvdata(pdev, dsim);
+
+	dsim->host.dev = dev;
+	dsim->host.ops = &exynos8895_dsim_host_ops;
+
+	ret = mipi_dsi_host_register(&dsim->host);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to register dsi host\n");
+
+	dev_info(dev, "exynos8895 dsim host registered\n");
+	return 0;
+}
+
+static void exynos8895_dsim_remove(struct platform_device *pdev)
+{
+	struct exynos8895_dsim *dsim = platform_get_drvdata(pdev);
+
+	mipi_dsi_host_unregister(&dsim->host);
+	clk_disable_unprepare(dsim->dpu_bus);
+}
+
+static const struct of_device_id exynos8895_dsim_of_match[] = {
+	{ .compatible = "samsung,exynos8895-dsim" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, exynos8895_dsim_of_match);
+
+static struct platform_driver exynos8895_dsim_driver = {
+	.probe = exynos8895_dsim_probe,
+	.remove = exynos8895_dsim_remove,
+	.driver = {
+		.name = "exynos8895-dsim",
+		.of_match_table = exynos8895_dsim_of_match,
+	},
+};
+module_platform_driver(exynos8895_dsim_driver);
+
+MODULE_AUTHOR("The postmarketOS project");
+MODULE_DESCRIPTION("Exynos 8895 DSIM MIPI-DSI host driver");
+MODULE_LICENSE("GPL");
