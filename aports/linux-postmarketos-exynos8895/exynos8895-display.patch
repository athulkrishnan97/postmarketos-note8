diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c
new file mode 100644
index 000000000..d4c96a7ab
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c
@@ -0,0 +1,376 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E3HA6 MIPI-DSI command mode panel (Galaxy Note 8 / greatlte)
+ *
+ * Minimal bring-up driver: power/reset, DDI ID read (DCS 0x04) and a
+ * fixed init sequence (DSC PPS, sleep out, CASET/PASET, TE, panel
+ * condition) sufficient for reliable probing and later scan-out bring-up.
+ * Sequences follow the downstream s6e3ha6 greatlte panel files.
+ *
+ * Copyright (c) 2026 The postmarketOS project
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct s6e3ha6 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+	bool initialized;
+};
+
+static inline struct s6e3ha6 *to_s6e3ha6(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e3ha6, panel);
+}
+
+static const struct regulator_bulk_data s6e3ha6_supplies[] = {
+	{ .supply = "vdd_ddi_3p0" },
+	{ .supply = "vdd_ddi_1p8" },
+	{ .supply = "vdd_ddi_1p6" },
+};
+
+#define s6e3ha6_key1_on(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9f, 0xa5, 0xa5)
+#define s6e3ha6_key1_off(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9f, 0x5a, 0x5a)
+#define s6e3ha6_key2_on(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0x5a, 0x5a)
+#define s6e3ha6_key2_off(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0xa5, 0xa5)
+#define s6e3ha6_key3_on(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfc, 0x5a, 0x5a)
+#define s6e3ha6_key3_off(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xfc, 0xa5, 0xa5)
+
+/*
+ * DSC PPS for 1440x2960, 2 slices of 720x40, 8bpp (DSU mode 1,
+ * downstream GREAT_A2_S3 PPS).
+ */
+static const u8 s6e3ha6_pps[] = {
+	0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x0b, 0x90,
+	0x05, 0xa0, 0x00, 0x28, 0x02, 0xd0, 0x02, 0xd0,
+	0x02, 0x00, 0x02, 0x68, 0x00, 0x20, 0x04, 0x6c,
+	0x00, 0x0a, 0x00, 0x0c, 0x02, 0x77, 0x01, 0xe9,
+	0x18, 0x00, 0x10, 0xf0, 0x03, 0x0c, 0x20, 0x00,
+	0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+	0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b,
+	0x7d, 0x7e, 0x01, 0x02, 0x01, 0x00, 0x09, 0x40,
+	0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+	0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6,
+	0x2b, 0x34, 0x2b, 0x74, 0x3b, 0x74, 0x6b, 0xf4,
+	/* remaining 40 bytes are zero padding (PPS total: 128 bytes) */
+};
+
+static int s6e3ha6_power_on(struct s6e3ha6 *priv)
+{
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s6e3ha6_supplies),
+				    priv->supplies);
+	if (ret < 0)
+		return ret;
+
+	msleep(10);
+
+	/* release the active-low reset after the rails are stable */
+	gpiod_set_value_cansleep(priv->reset_gpio, 0);
+
+	msleep(5);
+
+	return 0;
+}
+
+static int s6e3ha6_read_id(struct s6e3ha6 *priv, u8 *id)
+{
+	struct mipi_dsi_device *dsi = priv->dsi;
+	static const u8 key3_on[] = { 0x5a, 0x5a };
+	static const u8 key3_off[] = { 0xa5, 0xa5 };
+	int ret;
+
+	mipi_dsi_dcs_write(dsi, 0xfc, key3_on, sizeof(key3_on));
+
+	ret = mipi_dsi_dcs_read(dsi, 0x04, id, 3);
+
+	mipi_dsi_dcs_write(dsi, 0xfc, key3_off, sizeof(key3_off));
+
+	return ret < 0 ? ret : 0;
+}
+
+/*
+ * Wake the DDI (sleep-out).  The rest of the downstream init sequence
+ * (DSC enable + PPS, DSU scaler, CASET/PASET, omok latches, TE) runs
+ * from prepare(): sending the long PPS write before the DDI is awake
+ * wedges the DSIM command path (-110).
+ */
+static int s6e3ha6_wake(struct s6e3ha6 *priv)
+{
+	struct mipi_dsi_device *dsi = priv->dsi;
+	int ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
+	if (ret < 0)
+		return ret;
+
+	msleep(120);
+	return 0;
+}
+
+static int s6e3ha6_init(struct s6e3ha6 *priv)
+{
+	struct mipi_dsi_device *dsi = priv->dsi;
+	struct mipi_dsi_multi_context ctx = { .dsi = dsi };
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	/*
+	 * key1: DSC enable is a MIPI Compression Mode packet (DSI data
+	 * type 0x07, downstream DSI_PKT_TYPE_COMP / MIPI_DSI_DSC_PRA),
+	 * followed by the PPS long packet (type 0x0A).
+	 */
+	s6e3ha6_key1_on(&ctx);
+	mipi_dsi_compression_mode_multi(&ctx, true);
+	memset(&pps, 0, sizeof(pps));
+	memcpy(&pps, s6e3ha6_pps, sizeof(s6e3ha6_pps));
+	ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+	s6e3ha6_key1_off(&ctx);
+	if (ret < 0)
+		return ret;
+	if (ctx.accum_err)
+		return ctx.accum_err;
+
+	/* key2: DSU scaler */
+	s6e3ha6_key2_on(&ctx);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xba, 0x01, 0x02, 0x06, 0x08,
+				     0x08, 0x1e, 0x03);
+	s6e3ha6_key2_off(&ctx);
+	if (ctx.accum_err)
+		return ctx.accum_err;
+
+	/* GRAM window: full 1440x2960 */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x2a, 0x00, 0x00, 0x05, 0x9f);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x2b, 0x00, 0x00, 0x0b, 0x8f);
+	if (ctx.accum_err)
+		return ctx.accum_err;
+
+	/* key3: omok latches */
+	s6e3ha6_key3_on(&ctx);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xb0, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xff, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xb0, 0x07);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xf2, 0x3c, 0xd0);
+	s6e3ha6_key3_off(&ctx);
+	if (ctx.accum_err)
+		return ctx.accum_err;
+
+	/* set area + TE on */
+	s6e3ha6_key1_on(&ctx);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x1a, 0x1f, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0x35, 0x00);
+	s6e3ha6_key1_off(&ctx);
+	if (ctx.accum_err)
+		return ctx.accum_err;
+
+	return 0;
+}
+
+static int s6e3ha6_prepare(struct drm_panel *panel)
+{
+	struct s6e3ha6 *priv = to_s6e3ha6(panel);
+	struct mipi_dsi_multi_context ctx = { .dsi = priv->dsi };
+	int ret;
+
+	/*
+	 * Rest of the downstream init, once: DSC enable + PPS, DSU scaler,
+	 * CASET/PASET, omok latches, TE.  Runs with the DDI already awake
+	 * (sleep-out from probe), before display-on and before the CRTC
+	 * starts triggering - matching the downstream "DDI ready, then
+	 * scanout" order.
+	 */
+	if (!priv->initialized) {
+		ret = s6e3ha6_init(priv);
+		if (ret < 0)
+			return ret;
+		priv->initialized = true;
+	}
+
+	priv->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_set_display_on_multi(&ctx);
+
+	return ctx.accum_err;
+}
+
+static int s6e3ha6_enable(struct drm_panel *panel)
+{
+	struct s6e3ha6 *priv = to_s6e3ha6(panel);
+	struct mipi_dsi_multi_context ctx = { .dsi = priv->dsi };
+
+	priv->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	s6e3ha6_key1_on(&ctx);
+	mipi_dsi_dcs_set_display_on_multi(&ctx);
+	s6e3ha6_key1_off(&ctx);
+
+	return ctx.accum_err;
+}
+
+static const struct drm_display_mode s6e3ha6_mode = {
+	.clock = (1440 + 116 + 44 + 120) * (2960 + 120 + 80 + 124) * 60 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1440 + 116,
+	.hsync_end = 1440 + 116 + 44,
+	.htotal = 1440 + 116 + 44 + 120,
+	.vdisplay = 2960,
+	.vsync_start = 2960 + 120,
+	.vsync_end = 2960 + 120 + 80,
+	.vtotal = 2960 + 120 + 80 + 124,
+	.width_mm = 71,
+	.height_mm = 145,
+};
+
+static int s6e3ha6_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &s6e3ha6_mode);
+}
+
+static const struct drm_panel_funcs s6e3ha6_panel_funcs = {
+	.prepare = s6e3ha6_prepare,
+	.enable = s6e3ha6_enable,
+	.get_modes = s6e3ha6_get_modes,
+};
+
+static int s6e3ha6_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e3ha6 *priv;
+	u8 id[3] = { 0 };
+	int ret;
+	int attempt;
+
+	priv = devm_drm_panel_alloc(dev, struct s6e3ha6, panel,
+				    &s6e3ha6_panel_funcs,
+				    DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(priv))
+		return PTR_ERR(priv);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(s6e3ha6_supplies),
+					    s6e3ha6_supplies,
+					    &priv->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	priv->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(priv->reset_gpio),
+				     "failed to get reset-gpios\n");
+
+	priv->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, priv);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_LPM;
+
+	drm_panel_add(&priv->panel);
+
+	ret = s6e3ha6_power_on(priv);
+	if (ret < 0) {
+		dev_err(dev, "failed to power on panel: %d\n", ret);
+		goto err_remove;
+	}
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "failed to attach to DSI host: %d\n", ret);
+		goto err_remove;
+	}
+
+	ret = s6e3ha6_wake(priv);
+	if (ret < 0) {
+		dev_err(dev, "panel wake failed: %d\n", ret);
+		goto err_detach;
+	}
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		ret = s6e3ha6_read_id(priv, id);
+		if (!ret)
+			break;
+		dev_warn(dev, "panel ID read attempt %d failed: %d\n",
+			 attempt + 1, ret);
+		msleep(100);
+	}
+	if (ret < 0) {
+		dev_err(dev, "failed to read panel ID: %d\n", ret);
+		goto err_detach;
+	}
+
+	switch (id[0] & 0xf0) {
+	case 0x80:
+		dev_info(dev, "panel ID %02x%02x%02x (a2 variant)\n",
+			 id[0], id[1], id[2]);
+		break;
+	case 0xc0:
+		dev_info(dev, "panel ID %02x%02x%02x (a3 variant)\n",
+			 id[0], id[1], id[2]);
+		break;
+	default:
+		dev_info(dev, "panel ID %02x%02x%02x (unknown variant)\n",
+			 id[0], id[1], id[2]);
+		break;
+	}
+
+	return 0;
+
+err_detach:
+	mipi_dsi_detach(dsi);
+err_remove:
+	drm_panel_remove(&priv->panel);
+	regulator_bulk_disable(ARRAY_SIZE(s6e3ha6_supplies), priv->supplies);
+	return ret;
+}
+
+static void s6e3ha6_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3ha6 *priv = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&priv->panel);
+	regulator_bulk_disable(ARRAY_SIZE(s6e3ha6_supplies), priv->supplies);
+}
+
+static const struct of_device_id s6e3ha6_of_match[] = {
+	{ .compatible = "samsung,s6e3ha6" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e3ha6_of_match);
+
+static struct mipi_dsi_driver s6e3ha6_driver = {
+	.probe = s6e3ha6_probe,
+	.remove = s6e3ha6_remove,
+	.driver = {
+		.name = "panel-s6e3ha6",
+		.of_match_table = s6e3ha6_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e3ha6_driver);
+
+MODULE_AUTHOR("The postmarketOS project");
+MODULE_DESCRIPTION("DRM driver for Samsung S6E3HA6 panel (Galaxy Note 8)");
+MODULE_LICENSE("GPL");
