+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 8895 DECON_f DRM/KMS driver
+ *
+ * Standalone display controller driver for the Galaxy Note 8 (greatlte)
+ * MIPI-DSI command-mode panel path.  Implements one primary plane fed by
+ * IDMA_G0, one CRTC, an encoder and a panel bridge connector, with custom
+ * contiguous GEM (dma_alloc_attrs) for dumb buffers.
+ *
+ * The hardware programming follows the downstream Exynos 8895 DPU
+ * (drivers/video/fbdev/exynos/dpu @ 3cfb914): DECON_f global control,
+ * DSCC + dual DSC encoders from the panel PPS table, frame FIFO /
+ * formatter / blender sizing and the command-mode shadow-update + trigger
+ * frame programming.
+ *
+ * The DSIM host (exynos8895-dsim.c) owns the DPU power domains, PHY
+ * isolation and LPMUX; this driver must not power anything off.
+ *
+ * Copyright (c) 2026 The postmarketOS project
+ */
+
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/fb.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/timer.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_bridge_connector.h>
+#include <drm/drm_client.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_encoder.h>
+#include <drm/drm_fb_helper.h>
+#include <drm/drm_file.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_ioctl.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_plane.h>
+#include <drm/drm_prime.h>
+#include <drm/drm_print.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_vblank.h>
+
+#include "exynos8895-dsim.h"
+#include "regs-exynos8895-decon.h"
+
+#define DECON_UPDATE_TIMEOUT_US		20000
+#define DECON_IDLE_TIMEOUT_US		20000
+#define DECON_FLUSH_TIMEOUT_MS		100
+#define DECON_MAX_WIDTH			1440
+#define DECON_MAX_HEIGHT		2960
+
+/*
+ * DSC PPS for 1440x2960, 2 slices of 720x40, 8bpp (DSU mode 1,
+ * downstream GREAT_A2_S3 PPS).  Must match what the panel driver
+ * sends to the DDI decoder; keep in sync with panel-samsung-s6e3ha6.c.
+ */
+static const u8 s6e3ha6_dsc_pps[] = {
+	0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x0b, 0x90,
+	0x05, 0xa0, 0x00, 0x28, 0x02, 0xd0, 0x02, 0xd0,
+	0x02, 0x00, 0x02, 0x68, 0x00, 0x20, 0x04, 0x6c,
+	0x00, 0x0a, 0x00, 0x0c, 0x02, 0x77, 0x01, 0xe9,
+	0x18, 0x00, 0x10, 0xf0, 0x03, 0x0c, 0x20, 0x00,
+	0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+	0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b,
+	0x7d, 0x7e, 0x01, 0x02, 0x01, 0x00, 0x09, 0x40,
+	0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+	0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6,
+	0x2b, 0x34, 0x2b, 0x74, 0x3b, 0x74, 0x6b, 0xf4,
+};
+
+#define DSC_PPS_BYTE(_n) \
+	((s6e3ha6_dsc_pps[_n] << 8) | s6e3ha6_dsc_pps[(_n) + 1])
+
+/* ------------------------------------------------------------------ */
+/* contiguous GEM                                                      */
+/* ------------------------------------------------------------------ */
+
+struct exynos8895_decon_gem {
+	struct drm_gem_object base;
+	void *kvaddr;
+	dma_addr_t dma_addr;
+	unsigned long size;
+};
+
+static inline struct exynos8895_decon_gem *
+to_decon_gem(struct drm_gem_object *obj)
+{
+	return container_of(obj, struct exynos8895_decon_gem, base);
+}
+
+static void decon_gem_free(struct drm_gem_object *obj)
+{
+	struct exynos8895_decon_gem *gem = to_decon_gem(obj);
+
+	dma_free_attrs(obj->dev->dev, gem->size, gem->kvaddr, gem->dma_addr,
+		       DMA_ATTR_WRITE_COMBINE);
+	drm_gem_object_release(obj);
+	kfree(gem);
+}
+
+static int decon_gem_vmap(struct drm_gem_object *obj, struct iosys_map *map)
+{
+	struct exynos8895_decon_gem *gem = to_decon_gem(obj);
+
+	iosys_map_set_vaddr(map, gem->kvaddr);
+	return 0;
+}
+
+static int decon_gem_mmap(struct drm_gem_object *obj, struct vm_area_struct *vma)
+{
+	struct exynos8895_decon_gem *gem = to_decon_gem(obj);
+
+	vma->vm_pgoff = 0;
+	return dma_mmap_attrs(obj->dev->dev, vma, gem->kvaddr, gem->dma_addr,
+			      gem->size, DMA_ATTR_WRITE_COMBINE);
+}
+
+/*
+ * Single-entry scatterlist so the core can export these objects as dma-bufs
+ * (gbm turns scanout buffers into PRIME fds which the GPU device imports).
+ */
+static struct sg_table *decon_gem_get_sg_table(struct drm_gem_object *obj)
+{
+	struct exynos8895_decon_gem *gem = to_decon_gem(obj);
+	struct sg_table *sgt;
+
+	sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+	if (!sgt)
+		return ERR_PTR(-ENOMEM);
+
+	/*
+	 * kvaddr is a write-combine remap, not a linear-map address, so
+	 * virt_to_page() on it yields a bogus page; let the DMA API build
+	 * the table from the real backing pages.
+	 */
+	if (dma_get_sgtable(obj->dev->dev, sgt, gem->kvaddr, gem->dma_addr,
+			    gem->size)) {
+		kfree(sgt);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	return sgt;
+}
+
+static const struct drm_gem_object_funcs decon_gem_funcs = {
+	.free = decon_gem_free,
+	.vmap = decon_gem_vmap,
+	.mmap = decon_gem_mmap,
+	.get_sg_table = decon_gem_get_sg_table,
+};
+
+static struct exynos8895_decon_gem *decon_gem_create(struct drm_device *drm,
+						     unsigned long size)
+{
+	struct exynos8895_decon_gem *gem;
+	int ret;
+
+	gem = kzalloc(sizeof(*gem), GFP_KERNEL);
+	if (!gem)
+		return ERR_PTR(-ENOMEM);
+
+	size = PAGE_ALIGN(size);
+
+	drm_gem_private_object_init(drm, &gem->base, size);
+
+	gem->kvaddr = dma_alloc_attrs(drm->dev, size, &gem->dma_addr,
+				      GFP_KERNEL, DMA_ATTR_WRITE_COMBINE);
+	if (!gem->kvaddr) {
+		ret = -ENOMEM;
+		goto err_release;
+	}
+
+	gem->size = size;
+	gem->base.funcs = &decon_gem_funcs;
+
+	return gem;
+
+err_release:
+	drm_gem_object_release(&gem->base);
+	kfree(gem);
+	return ERR_PTR(ret);
+}
+
+static int decon_dumb_create(struct drm_file *file_priv,
+			     struct drm_device *drm,
+			     struct drm_mode_create_dumb *args)
+{
+	struct exynos8895_decon_gem *gem;
+	u32 pitch = args->width * DIV_ROUND_UP(args->bpp, 8);
+	int ret;
+
+	args->pitch = pitch;
+	gem = decon_gem_create(drm, pitch * args->height);
+	if (IS_ERR(gem))
+		return PTR_ERR(gem);
+
+	args->size = gem->size;
+
+	ret = drm_gem_handle_create(file_priv, &gem->base, &args->handle);
+	drm_gem_object_put(&gem->base);
+	return ret;
+}
+
+DEFINE_DRM_GEM_FOPS(decon_drm_fops);
+
+/* ------------------------------------------------------------------ */
+/* driver private                                                      */
+/* ------------------------------------------------------------------ */
+
+struct exynos8895_decon {
+	struct drm_device drm;
+	struct device *dev;
+
+	void __iomem *regs;
+	void __iomem *idma;
+	void __iomem *dma_com;
+	void __iomem *cmu;
+
+	struct regmap *disp_ss;
+	struct clk *dpu_bus;
+
+	struct drm_plane plane;
+	struct drm_crtc crtc;
+	struct drm_encoder encoder;
+	struct drm_panel *panel;
+
+	int irq;
+	struct completion frame_done;
+	bool enabled;
+	/* page-flip event waiting for its frame (protected by drm.event_lock) */
+	struct drm_pending_vblank_event *event;
+
+	struct timer_list heartbeat;
+	int heartbeat_count;
+};
+
+static inline struct exynos8895_decon *to_decon(struct drm_device *drm)
+{
+	return container_of(drm, struct exynos8895_decon, drm);
+}
+
+static inline void decon_write(struct exynos8895_decon *decon, u32 reg, u32 val)
+{
+	writel(val, decon->regs + reg);
+}
+
+static inline u32 decon_read(struct exynos8895_decon *decon, u32 reg)
+{
+	return readl(decon->regs + reg);
+}
+
+static inline void decon_write_mask(struct exynos8895_decon *decon, u32 reg,
+				    u32 val, u32 mask)
+{
+	u32 v = decon_read(decon, reg);
+
+	v &= ~mask;
+	v |= val & mask;
+	decon_write(decon, reg, v);
+}
+
+static inline void idma_write(struct exynos8895_decon *decon, u32 reg, u32 val)
+{
+	writel(val, decon->idma + reg);
+}
+
+static inline void idma_write_mask(struct exynos8895_decon *decon, u32 reg,
+				   u32 val, u32 mask)
+{
+	u32 v = readl(decon->idma + reg);
+
+	v &= ~mask;
+	v |= val & mask;
+	idma_write(decon, reg, v);
+}
+
+/* ------------------------------------------------------------------ */
+/* DPU0 CMU gates                                                      */
+/* ------------------------------------------------------------------ */
+
+static void decon_setup_clocks(struct exynos8895_decon *decon)
+{
+	/*
+	 * AXI2APB_P0/P1 (0x2054/0x2058) are already ungated by the DSIM
+	 * driver, which probes before this driver's first MMIO access can
+	 * happen (panel lookup defers on the DSIM host); they are listed
+	 * anyway so this driver is self-contained if probe order changes.
+	 */
+	static const struct {
+		u32 offset;
+		const char *name;
+	} gates[] = {
+		{ DPU0_CMU_AD_APB_DECON0_0_GATE, "AD APB DECON0 0" },
+		{ DPU0_CMU_AD_APB_DECON0_1_GATE, "AD APB DECON0 1" },
+		{ DPU0_CMU_AXI2APB_P0_GATE, "DPU0 AXI2APB P0" },
+		{ DPU0_CMU_AXI2APB_P1_GATE, "DPU0 AXI2APB P1" },
+		{ DPU0_CMU_DECON0_ACLK_GATE, "DECON0 ACLK" },
+		{ DPU0_CMU_DPP_G0_ACLK_GATE, "DPP_G0 ACLK" },
+		{ DPU0_CMU_DPU_DMA_ACLK_CH0_GATE, "DPU_DMA ACLK CH0" },
+		{ DPU0_CMU_DPU_DMA_CH_INTF_GATE, "DPU_DMA CH_INTF" },
+		{ DPU0_CMU_DPU_DMA_ACLK_SFR_GATE, "DPU_DMA ACLK SFR" },
+		{ DPU0_CMU_QCH_CON_DECON0, "QCH_CON_DECON0" },
+		{ DPU0_CMU_QCH_CON_DPP_G0, "QCH_CON_DPP_G0" },
+		{ DPU0_CMU_QCH_CON_DPU_DMA, "QCH_CON_DPU_DMA" },
+	};
+	u32 val;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(gates); i++) {
+		val = readl(decon->cmu + gates[i].offset);
+		writel(val | DPU0_CMU_GATE_ON, decon->cmu + gates[i].offset);
+		dev_dbg(decon->dev, "gate %s old 0x%x new 0x%x\n",
+			gates[i].name, val,
+			readl(decon->cmu + gates[i].offset));
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* DSC encoders                                                        */
+/* ------------------------------------------------------------------ */
+
+static void dsc_write(struct exynos8895_decon *decon, u32 dsc_offset,
+		      u32 reg, u32 val)
+{
+	writel(val, decon->regs + dsc_offset + reg);
+}
+
+static void dsc_write_mask(struct exynos8895_decon *decon, u32 dsc_offset,
+			   u32 reg, u32 val, u32 mask)
+{
+	u32 v = readl(decon->regs + dsc_offset + reg);
+
+	v &= ~mask;
+	v |= val & mask;
+	dsc_write(decon, dsc_offset, reg, v);
+}
+
+/*
+ * Program one DSC encoder.  Downstream (dsc_reg_set_encoder for
+ * dsc_cnt=2, dsc_slice_num=2) gives each encoder half the raster:
+ * pic_width = xres/2 = 720, dual-slice off, and hardcodes
+ * initial_dec_delay = 0x01B4 (the non-VESA_SCR_V4 build).  All other
+ * fields match the panel PPS table that the panel driver sends to the
+ * DDI decoder.  DSC_CONTROL1/2 (V/H porch) intentionally keep their
+ * reset values, matching downstream.
+ */
+static void decon_dsc_setup_encoder(struct exynos8895_decon *decon,
+				    u32 dsc_offset)
+{
+	dsc_write_mask(decon, dsc_offset, DSC_CONTROL0,
+		       DSC_DCG_EN_ALL_F | DSC_BYTE_SWAP_F |
+		       DSC_FLATNESS_DET_TH_F(0x2) | DSC_CG_EN_F,
+		       DSC_DCG_EN_ALL_F | DSC_BYTE_SWAP_F |
+		       DSC_FLATNESS_DET_TH_F(0xf) | DSC_CG_EN_F |
+		       DSC_DUAL_SLICE_EN_F);
+
+	dsc_write(decon, dsc_offset, DSC_PPS04_07,
+		  (s6e3ha6_dsc_pps[4] << 24) | (s6e3ha6_dsc_pps[5] << 16) |
+		  DSC_PPS_BYTE(6));
+	/* pic_width is per-encoder (720), not the full 1440 of the DDI PPS */
+	dsc_write(decon, dsc_offset, DSC_PPS08_11,
+		  ((720) << 16) | DSC_PPS_BYTE(10));
+	dsc_write(decon, dsc_offset, DSC_PPS12_15,
+		  (DSC_PPS_BYTE(12) << 16) | DSC_PPS_BYTE(14));
+	/* initial_dec_delay from the PPS table (0x268), as the bootloader does */
+	dsc_write(decon, dsc_offset, DSC_PPS16_19,
+		  (DSC_PPS_BYTE(16) << 16) | DSC_PPS_BYTE(18));
+	dsc_write(decon, dsc_offset, DSC_PPS20_23,
+		  (s6e3ha6_dsc_pps[21] << 16) | DSC_PPS_BYTE(22));
+	dsc_write(decon, dsc_offset, DSC_PPS24_27,
+		  (DSC_PPS_BYTE(24) << 16) | s6e3ha6_dsc_pps[27]);
+	dsc_write(decon, dsc_offset, DSC_PPS28_31,
+		  (DSC_PPS_BYTE(28) << 16) | DSC_PPS_BYTE(30));
+	dsc_write(decon, dsc_offset, DSC_PPS32_35,
+		  (DSC_PPS_BYTE(32) << 16) | DSC_PPS_BYTE(34));
+	/*
+	 * PPS56..59 share one SFR: bytes 56/57 are rc_buf_thresh[12/13]
+	 * (0x7d/0x7e).  Writing only the 58/59 halfword zeroes them and
+	 * breaks the encoder rate control (bootloader keeps 0x7d7e0102).
+	 */
+	dsc_write(decon, dsc_offset, DSC_PPS56_59,
+		  (DSC_PPS_BYTE(56) << 16) | DSC_PPS_BYTE(58));
+
+	/* fixed RC range parameter tail (non-VESA SCR v4 guidance) */
+	dsc_write(decon, dsc_offset, DSC_PPS76_79, 0x1ab62af6);
+	dsc_write(decon, dsc_offset, DSC_PPS80_83, 0x2b342b74);
+	dsc_write(decon, dsc_offset, DSC_PPS84_87, 0x3b746bf4);
+}
+
+/* ------------------------------------------------------------------ */
+/* DECON core                                                          */
+/* ------------------------------------------------------------------ */
+
+static void decon_shadow_update_req(struct exynos8895_decon *decon)
+{
+	decon_write_mask(decon, DECON_SHADOW_REG_UPDATE_REQ,
+			 DECON_SHADOW_UPDATE_GLOBAL, DECON_SHADOW_UPDATE_GLOBAL);
+}
+
+static int decon_wait_run_status(struct exynos8895_decon *decon, bool run)
+{
+	u32 val;
+	u32 mask = DECON_GLOBAL_CONTROL_RUN_STATUS;
+
+	return readl_poll_timeout(decon->regs + DECON_GLOBAL_CONTROL, val,
+				  !!(val & mask) == run, 100, DECON_UPDATE_TIMEOUT_US);
+}
+
+static void decon_trigger_set(struct exynos8895_decon *decon, bool enable)
+{
+	u32 val;
+
+	/*
+	 * Enabled: HW_TRIG_EN with DECON unmasked.  Disabled: DECON masked
+	 * so pending TE edges do not accumulate while idle.
+	 */
+	if (enable)
+		val = DECON_HW_TRIG_EN;
+	else
+		val = DECON_HW_TRIG_MASK_DECON;
+
+	decon_write_mask(decon, DECON_HW_SW_TRIG_CONTROL, val,
+			 DECON_HW_TRIG_EN | DECON_HW_TRIG_MASK_DECON);
+}
+
+static int decon_hw_init(struct exynos8895_decon *decon,
+			 const struct drm_display_mode *mode)
+{
+	u32 width = mode->hdisplay;
+	u32 height = mode->vdisplay;
+	/* compressed pixel units: each DSC encoder takes 720 source px at
+	 * 1/3 rate -> 240; downstream decon_reg_config_data_path_size uses
+	 * dsc_enc.width_per_enc for splitter/FF/formatter sizing.
+	 */
+	u32 width_per_enc = width / 2 / 3;
+
+	/*
+	 * No software reset: downstream deliberately avoids SW-resets in the
+	 * DPU blocks ("Basically, all SW-resets in DPU are not necessary"),
+	 * and a reset here would wipe live shadow state.
+	 */
+
+	/* clock auto gating */
+	decon_write_mask(decon, DECON_CLOCK_CONTROL_0, ~0U,
+			 DECON_CLOCK_CONTROL_0_F_MASK);
+
+	/* SRAM share: DECON0 uses FF0 + floating frame FIFO (8K total) */
+	decon_write(decon, DECON_SRAM_SHARE_ENABLE,
+		    DECON_SRAM_SHARE_FLOATING_F | DECON_SRAM_SHARE_FF0_F);
+
+	/* MIPI command mode (I80-style interface to DSIM) */
+	decon_write_mask(decon, DECON_GLOBAL_CONTROL,
+			 DECON_GLOBAL_CONTROL_OP_MODE_CMD,
+			 DECON_GLOBAL_CONTROL_OP_MODE_CMD);
+
+	/* blender background image size */
+	decon_write_mask(decon, DECON_BLENDER_BG_IMAGE_SIZE_0,
+			 DECON_BLENDER_BG_HEIGHT_F(height) |
+			 DECON_BLENDER_BG_WIDTH_F(width),
+			 DECON_BLENDER_BG_HEIGHT_F(0x3fff) |
+			 DECON_BLENDER_BG_WIDTH_F(0x3fff));
+	decon_write(decon, DECON_BLENDER_BG_IMAGE_SIZE_1, width * height);
+
+	/* formatter RGB order: DSC path uses DECON_RGB (0) */
+	decon_write_mask(decon, DECON_FORMATTER_CONTROL,
+			 DECON_FORMATTER_OUT_RGB_ORDER_F(0),
+			 DECON_FORMATTER_OUT_RGB_ORDER_MASK);
+
+	/*
+	 * Data path: DSCC -> DSC enc 0/1 -> frame FIFO 0/1 ->
+	 * formatter 0 -> DSIM IF 0.
+	 */
+	decon_write_mask(decon, DECON_DATA_PATH_CONTROL_2,
+			 DECON_ENHANCE_LOGIC_PATH_F(0) |
+			 DECON_COMP_LINKIF_WB_PATH_F(
+				 DECON_DPATH_DSCC_DSCENC01_FF01_FORMATTER0_DSIMIF0),
+			 DECON_ENHANCE_LOGIC_PATH_MASK |
+			 DECON_COMP_LINKIF_WB_PATH_MASK);
+
+	/*
+	 * Splitter: sizes are in compressed pixel units (1/3 rate): each
+	 * DSC encoder covers 720 source px = 240 compressed units, and the
+	 * two encoders merge into the formatter at 480.  Follows downstream
+	 * decon_reg_config_data_path_size(width_per_enc=240): splitter width
+	 * field doubles to 480 while its count uses 240, split index = 240.
+	 */
+	decon_write(decon, DECON_SPLITTER_SIZE_CONTROL_0,
+		    DECON_SPLITTER_HEIGHT_F(height) |
+		    DECON_SPLITTER_WIDTH_F(width_per_enc * 2));
+	decon_write(decon, DECON_SPLITTER_SIZE_CONTROL_1,
+		    width_per_enc * height);
+	decon_write(decon, DECON_SPLITTER_SPLIT_IDX_CONTROL, width_per_enc);
+	decon_write(decon, DECON_SPLITTER_OVERLAP_CONTROL, 0);
+
+	/* frame FIFOs: one per DSC encoder, compressed units */
+	decon_write(decon, DECON_FRAME_FIFO_0_SIZE_0,
+		    DECON_FRAME_FIFO_HEIGHT_F(height) |
+		    DECON_FRAME_FIFO_WIDTH_F(width_per_enc));
+	decon_write(decon, DECON_FRAME_FIFO_0_SIZE_1, width_per_enc * height);
+	decon_write(decon, DECON_FRAME_FIFO_1_SIZE_0,
+		    DECON_FRAME_FIFO_HEIGHT_F(height) |
+		    DECON_FRAME_FIFO_WIDTH_F(width_per_enc));
+	decon_write(decon, DECON_FRAME_FIFO_1_SIZE_1, width_per_enc * height);
+	decon_write(decon, DECON_FRAME_FIFO_TH_CONTROL_0,
+		    DECON_FRAME_FIFO_1_TH_F(width_per_enc) |
+		    DECON_FRAME_FIFO_0_TH_F(width_per_enc));
+
+	/* formatter 0 carries the merged DSC stream (2 x 240 = 480) */
+	decon_write(decon, DECON_FORMATTER0_SIZE_0,
+		    DECON_FORMATTER_HEIGHT_F(height) |
+		    DECON_FORMATTER_WIDTH_F(width_per_enc * 2));
+	decon_write(decon, DECON_FORMATTER0_SIZE_1, width_per_enc * 2 * height);
+
+	/* dual DSC encoders from the panel PPS table */
+	decon_dsc_setup_encoder(decon, DECON_DSC0_OFFSET);
+	decon_dsc_setup_encoder(decon, DECON_DSC1_OFFSET);
+
+	/* window 0: IDMA_G0 is DMA channel 5, opaque copy blending */
+	decon_write_mask(decon, DECON_DATA_PATH_CONTROL_1,
+			 DECON_WIN_CHMAP_F(0, 5), DECON_WIN_CHMAP_MASK(0));
+	/* only window 0: drop the bootloader's window 5 (also on ch 5) */
+	decon_write_mask(decon, DECON_DATA_PATH_CONTROL_0,
+			 DECON_WIN_EN_F(0), DECON_WIN_EN_F(0) | DECON_WIN_EN_F(5));
+	decon_write(decon, DECON_WIN_CONTROL_0(0),
+		    DECON_WIN_ALPHA1_F(0xff) | DECON_WIN_ALPHA0_F(0xff) |
+		    DECON_WIN_FUNC_F(DECON_WIN_PD_FUNC_COPY));
+	decon_write(decon, DECON_WIN_START_POSITION(0),
+		    DECON_WIN_STRPTR_Y_F(0) | DECON_WIN_STRPTR_X_F(0));
+	decon_write(decon, DECON_WIN_END_POSITION(0),
+		    DECON_WIN_ENDPTR_Y_F(height - 1) |
+		    DECON_WIN_ENDPTR_X_F(width - 1));
+	decon_write(decon, DECON_WIN_PIXEL_COUNT(0), width * height);
+
+	/* TE from GPIO, route DECON (DISPIF0) to DSIM0 */
+	regmap_write(decon->disp_ss, DISP_SS_DPU_TE_SEL, DISP_SS_TE_FROM_GPIO);
+	regmap_write(decon->disp_ss, DISP_SS_DLMUX_CFG,
+		     DISP_SS_DLMUX_DISPIF0_DSIM0);
+
+	/* command mode: keep trigger masked until the first frame */
+	decon_write_mask(decon, DECON_HW_SW_TRIG_CONTROL,
+			 DECON_TRIG_AUTO_MASK_EN | DECON_HW_TRIG_SEL_FROM_DDI0,
+			 DECON_TRIG_AUTO_MASK_EN |
+			 DECON_HW_TRIG_SEL_MASK);
+	decon_trigger_set(decon, false);
+
+	/* clear stale interrupts, then enable frame done */
+	decon_write_mask(decon, DECON_INTERRUPT_PENDING, ~0U,
+			 DECON_INT_FRAME_DONE_PEND |
+			 DECON_INT_FRAME_START_PEND |
+			 DECON_INT_EXTRA_PEND);
+	decon_write(decon, DECON_EXTRA_INTERRUPT_PENDING, ~0U);
+	decon_write_mask(decon, DECON_INTERRUPT_ENABLE,
+			 DECON_INT_FRAME_START_EN | DECON_INT_FRAME_DONE_EN |
+			 DECON_INT_EN,
+			 DECON_INTERRUPT_ENABLE_MASK);
+
+	dev_info(decon->dev,
+		 "DECON_f initialized: %ux%u mode, dual-DSC path (per-enc %u)\n",
+		 width, height, width_per_enc);
+	return 0;
+}
+
+static int decon_hw_start(struct exynos8895_decon *decon)
+{
+	int ret;
+
+	/* run: DECON_EN + DECON_EN_F */
+	decon_write_mask(decon, DECON_GLOBAL_CONTROL,
+			 DECON_GLOBAL_CONTROL_DECON_EN |
+			 DECON_GLOBAL_CONTROL_DECON_EN_F,
+			 DECON_GLOBAL_CONTROL_DECON_EN |
+			 DECON_GLOBAL_CONTROL_DECON_EN_F);
+	decon_shadow_update_req(decon);
+
+	/*
+	 * Without HW TE the DECON enters run status as soon as the shadow
+	 * update is requested; with TE it waits for the first trigger.
+	 */
+	ret = decon_wait_run_status(decon, true);
+	if (ret)
+		dev_warn(decon->dev, "DECON run status timed out\n");
+
+	decon_trigger_set(decon, true);
+	return ret;
+}
+
+static void decon_hw_stop(struct exynos8895_decon *decon)
+{
+	u32 val;
+
+	decon_trigger_set(decon, false);
+	decon_write_mask(decon, DECON_GLOBAL_CONTROL, 0,
+			 DECON_GLOBAL_CONTROL_DECON_EN |
+			 DECON_GLOBAL_CONTROL_DECON_EN_F);
+	decon_shadow_update_req(decon);
+	readl_poll_timeout(decon->regs + DECON_GLOBAL_CONTROL, val,
+			   val & DECON_GLOBAL_CONTROL_IDLE_STATUS,
+			   100, DECON_IDLE_TIMEOUT_US);
+}
+
+/* ------------------------------------------------------------------ */
+/* IDMA_G0                                                             */
+/* ------------------------------------------------------------------ */
+
+static void idma_init(struct exynos8895_decon *decon)
+{
+	/* global clock gating for the DPU DMA blocks */
+	writel(readl(decon->dma_com + DPU_DMA_GLB_CGEN) |
+	       DPU_DMA_ALL_CGEN_MASK, decon->dma_com + DPU_DMA_GLB_CGEN);
+
+	/*
+	 * No IDMA software reset: downstream deliberately avoids SW-resets
+	 * in the DPU blocks, and a reset would wipe the plane state that
+	 * atomic_enable re-applies right after this function.
+	 */
+
+	/* G0 feeds window channel 1 (downstream dma_reg_set_ch_map(G0)) */
+	{
+		u32 v = readl(decon->dma_com + DPU_DMA_CH_MAP);
+
+		v &= ~0x3;
+		v |= 1;
+		writel(v, decon->dma_com + DPU_DMA_CH_MAP);
+	}
+
+	/* clock gates, clear and mask all DMA interrupts */
+	idma_write_mask(decon, IDMA_ENABLE,
+			IDMA_SFR_CLOCK_GATE_EN | IDMA_SRAM_CLOCK_GATE_EN,
+			IDMA_SFR_CLOCK_GATE_EN | IDMA_SRAM_CLOCK_GATE_EN);
+	idma_write_mask(decon, IDMA_IRQ, IDMA_ALL_IRQ_CLEAR, IDMA_ALL_IRQ_CLEAR);
+	idma_write_mask(decon, IDMA_IRQ, IDMA_ALL_IRQ_MASK, IDMA_ALL_IRQ_MASK);
+
+	/* opaque frame alpha */
+	idma_write_mask(decon, IDMA_OUT_CON, IDMA_OUT_FRAME_ALPHA_F(0xff),
+			IDMA_OUT_FRAME_ALPHA_MASK);
+}
+
+static void idma_setup_plane(struct exynos8895_decon *decon,
+			     struct drm_framebuffer *fb,
+			     dma_addr_t dma_addr,
+			     u32 src_w, u32 src_h, u32 crtc_x, u32 crtc_y,
+			     u32 dst_w, u32 dst_h)
+{
+	u32 fmt = IDMA_IMG_FORMAT_XRGB8888;
+
+	if (fb) {
+		switch (fb->format->format) {
+		case DRM_FORMAT_XRGB8888:
+			fmt = IDMA_IMG_FORMAT_XRGB8888;
+			break;
+		case DRM_FORMAT_ARGB8888:
+			fmt = IDMA_IMG_FORMAT_ARGB8888;
+			break;
+		case DRM_FORMAT_RGB565:
+			fmt = IDMA_IMG_FORMAT_RGB565;
+			break;
+		default:
+			fmt = IDMA_IMG_FORMAT_XRGB8888;
+			break;
+		}
+	}
+
+	idma_write_mask(decon, IDMA_IN_CON, IDMA_IMG_FORMAT_F(fmt),
+			IDMA_IMG_FORMAT_MASK);
+	idma_write(decon, IDMA_SRC_SIZE,
+		   IDMA_SRC_HEIGHT_F(src_h) | IDMA_SRC_WIDTH_F(src_w));
+	idma_write(decon, IDMA_SRC_OFFSET, 0);
+	idma_write(decon, IDMA_IMG_SIZE,
+		   IDMA_IMG_HEIGHT_F(src_h) | IDMA_IMG_WIDTH_F(src_w));
+	idma_write(decon, IDMA_IN_BASE_ADDR_Y, lower_32_bits(dma_addr));
+
+	/* DECON window 0 geometry */
+	decon_write(decon, DECON_WIN_START_POSITION(0),
+		    DECON_WIN_STRPTR_Y_F(crtc_y) | DECON_WIN_STRPTR_X_F(crtc_x));
+	decon_write(decon, DECON_WIN_END_POSITION(0),
+		    DECON_WIN_ENDPTR_Y_F(crtc_y + dst_h - 1) |
+		    DECON_WIN_ENDPTR_X_F(crtc_x + dst_w - 1));
+	decon_write(decon, DECON_WIN_PIXEL_COUNT(0), dst_w * dst_h);
+
+	/* latch IDMA shadow registers */
+	idma_write_mask(decon, IDMA_ENABLE, IDMA_SFR_UPDATE_FORCE,
+			IDMA_SFR_UPDATE_FORCE);
+}
+
+static void decon_heartbeat_timer(struct timer_list *t)
+{
+	struct exynos8895_decon *decon =
+		container_of(t, struct exynos8895_decon, heartbeat);
+
+	printk(KERN_INFO "decon heartbeat %d enabled=%d\n",
+	       decon->heartbeat_count++, decon->enabled);
+	if (decon->heartbeat_count < 200)
+		mod_timer(&decon->heartbeat,
+			  jiffies + msecs_to_jiffies(500));
+}
+
+/* ------------------------------------------------------------------ */
+/* interrupt                                                           */
+/* ------------------------------------------------------------------ */
+
+static irqreturn_t decon_irq_handler(int irq, void *dev_id)
+{
+	struct exynos8895_decon *decon = dev_id;
+	u32 pend;
+
+	if (!decon->enabled)
+		return IRQ_NONE;
+
+	pend = decon_read(decon, DECON_INTERRUPT_PENDING);
+
+	if (pend & DECON_INT_FRAME_START_PEND)
+		drm_crtc_handle_vblank(&decon->crtc);
+	if (pend & DECON_INT_FRAME_DONE_PEND)
+		complete(&decon->frame_done);
+
+	/*
+	 * Command mode: the flip's registers are latched at the TE-triggered
+	 * frame start that clears the shadow update request.  From then on
+	 * the old buffer is no longer read, so complete the event right
+	 * away (normally at frame start) instead of after the ~10 ms DSI
+	 * transfer; waiting for frame done made KWin miss every other TE.
+	 */
+	if (pend & (DECON_INT_FRAME_START_PEND | DECON_INT_FRAME_DONE_PEND)) {
+		spin_lock(&decon->drm.event_lock);
+		if (decon->event &&
+		    !(decon_read(decon, DECON_SHADOW_REG_UPDATE_REQ) &
+		      DECON_SHADOW_UPDATE_GLOBAL)) {
+			drm_crtc_send_vblank_event(&decon->crtc, decon->event);
+			drm_crtc_vblank_put(&decon->crtc);
+			decon->event = NULL;
+		}
+		spin_unlock(&decon->drm.event_lock);
+	}
+	if (pend & DECON_INT_EXTRA_PEND)
+		dev_err_ratelimited(decon->dev, "DPU extra interrupt pending\n");
+
+	decon_write_mask(decon, DECON_INTERRUPT_PENDING,
+			 pend & (DECON_INT_FRAME_DONE_PEND |
+				 DECON_INT_FRAME_START_PEND |
+				 DECON_INT_EXTRA_PEND),
+			 DECON_INT_FRAME_DONE_PEND |
+			 DECON_INT_FRAME_START_PEND |
+			 DECON_INT_EXTRA_PEND);
+
+	return IRQ_HANDLED;
+}
+
+/* ------------------------------------------------------------------ */
+/* plane                                                               */
+/* ------------------------------------------------------------------ */
+
+static const u32 decon_plane_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_RGB565,
+};
+
+static int decon_plane_atomic_check(struct drm_plane *plane,
+				    struct drm_atomic_state *state)
+{
+	struct drm_plane_state *plane_state =
+		drm_atomic_get_new_plane_state(state, plane);
+	struct drm_crtc_state *crtc_state;
+
+	if (!plane_state->crtc)
+		return 0;
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, plane_state->crtc);
+	return drm_atomic_helper_check_plane_state(plane_state, crtc_state,
+						   DRM_PLANE_NO_SCALING,
+						   DRM_PLANE_NO_SCALING,
+						   false, false);
+}
+
+static void decon_plane_apply(struct exynos8895_decon *decon,
+			      struct drm_plane_state *plane_state)
+{
+	struct drm_framebuffer *fb = plane_state->fb;
+	struct exynos8895_decon_gem *gem;
+	u32 src_w, src_h, dst_w, dst_h;
+
+	gem = to_decon_gem(fb->obj[0]);
+	src_w = drm_rect_width(&plane_state->src) >> 16;
+	src_h = drm_rect_height(&plane_state->src) >> 16;
+	dst_w = drm_rect_width(&plane_state->dst);
+	dst_h = drm_rect_height(&plane_state->dst);
+
+	if (src_w > DECON_MAX_WIDTH || src_h > DECON_MAX_HEIGHT)
+		return;
+
+	idma_setup_plane(decon, fb, gem->dma_addr + fb->offsets[0],
+			 src_w, src_h,
+			 plane_state->dst.x1, plane_state->dst.y1,
+			 dst_w, dst_h);
+}
+
+static void decon_plane_atomic_update(struct drm_plane *plane,
+				      struct drm_atomic_state *state)
+{
+	struct exynos8895_decon *decon = to_decon(plane->dev);
+	struct drm_plane_state *plane_state =
+		drm_atomic_get_new_plane_state(state, plane);
+
+	/*
+	 * If the CRTC is not running yet, the programming would be wiped
+	 * by idma_init()/decon_hw_init() in atomic_enable; the enable path
+	 * re-applies this plane state once the hardware is initialized.
+	 */
+	if (!decon->enabled || !plane_state->fb)
+		return;
+
+	decon_plane_apply(decon, plane_state);
+}
+
+static void decon_plane_atomic_disable(struct drm_plane *plane,
+				       struct drm_atomic_state *state)
+{
+	struct exynos8895_decon *decon = to_decon(plane->dev);
+
+	if (!decon->enabled)
+		return;
+
+	decon_write_mask(decon, DECON_DATA_PATH_CONTROL_0, 0, DECON_WIN_EN_F(0));
+	decon_shadow_update_req(decon);
+}
+
+static const struct drm_plane_helper_funcs decon_plane_helper_funcs = {
+	.atomic_check = decon_plane_atomic_check,
+	.atomic_update = decon_plane_atomic_update,
+	.atomic_disable = decon_plane_atomic_disable,
+};
+
+static const struct drm_plane_funcs decon_plane_funcs = {
+	.update_plane = drm_atomic_helper_update_plane,
+	.disable_plane = drm_atomic_helper_disable_plane,
+	.destroy = drm_plane_cleanup,
+	.reset = drm_atomic_helper_plane_reset,
+	.atomic_duplicate_state = drm_atomic_helper_plane_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_plane_destroy_state,
+};
+
+/* ------------------------------------------------------------------ */
+/* CRTC                                                                */
+/* ------------------------------------------------------------------ */
+
+static void decon_crtc_atomic_enable(struct drm_crtc *crtc,
+				     struct drm_atomic_state *state)
+{
+	struct exynos8895_decon *decon = to_decon(crtc->dev);
+	struct drm_display_mode *mode = &crtc->state->adjusted_mode;
+	int ret;
+
+	dev_info(decon->dev, "CRTC enable: step clk\n");
+	clk_prepare_enable(decon->dpu_bus);
+	dev_info(decon->dev, "CRTC enable: step gates\n");
+	decon_setup_clocks(decon);
+
+	dev_info(decon->dev, "CRTC enable: step idma\n");
+	idma_init(decon);
+
+	dev_info(decon->dev, "CRTC enable: step hw_init\n");
+	ret = decon_hw_init(decon, mode);
+	if (ret)
+		goto out_clk;
+
+	/*
+	 * idma_init()/decon_hw_init() may clobber IDMA/window state that a
+	 * plane update for this commit already programmed; re-apply the
+	 * new plane state now that the hardware is initialized.
+	 */
+	{
+		struct drm_plane_state *plane_state =
+			drm_atomic_get_new_plane_state(state, &decon->plane);
+
+		if (plane_state && plane_state->fb)
+			decon_plane_apply(decon, plane_state);
+		else
+			decon_write_mask(decon, DECON_DATA_PATH_CONTROL_0, 0,
+					 DECON_WIN_EN_F(0));
+	}
+
+	/*
+	 * Coordinated DSC handoff: the bridge chain pre_enable already ran
+	 * the panel prepare (PPS + TE programming), so the DSIM can now
+	 * switch from the Stage 2 non-DSC probe config to the
+	 * compressed-stream scanout config before the first trigger.
+	 * Non-fatal for now.
+	 */
+	{
+		int dsc_ret;
+
+		dev_info(decon->dev, "CRTC enable: step dsc handoff\n");
+		dsc_ret = exynos8895_dsim_enable_dsc(decon->panel->dev->parent);
+		dev_info(decon->dev, "DSIM DSC handoff: %d\n", dsc_ret);
+	}
+
+	dev_info(decon->dev, "CRTC enable: step start\n");
+	decon->enabled = true;
+	enable_irq(decon->irq);
+
+	decon_hw_start(decon);
+	drm_crtc_vblank_on(crtc);
+	return;
+
+out_clk:
+	clk_disable_unprepare(decon->dpu_bus);
+}
+
+static void decon_crtc_atomic_disable(struct drm_crtc *crtc,
+				      struct drm_atomic_state *state)
+{
+	struct exynos8895_decon *decon = to_decon(crtc->dev);
+
+	if (!decon->enabled)
+		return;
+
+	drm_crtc_vblank_off(crtc);
+	disable_irq(decon->irq);
+	decon_hw_stop(decon);
+	decon->enabled = false;
+
+	spin_lock_irq(&crtc->dev->event_lock);
+	if (decon->event) {
+		drm_crtc_send_vblank_event(crtc, decon->event);
+		drm_crtc_vblank_put(crtc);
+		decon->event = NULL;
+	}
+	if (crtc->state->event && !crtc->state->active) {
+		drm_crtc_send_vblank_event(crtc, crtc->state->event);
+		crtc->state->event = NULL;
+	}
+	spin_unlock_irq(&crtc->dev->event_lock);
+
+	clk_disable_unprepare(decon->dpu_bus);
+}
+
+static void decon_crtc_atomic_flush(struct drm_crtc *crtc,
+				    struct drm_atomic_state *state)
+{
+	struct exynos8895_decon *decon = to_decon(crtc->dev);
+	struct drm_pending_vblank_event *event = crtc->state->event;
+
+	if (!decon->enabled) {
+		/* CRTC off: nothing will scan out, complete right away */
+		if (event) {
+			spin_lock_irq(&crtc->dev->event_lock);
+			drm_crtc_send_vblank_event(crtc, event);
+			spin_unlock_irq(&crtc->dev->event_lock);
+			crtc->state->event = NULL;
+		}
+		return;
+	}
+
+	/*
+	 * The HW trigger stays armed while the CRTC is on, so every TE
+	 * sends a frame; request the shadow update and let the frame-done
+	 * interrupt complete the event once the new state is on screen.
+	 */
+	if (event) {
+		WARN_ON(drm_crtc_vblank_get(crtc));
+		spin_lock_irq(&crtc->dev->event_lock);
+		decon->event = event;
+		spin_unlock_irq(&crtc->dev->event_lock);
+		crtc->state->event = NULL;
+	}
+
+	decon_shadow_update_req(decon);
+}
+
+static const struct drm_crtc_helper_funcs decon_crtc_helper_funcs = {
+	.atomic_enable = decon_crtc_atomic_enable,
+	.atomic_disable = decon_crtc_atomic_disable,
+	.atomic_flush = decon_crtc_atomic_flush,
+};
+
+/*
+ * The frame-done interrupt is enabled for as long as the CRTC runs (the
+ * trigger stays armed), so vblank reporting needs no extra switching.
+ */
+static int decon_crtc_enable_vblank(struct drm_crtc *crtc)
+{
+	return 0;
+}
+
+static void decon_crtc_disable_vblank(struct drm_crtc *crtc)
+{
+}
