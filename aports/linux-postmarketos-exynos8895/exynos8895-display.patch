+				regulator-min-microvolt = <1500000>;
+				regulator-max-microvolt = <1600000>;
+				regulator-always-on;
+			};
+
+			vdd_ddi_1p8: ldo1 {
+				regulator-name = "vdd_ddi_1p8";
