+#if IS_ENABLED(CONFIG_DRM_FBDEV_EMULATION)
+/*
+ * fbdev emulation.
+ *
+ * The generic fbdev helpers in this tree only support shmem or DMA-heap
+ * GEM objects; this driver uses its own contiguous GEM objects, so the
+ * probe below mirrors drm_fbdev_dma_driver_fbdev_probe() without the
+ * dma-helper specific bits.
+ */
+
+static int decon_fbdev_fb_open(struct fb_info *info, int user)
+{
+	struct drm_fb_helper *fb_helper = info->par;
+
+	if (user && !try_module_get(fb_helper->dev->driver->fops->owner))
+		return -ENODEV;
+
+	return 0;
+}
+
+static int decon_fbdev_fb_release(struct fb_info *info, int user)
+{
+	struct drm_fb_helper *fb_helper = info->par;
+
+	if (user)
+		module_put(fb_helper->dev->driver->fops->owner);
+
+	return 0;
+}
+
+static int decon_fbdev_fb_mmap(struct fb_info *info, struct vm_area_struct *vma)
+{
+	struct drm_fb_helper *fb_helper = info->par;
+
+	return drm_gem_prime_mmap(fb_helper->buffer->gem, vma);
+}
+
+static void decon_fbdev_fb_destroy(struct fb_info *info)
+{
+	struct drm_fb_helper *fb_helper = info->par;
+
+	if (!fb_helper->dev)
+		return;
+
+	drm_fb_helper_fini(fb_helper);
+
+	drm_client_buffer_vunmap(fb_helper->buffer);
+	drm_client_buffer_delete(fb_helper->buffer);
+	drm_client_release(&fb_helper->client);
+}
+
+static const struct fb_ops decon_fbdev_fb_ops = {
+	.owner = THIS_MODULE,
+	.fb_open = decon_fbdev_fb_open,
+	.fb_release = decon_fbdev_fb_release,
+	__FB_DEFAULT_SYSMEM_OPS_RDWR,
+	DRM_FB_HELPER_DEFAULT_OPS,
+	__FB_DEFAULT_SYSMEM_OPS_DRAW,
+	.fb_mmap = decon_fbdev_fb_mmap,
+	.fb_destroy = decon_fbdev_fb_destroy,
+};
+
+static int decon_fbdev_probe(struct drm_fb_helper *fb_helper,
+			     struct drm_fb_helper_surface_size *sizes)
+{
+	struct drm_client_dev *client = &fb_helper->client;
+	struct drm_device *dev = fb_helper->dev;
+	struct drm_client_buffer *buffer;
+	struct drm_framebuffer *fb;
+	struct fb_info *info = fb_helper->info;
+	struct iosys_map map;
+	u32 format;
+	int ret;
+
+	dev_info(dev->dev, "fbdev probe: enter %ux%u bpp%u\n",
+		 sizes->surface_width, sizes->surface_height,
+		 sizes->surface_bpp);
+	format = drm_driver_legacy_fb_format(dev, sizes->surface_bpp,
+					     sizes->surface_depth);
+	dev_info(dev->dev, "fbdev probe: buffer create fmt 0x%x\n", format);
+	buffer = drm_client_buffer_create_dumb(client, sizes->surface_width,
+					       sizes->surface_height, format);
+	if (IS_ERR(buffer))
+		return PTR_ERR(buffer);
+
+	fb = buffer->fb;
+
+	dev_info(dev->dev, "fbdev probe: vmap\n");
+	ret = drm_client_buffer_vmap(buffer, &map);
+	if (ret)
+		goto err_buffer_delete;
+	if (drm_WARN_ON(dev, map.is_iomem)) {
+		ret = -ENODEV;
+		goto err_buffer_vunmap;
+	}
+
+	fb_helper->buffer = buffer;
+	fb_helper->fb = fb;
+
+	drm_fb_helper_fill_info(info, fb_helper, sizes);
+
+	info->fbops = &decon_fbdev_fb_ops;
+	info->flags |= FBINFO_VIRTFB;
+	info->screen_size = sizes->surface_height * fb->pitches[0];
+	info->screen_buffer = map.vaddr;
+	/* vaddr is a write-combine remap; report the real DMA address */
+	info->fix.smem_start = to_decon_gem(buffer->gem)->dma_addr;
+	info->fix.smem_len = info->screen_size;
+
+	dev_info(dev->dev, "fbdev probe: done, registering console\n");
+	return 0;
+
+err_buffer_vunmap:
+	drm_client_buffer_vunmap(buffer);
+err_buffer_delete:
+	drm_client_buffer_delete(buffer);
+	return ret;
+}
+#endif /* CONFIG_DRM_FBDEV_EMULATION */
+
