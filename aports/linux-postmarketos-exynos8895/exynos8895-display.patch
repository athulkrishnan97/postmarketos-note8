+
 &usi9 {
 	samsung,mode = <USI_MODE_I2C0_1>;
 
 	status = "okay";
 };
 
+/* DECON_f display controller (Stage 3 bring-up; simple-framebuffer stays
+ * as fallback) */
+&decon_f {
+	pinctrl-names = "default";
+	pinctrl-0 = <&decon_f_te_on>;
+
+	status = "okay";
+};
+
+/* DSIM0 host + S6E3HA6 panel (command mode, DSC, 4 lanes) */
+&dsim0 {
+	status = "okay";
+
+	panel@0 {
+		compatible = "samsung,s6e3ha6";
+		reg = <0>;
+
+		reset-gpios = <&gpa0 5 GPIO_ACTIVE_LOW>;
+
+		vdd_ddi_3p0-supply = <&vdd_ddi_3p0>;
+		vdd_ddi_1p8-supply = <&vdd_ddi_1p8>;
+		vdd_ddi_1p6-supply = <&vdd_ddi_1p6>;
+	};
+};
+
 /* Dedicated Bluetooth UART (UART_BT) */
 &serial_1 {
 	status = "okay";
