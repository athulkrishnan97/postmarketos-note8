+/* ------------------------------------------------------------------ */
+/* probe / remove                                                      */
+/* ------------------------------------------------------------------ */
+
+static struct drm_panel *decon_find_panel(struct device *dev)
+{
+	struct device_node *dsim_np;
+	struct device_node *child;
+	struct drm_panel *panel = NULL;
+	bool defer = false;
+
+	dsim_np = of_find_compatible_node(NULL, NULL, "samsung,exynos8895-dsim");
+	if (!dsim_np)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	for_each_available_child_of_node(dsim_np, child) {
+		panel = of_drm_find_panel(child);
+		if (!IS_ERR(panel))
+			break;
+		if (PTR_ERR(panel) == -EPROBE_DEFER)
+			defer = true;
+		panel = NULL;
+	}
+
+	of_node_put(dsim_np);
+
+	if (!panel)
+		return ERR_PTR(defer ? -EPROBE_DEFER : -ENODEV);
+
+	return panel;
+}
+
+static int exynos8895_decon_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos8895_decon *decon;
+	struct drm_panel *panel;
+	struct drm_bridge *bridge;
+	struct drm_encoder *encoder;
+	struct drm_connector *connector;
+	int ret;
+
+	decon = devm_drm_dev_alloc(dev, &decon_drm_driver,
+				   struct exynos8895_decon, drm);
+	if (IS_ERR(decon))
+		return PTR_ERR(decon);
+
+	decon->dev = dev;
+	init_completion(&decon->frame_done);
+
+	ret = drmm_mode_config_init(&decon->drm);
+	if (ret)
+		return ret;
+
+	decon->regs = devm_platform_ioremap_resource_byname(pdev, "decon");
+	if (IS_ERR(decon->regs))
+		return dev_err_probe(dev, PTR_ERR(decon->regs),
+				     "failed to map DECON registers\n");
+
+	decon->idma = devm_platform_ioremap_resource_byname(pdev, "idma");
+	if (IS_ERR(decon->idma))
+		return dev_err_probe(dev, PTR_ERR(decon->idma),
+				     "failed to map IDMA registers\n");
+
+	decon->dma_com = devm_platform_ioremap_resource_byname(pdev, "dma");
+	if (IS_ERR(decon->dma_com))
+		return dev_err_probe(dev, PTR_ERR(decon->dma_com),
+				     "failed to map DPU DMA registers\n");
+
+	{
+		struct resource *res;
+
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "cmu");
+		if (!res)
+			return dev_err_probe(dev, -ENODEV,
+					     "failed to get DPU0 CMU registers\n");
+
+		/*
+		 * The DSIM driver already owns the DPU0 CMU resource, so this
+		 * shared range must be mapped without claiming it again.
+		 */
+		decon->cmu = devm_ioremap(dev, res->start, resource_size(res));
+		if (!decon->cmu)
+			return dev_err_probe(dev, -ENOMEM,
+					     "failed to map DPU0 CMU registers\n");
+	}
+
+	decon->disp_ss = syscon_regmap_lookup_by_phandle(dev->of_node,
+							 "samsung,disp-syscon");
+	if (IS_ERR(decon->disp_ss))
+		return dev_err_probe(dev, PTR_ERR(decon->disp_ss),
+				     "failed to get disp-ss syscon\n");
+
+	decon->dpu_bus = devm_clk_get(dev, "dpu_bus");
+	if (IS_ERR(decon->dpu_bus))
+		return dev_err_probe(dev, PTR_ERR(decon->dpu_bus),
+				     "failed to get dpu_bus clock\n");
+
+	panel = decon_find_panel(dev);
+	if (IS_ERR(panel))
+		return dev_err_probe(dev, PTR_ERR(panel),
+				     "failed to find DSI panel\n");
+	decon->panel = panel;
+
+	/*
+	 * The bootloader leaves DECON_f running and its frame-done interrupt
+	 * firing.  Halt it and mask/clear its interrupt sources before
+	 * registering the handler, otherwise the stale storm trips "nobody
+	 * cared" and the core disables the line.  Done only on the
+	 * successful probe path so deferred retries never touch registers.
+	 */
+	{
+		u32 val;
+
+		decon_write_mask(decon, DECON_INTERRUPT_ENABLE, 0,
+				 DECON_INTERRUPT_ENABLE_MASK);
+		decon_write_mask(decon, DECON_INTERRUPT_PENDING, ~0U,
+				 DECON_INT_FRAME_DONE_PEND |
+				 DECON_INT_FRAME_START_PEND |
+				 DECON_INT_EXTRA_PEND);
+		decon_write(decon, DECON_EXTRA_INTERRUPT_PENDING, ~0U);
+		decon_write_mask(decon, DECON_GLOBAL_CONTROL, 0,
+				 DECON_GLOBAL_CONTROL_DECON_EN |
+				 DECON_GLOBAL_CONTROL_DECON_EN_F);
+		readl_poll_timeout(decon->regs + DECON_GLOBAL_CONTROL, val,
+				   val & DECON_GLOBAL_CONTROL_IDLE_STATUS,
+				   100, DECON_IDLE_TIMEOUT_US);
+		dev_info(dev, "DECON_f halted from bootloader state (GLOBAL_CONTROL 0x%x)\n",
+			 readl(decon->regs + DECON_GLOBAL_CONTROL));
+	}
+
+	/* frame done interrupt */
+	decon->irq = platform_get_irq(pdev, 1);
+	if (decon->irq < 0)
+		return decon->irq;
+
+	ret = devm_request_irq(dev, decon->irq, decon_irq_handler, 0,
+			       dev_name(dev), decon);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+	disable_irq(decon->irq);
+
+	bridge = devm_drm_panel_bridge_add(dev, panel);
+	if (IS_ERR(bridge))
+		return dev_err_probe(dev, PTR_ERR(bridge),
+				     "failed to create panel bridge\n");
+
+	/* primary plane */
+	ret = drm_universal_plane_init(&decon->drm, &decon->plane, 0,
+				       &decon_plane_funcs,
+				       decon_plane_formats,
+				       ARRAY_SIZE(decon_plane_formats),
+				       NULL, DRM_PLANE_TYPE_PRIMARY, NULL);
+	if (ret)
+		return ret;
+
+	drm_plane_helper_add(&decon->plane, &decon_plane_helper_funcs);
+
+	/* CRTC */
+	ret = drm_crtc_init_with_planes(&decon->drm, &decon->crtc,
+					&decon->plane, NULL,
+					&decon_crtc_funcs, NULL);
+	if (ret)
+		goto err_plane;
+
+	drm_crtc_helper_add(&decon->crtc, &decon_crtc_helper_funcs);
+
+	/* encoder + panel bridge connector */
+	encoder = &decon->encoder;
+	ret = drm_encoder_init(&decon->drm, encoder, &decon_encoder_funcs,
+			       DRM_MODE_ENCODER_DSI, NULL);
+	if (ret)
+		goto err_crtc;
+
+	encoder->possible_crtcs = drm_crtc_mask(&decon->crtc);
+	drm_encoder_helper_add(encoder, &decon_encoder_helper_funcs);
+
+	ret = drm_bridge_attach(encoder, bridge, NULL,
+				DRM_BRIDGE_ATTACH_NO_CONNECTOR);
+	if (ret)
+		goto err_encoder;
+
+	connector = drm_bridge_connector_init(&decon->drm, encoder);
+	if (IS_ERR(connector)) {
+		ret = PTR_ERR(connector);
+		goto err_encoder;
+	}
+
+	ret = drm_connector_attach_encoder(connector, encoder);
+	if (ret)
+		goto err_encoder;
+
+	decon->drm.mode_config.funcs = &decon_mode_config_funcs;
+	decon->drm.mode_config.fb_modifiers_not_supported = true;
+	decon->drm.mode_config.min_width = 16;
+	decon->drm.mode_config.min_height = 16;
+	decon->drm.mode_config.max_width = DECON_MAX_WIDTH;
+	decon->drm.mode_config.max_height = DECON_MAX_HEIGHT;
+
+	ret = drm_vblank_init(&decon->drm, 1);
+	if (ret)
+		goto err_encoder;
+
+	drm_mode_config_reset(&decon->drm);
+
+	platform_set_drvdata(pdev, decon);
+
+	ret = drm_dev_register(&decon->drm, 0);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register DRM device\n");
+
+	timer_setup(&decon->heartbeat, decon_heartbeat_timer, 0);
+	mod_timer(&decon->heartbeat, jiffies + msecs_to_jiffies(1000));
+
+#if IS_ENABLED(CONFIG_DRM_FBDEV_EMULATION)
+	drm_client_setup(&decon->drm, NULL);
+#endif
+
+	dev_info(dev, "exynos8895 decon registered\n");
+	return 0;
+
+err_encoder:
+	drm_encoder_cleanup(encoder);
+err_crtc:
+	drm_crtc_cleanup(&decon->crtc);
+err_plane:
+	drm_plane_cleanup(&decon->plane);
+	return ret;
+}
+
+static void exynos8895_decon_remove(struct platform_device *pdev)
+{
+	struct exynos8895_decon *decon = platform_get_drvdata(pdev);
+
+	drm_atomic_helper_shutdown(&decon->drm);
+	drm_dev_unregister(&decon->drm);
+}
