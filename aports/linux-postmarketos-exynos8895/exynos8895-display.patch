+static const struct of_device_id exynos8895_decon_of_match[] = {
+	{ .compatible = "samsung,exynos8895-decon" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, exynos8895_decon_of_match);
+
+static struct platform_driver exynos8895_decon_driver = {
+	.probe = exynos8895_decon_probe,
+	.remove = exynos8895_decon_remove,
+	.driver = {
+		.name = "exynos8895-decon",
+		.of_match_table = exynos8895_decon_of_match,
+	},
+};
+module_platform_driver(exynos8895_decon_driver);
