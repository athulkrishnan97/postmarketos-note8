diff --git a/drivers/gpu/drm/bridge/regs-exynos8895-decon.h b/drivers/gpu/drm/bridge/regs-exynos8895-decon.h
new file mode 100644
index 000000000..e7176c2db
--- /dev/null
+++ b/drivers/gpu/drm/bridge/regs-exynos8895-decon.h
@@ -0,0 +1,245 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Exynos 8895 DECON_f register definitions
+ *
+ * Register map follows the downstream Exynos 8895 DPU
+ * (drivers/video/fbdev/exynos/dpu/regs-decon.h, regs-dpp.h @ 3cfb914).
+ * Only the registers used by the bring-up driver are listed.
+ */
+
+#ifndef _REGS_EXYNOS8895_DECON_H
+#define _REGS_EXYNOS8895_DECON_H
+
+/*
+ * DECON_f base 0x12860000
+ *	DECON core	0x0000 - 0x0304
+ *	window 0	0x1000 - 0x101C (stride 0x30 per window)
+ *	DSC0		0x4000
+ *	DSC1		0x5000
+ */
+#define DECON_GLOBAL_CONTROL		0x0000
+#define DECON_GLOBAL_CONTROL_SRESET	BIT(28)
+#define DECON_GLOBAL_CONTROL_OP_MODE_CMD	BIT(8)
+#define DECON_GLOBAL_CONTROL_IDLE_STATUS	BIT(5)
+#define DECON_GLOBAL_CONTROL_RUN_STATUS	BIT(4)
+#define DECON_GLOBAL_CONTROL_DECON_EN	BIT(1)
+#define DECON_GLOBAL_CONTROL_DECON_EN_F	BIT(0)
+
+#define DECON_SRAM_SHARE_ENABLE		0x0030
+#define DECON_SRAM_SHARE_FLOATING_F	BIT(24)
+#define DECON_SRAM_SHARE_FF0_F		BIT(12)
+
+#define DECON_INTERRUPT_ENABLE		0x0040
+#define DECON_INT_FRAME_DONE_EN		BIT(13)
+#define DECON_INT_FRAME_START_EN	BIT(12)
+#define DECON_INT_EXTRA_EN		BIT(4)
+#define DECON_INT_EN			BIT(0)
+#define DECON_INTERRUPT_ENABLE_MASK	0x3303711
+
+#define DECON_EXTRA_INTERRUPT_ENABLE	0x0044
+#define DECON_RESOURCE_CONFLICT_INT_EN	BIT(8)
+#define DECON_TIME_OUT_INT_EN		BIT(4)
+#define DECON_ERROR_INT_EN		BIT(0)
+
+#define DECON_INTERRUPT_PENDING		0x004c
+#define DECON_INT_FRAME_DONE_PEND	BIT(13)
+#define DECON_INT_FRAME_START_PEND	BIT(12)
+#define DECON_INT_EXTRA_PEND		BIT(4)
+
+#define DECON_EXTRA_INTERRUPT_PENDING	0x0050
+
+#define DECON_SHADOW_REG_UPDATE_REQ	0x0060
+#define DECON_SHADOW_UPDATE_GLOBAL	BIT(31)
+
+#define DECON_HW_SW_TRIG_CONTROL	0x0070
+#define DECON_HW_TRIG_SEL_FROM_DDI0	(0 << 24)
+#define DECON_HW_TRIG_SEL_MASK		(0x3 << 24)
+#define DECON_TRIG_AUTO_MASK_EN		BIT(12)
+#define DECON_SW_TRIG_EN		BIT(8)
+#define DECON_HW_TRIG_MASK_DECON		BIT(4)
+#define DECON_HW_TRIG_EN		BIT(0)
+
+#define DECON_CLOCK_CONTROL_0		0x00f0
+#define DECON_CLOCK_CONTROL_0_F_MASK	0x00511101
+
+#define DECON_SPLITTER_SIZE_CONTROL_0	0x0100
+#define DECON_SPLITTER_SIZE_CONTROL_1	0x0104
+#define DECON_SPLITTER_SPLIT_IDX_CONTROL	0x0108
+#define DECON_SPLITTER_OVERLAP_CONTROL	0x010c
+#define DECON_SPLITTER_HEIGHT_F(_v)	((_v) << 16)
+#define DECON_SPLITTER_WIDTH_F(_v)	((_v) << 0)
+
+#define DECON_FRAME_FIFO_0_SIZE_0	0x0120
+#define DECON_FRAME_FIFO_0_SIZE_1	0x0124
+#define DECON_FRAME_FIFO_1_SIZE_0	0x0128
+#define DECON_FRAME_FIFO_1_SIZE_1	0x012c
+#define DECON_FRAME_FIFO_HEIGHT_F(_v)	((_v) << 16)
+#define DECON_FRAME_FIFO_WIDTH_F(_v)	((_v) << 0)
+
+#define DECON_FRAME_FIFO_TH_CONTROL_0	0x0130
+#define DECON_FRAME_FIFO_1_TH_F(_v)	((_v) << 16)
+#define DECON_FRAME_FIFO_0_TH_F(_v)	((_v) << 0)
+
+#define DECON_FORMATTER_CONTROL		0x0190
+#define DECON_FORMATTER_OUT_RGB_ORDER_F(_v)	((_v) << 4)
+#define DECON_FORMATTER_OUT_RGB_ORDER_MASK	(0x7 << 4)
+
+#define DECON_FORMATTER0_SIZE_0		0x01a0
+#define DECON_FORMATTER0_SIZE_1		0x01a4
+#define DECON_FORMATTER1_SIZE_0		0x01b0
+#define DECON_FORMATTER1_SIZE_1		0x01b4
+#define DECON_FORMATTER_HEIGHT_F(_v)	((_v) << 16)
+#define DECON_FORMATTER_WIDTH_F(_v)	((_v) << 0)
+
+#define DECON_BLENDER_BG_IMAGE_SIZE_0	0x0200
+#define DECON_BLENDER_BG_IMAGE_SIZE_1	0x0204
+#define DECON_BLENDER_BG_HEIGHT_F(_v)	((_v) << 16)
+#define DECON_BLENDER_BG_WIDTH_F(_v)	((_v) << 0)
+
+#define DECON_DATA_PATH_CONTROL_0	0x0214
+#define DECON_WIN_MAPCOLOR_EN_F(_w)	(1 << (4 * (_w) + 1))
+#define DECON_WIN_EN_F(_w)		(1 << (4 * (_w) + 0))
+
+#define DECON_DATA_PATH_CONTROL_1	0x0218
+#define DECON_WIN_CHMAP_F(_w, _c)	(((_c) & 0x7) << (4 * (_w)))
+#define DECON_WIN_CHMAP_MASK(_w)	(0x7 << (4 * (_w)))
+
+#define DECON_DATA_PATH_CONTROL_2	0x0230
+#define DECON_ENHANCE_LOGIC_PATH_F(_v)	((_v) << 12)
+#define DECON_ENHANCE_LOGIC_PATH_MASK	(0x7 << 12)
+#define DECON_COMP_LINKIF_WB_PATH_F(_v)	((_v) << 0)
+#define DECON_COMP_LINKIF_WB_PATH_MASK	(0x1ff << 0)
+
+/* data path[8:0]: DSCC_EN[7] DSC_ENC1[5] DSC_ENC0[4] DSIM_IF0[0] */
+#define DECON_DPATH_DSCC_DSCENC01_FF01_FORMATTER0_DSIMIF0	0x0b1
+
+#define DECON_WIN_CONTROL_0(_w)		(0x1000 + ((_w) * 0x30))
+#define DECON_WIN_ALPHA1_F(_v)		(((_v) & 0xff) << 24)
+#define DECON_WIN_ALPHA0_F(_v)		(((_v) & 0xff) << 16)
+#define DECON_WIN_FUNC_F(_v)		(((_v) & 0xf) << 8)
+#define DECON_WIN_FUNC_MASK		(0xf << 8)
+#define DECON_WIN_PD_FUNC_COPY		0x1
+
+#define DECON_WIN_START_POSITION(_w)	(0x1008 + ((_w) * 0x30))
+#define DECON_WIN_STRPTR_Y_F(_v)	(((_v) & 0x3fff) << 16)
+#define DECON_WIN_STRPTR_X_F(_v)	(((_v) & 0x3fff) << 0)
+
+#define DECON_WIN_END_POSITION(_w)	(0x100c + ((_w) * 0x30))
+#define DECON_WIN_ENDPTR_Y_F(_v)	(((_v) & 0x3fff) << 16)
+#define DECON_WIN_ENDPTR_X_F(_v)	(((_v) & 0x3fff) << 0)
+
+#define DECON_WIN_PIXEL_COUNT(_w)	(0x101c + ((_w) * 0x30))
+
+/* DSC encoder at DECON + 0x4000 / + 0x5000 */
+#define DECON_DSC0_OFFSET		0x4000
+#define DECON_DSC1_OFFSET		0x5000
+
+#define DSC_CONTROL0			0x0000
+#define DSC_DCG_EN_ALL_F		(0xf << 16)
+#define DSC_BYTE_SWAP_F			BIT(9)
+#define DSC_FLATNESS_DET_TH_F(_v)	((_v) << 4)
+#define DSC_CG_EN_F			BIT(1)
+#define DSC_DUAL_SLICE_EN_F		BIT(0)
+
+#define DSC_CONTROL1			0x0004
+#define DSC_V_FRONT_F(_v)		((_v) << 16)
+#define DSC_V_SYNC_F(_v)		((_v) << 8)
+#define DSC_V_BACK_F(_v)		((_v) << 0)
+
+#define DSC_CONTROL2			0x0008
+#define DSC_H_FRONT_F(_v)		((_v) << 16)
+#define DSC_H_SYNC_F(_v)		((_v) << 8)
+#define DSC_H_BACK_F(_v)		((_v) << 0)
+
+#define DSC_PPS04_07			0x0024
+#define DSC_PPS08_11			0x0028
+#define DSC_PPS12_15			0x002c
+#define DSC_PPS16_19			0x0030
+#define DSC_PPS20_23			0x0034
+#define DSC_PPS24_27			0x0038
+#define DSC_PPS28_31			0x003c
+#define DSC_PPS32_35			0x0040
+#define DSC_PPS56_59			0x0058
+#define DSC_PPS76_79			0x006c
+#define DSC_PPS80_83			0x0070
+#define DSC_PPS84_87			0x0074
+
+/*
+ * IDMA_G0 DMA bank at 0x128B1000 (the 0x12851000 range is the
+ * DPP/scaler view; all IDMA fetch SFRs live on the DMA bank).
+ */
+#define IDMA_ENABLE			0x0000
+#define IDMA_SRSET			BIT(24)
+#define IDMA_ENABLE_OP_STATUS		BIT(2)
+#define IDMA_SFR_CLOCK_GATE_EN		BIT(10)
+#define IDMA_SRAM_CLOCK_GATE_EN		BIT(9)
+#define IDMA_FRAME_START_FORCE		BIT(5)
+#define IDMA_SFR_UPDATE_FORCE		BIT(4)
+#define IDMA_OP_STATUS			BIT(2)
+
+#define IDMA_IRQ			0x0004
+#define IDMA_ALL_IRQ_CLEAR		(0xfb << 16)
+#define IDMA_ALL_IRQ_MASK		(0xfb << 1)
+#define IDMA_IRQ_ENABLE			BIT(0)
+
+#define IDMA_IN_CON			0x0008
+#define IDMA_IMG_FORMAT_F(_v)		((_v) << 11)
+#define IDMA_IMG_FORMAT_MASK		(0x1f << 11)
+#define IDMA_IMG_FORMAT_ARGB8888	0
+#define IDMA_IMG_FORMAT_ABGR8888	1
+#define IDMA_IMG_FORMAT_RGBA8888	2
+#define IDMA_IMG_FORMAT_BGRA8888	3
+#define IDMA_IMG_FORMAT_XRGB8888	4
+#define IDMA_IMG_FORMAT_RGB565		8
+
+#define IDMA_OUT_CON			0x000c
+#define IDMA_OUT_FRAME_ALPHA_F(_v)	((_v) << 24)
+#define IDMA_OUT_FRAME_ALPHA_MASK	(0xff << 24)
+
+#define IDMA_SRC_SIZE			0x0010
+#define IDMA_SRC_HEIGHT_F(_v)		((_v) << 16)
+#define IDMA_SRC_WIDTH_F(_v)		((_v) << 0)
+
+#define IDMA_SRC_OFFSET			0x0014
+#define IDMA_SRC_OFFSET_Y_F(_v)		((_v) << 16)
+#define IDMA_SRC_OFFSET_X_F(_v)		((_v) << 0)
+
+#define IDMA_IMG_SIZE			0x0018
+#define IDMA_IMG_HEIGHT_F(_v)		((_v) << 16)
+#define IDMA_IMG_WIDTH_F(_v)		((_v) << 0)
+
+#define IDMA_IN_BASE_ADDR_Y		0x0040
+
+/*
+ * DPU_DMA common registers at 0x128B0000.
+ */
+#define DPU_DMA_CH_MAP			0x0004
+#define DPU_DMA_GLB_CGEN		0x0014
+#define DPU_DMA_ALL_CGEN_MASK		0x10fff
+
+/*
+ * DPU0 CMU clock gates (raw gate pattern, same style as the DSIM driver).
+ */
+#define DPU0_CMU_AD_APB_DECON0_0_GATE	0x2014
+#define DPU0_CMU_AD_APB_DECON0_1_GATE	0x2018
+#define DPU0_CMU_AXI2APB_P0_GATE	0x2054
+#define DPU0_CMU_AXI2APB_P1_GATE	0x2058
+#define DPU0_CMU_DECON0_ACLK_GATE	0x207c
+#define DPU0_CMU_DPP_G0_ACLK_GATE	0x2080
+#define DPU0_CMU_DPU_DMA_ACLK_CH0_GATE	0x208c
+#define DPU0_CMU_DPU_DMA_CH_INTF_GATE	0x2098
+#define DPU0_CMU_DPU_DMA_ACLK_SFR_GATE	0x209c
+#define DPU0_CMU_QCH_CON_DECON0		0x3014
+#define DPU0_CMU_QCH_CON_DPP_G0		0x3018
+#define DPU0_CMU_QCH_CON_DPU_DMA	0x3028
+#define DPU0_CMU_GATE_ON		(0x3 << 20)
+
+/*
+ * DISP_SS sysreg.
+ */
+#define DISP_SS_DLMUX_CFG		0x04
+#define DISP_SS_DLMUX_DISPIF0_DSIM0	((1 << 16) | 0x40 | 0x1)
+#define DISP_SS_DPU_TE_SEL		0x0c
+#define DISP_SS_TE_FROM_GPIO		0x7
+
+#endif /* _REGS_EXYNOS8895_DECON_H */
