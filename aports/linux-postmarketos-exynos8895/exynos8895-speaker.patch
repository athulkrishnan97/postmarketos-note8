From 9cea2cd62eb4d2bbea77dce4aee84ffd4e0ad45b Mon Sep 17 00:00:00 2001
From: Athul <athulkrishnan97@users.noreply.github.com>
Date: Fri, 9 Oct 2026 18:57:58 +0100
Subject: [PATCH 4/4] arm64: dts: exynos8895-greatlte: speaker amplifier

The MAX98506 sits on hsi2c_11 and plays from ABOX UAIF4, whose pins are
gph3-0..3 ("aud-cdma-bus" downstream); they need muxing too.
---
 .../boot/dts/exynos/exynos8895-greatlte.dts    | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-greatlte.dts b/arch/arm64/boot/dts/exynos/exynos8895-greatlte.dts
index f9ff4fb9b..6ff3c0054 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-greatlte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-greatlte.dts
@@ -566,7 +566,8 @@ abox: audio-controller@13e50000 {
 		memory-region = <&abox_mem>;
 		samsung,pmu-syscon = <&pmu_system_controller>;
 		pinctrl-names = "default";
-		pinctrl-0 = <&aud_codec_mclk &aud_codec_bus &aud_spk_bus>;
+		pinctrl-0 = <&aud_codec_mclk &aud_codec_bus &aud_spk_bus
+			     &aud_amp_bus>;
 		#sound-dai-cells = <1>;
 	};
 };
@@ -589,6 +590,13 @@ aud_spk_bus: aud-spk-bus-pins {
 		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
 		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
 	};
+
+	/* UAIF4 to the MAX98506 speaker amplifier ("aud-cdma-bus" downstream) */
+	aud_amp_bus: aud-amp-bus-pins {
+		samsung,pins = "gph3-0", "gph3-1", "gph3-2", "gph3-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
 };
 
 / {
@@ -597,6 +605,8 @@ sound {
 		model = "Galaxy Note8";
 		samsung,cpu-dai = <&abox 0>;
 		samsung,codec-dai = <&cs47l93 0>;
+		samsung,speaker-cpu-dai = <&abox 4>;
+		samsung,speaker-codec-dai = <&speaker_amp>;
 		clocks = <&pmu_system_controller 0>;
 		clock-names = "mclk";
 		/* CLKOUT0 source 1 is the 26 MHz TCXO (downstream OSCCLK_AUD) */
@@ -621,4 +631,10 @@ &hsi2c_11 {
 	#address-cells = <1>;
 	#size-cells = <0>;
 	status = "okay";
+
+	speaker_amp: amplifier@31 {
+		compatible = "maxim,max98506";
+		reg = <0x31>;
+		#sound-dai-cells = <0>;
+	};
 };
-- 
2.53.0

