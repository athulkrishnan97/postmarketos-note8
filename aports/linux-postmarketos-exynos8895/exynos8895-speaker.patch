From bd429ff5a592f8f12677e35b4b3e617b378344c9 Mon Sep 17 00:00:00 2001
From: Athul <athulkrishnan97@users.noreply.github.com>
Date: Fri, 9 Oct 2026 18:57:58 +0100
Subject: [PATCH 1/4] ASoC: samsung: abox: speaker path on UAIF4, fix the DMA
 position

Play UAIF4 (the speaker amplifier) from its own RDMA1 straight to SIFS1,
with ABOX driving that bus's bit clock from AUDIF. Both RDMAs share the
playback IPC id, so match firmware messages on the channel too.

The count field of the DMA status is in 16-byte units like the offset,
not bytes as downstream has it: the position crawled at 1/16 speed and
jumped a period at a time, and PulseAudio underran for seconds at the
start of every stream.
---
 sound/soc/samsung/abox/abox.c     |  25 +++++++
 sound/soc/samsung/abox/abox.h     |   2 +
 sound/soc/samsung/abox/abox_pcm.c | 107 +++++++++++++++++++++++++-----
 3 files changed, 118 insertions(+), 16 deletions(-)

diff --git a/sound/soc/samsung/abox/abox.c b/sound/soc/samsung/abox/abox.c
index 4af658ce0..0533640af 100644
--- a/sound/soc/samsung/abox/abox.c
+++ b/sound/soc/samsung/abox/abox.c
@@ -14,6 +14,7 @@
  */
 
 #include <linux/arm-smccc.h>
+#include <linux/bitfield.h>
 #include <linux/delay.h>
 #include <linux/firmware.h>
 #include <linux/interrupt.h>
@@ -47,6 +48,10 @@
 
 /* CMU_ABOX (no common clock driver yet) */
 #define CMU_MUX_CLK_ABOX_UAIF(x)	(0x1004 + (x) * 4)
+#define CMU_DIV_CLK_ABOX_AUDIF		0x1800	/* PLL_AUD / (n + 1) */
+#define CMU_DIV_AUDIF_RATIO		GENMASK(9, 0)
+#define CMU_DIV_CLK_ABOX_UAIF(x)	(0x1828 + (x) * 4)	/* AUDIF / (n + 1) */
+#define CMU_DIV_UAIF_RATIO		GENMASK(4, 0)
 #define CMU_GATE_MANUAL_ON		(BIT(21) | BIT(20))
 #define CMU_DIV_CLK_ABOX_PLL		0x1820	/* A7 clock: PLL_AUD / (n + 1) */
 #define AUD_PLL_RATE_HZ			1179648000UL
@@ -136,6 +141,26 @@ void abox_uaif_clk_enable(struct abox_data *data, unsigned int id,
 }
 EXPORT_SYMBOL_GPL(abox_uaif_clk_enable);
 
+/* Bit clock of a UAIF that drives its own clocks, divided from AUDIF. */
+int abox_uaif_set_bclk(struct abox_data *data, unsigned int id,
+		       unsigned long rate)
+{
+	u32 audif_div = FIELD_GET(CMU_DIV_AUDIF_RATIO,
+				  readl(data->cmu + CMU_DIV_CLK_ABOX_AUDIF));
+	unsigned long audif = AUD_PLL_RATE_HZ / (audif_div + 1);
+	unsigned long div = rate ? audif / rate : 0;
+
+	if (!div || div > FIELD_MAX(CMU_DIV_UAIF_RATIO) + 1 ||
+	    audif % rate) {
+		dev_err(data->dev, "UAIF%u: no %lu Hz bit clock from %lu Hz\n",
+			id, rate, audif);
+		return -EINVAL;
+	}
+	writel(div - 1, data->cmu + CMU_DIV_CLK_ABOX_UAIF(id));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(abox_uaif_set_bclk);
+
 static void abox_cpu_power(struct abox_data *data, bool on)
 {
 	regmap_update_bits(data->pmu, PMU_ABOX_CA7_CONFIGURATION,
diff --git a/sound/soc/samsung/abox/abox.h b/sound/soc/samsung/abox/abox.h
index e9867ba95..3cc33d061 100644
--- a/sound/soc/samsung/abox/abox.h
+++ b/sound/soc/samsung/abox/abox.h
@@ -118,5 +118,7 @@ void *abox_iova_to_virt(struct abox_data *data, u32 iova);
 int abox_pcm_register(struct abox_data *data);
 void abox_uaif_clk_enable(struct abox_data *data, unsigned int id,
 			  bool external_bclk);
+int abox_uaif_set_bclk(struct abox_data *data, unsigned int id,
+		       unsigned long rate);
 
 #endif /* __SND_SOC_SAMSUNG_ABOX_H */
diff --git a/sound/soc/samsung/abox/abox_pcm.c b/sound/soc/samsung/abox/abox_pcm.c
index 849dee3ce..86c5ad9c3 100644
--- a/sound/soc/samsung/abox/abox_pcm.c
+++ b/sound/soc/samsung/abox/abox_pcm.c
@@ -2,8 +2,9 @@
 /*
  * Samsung Exynos8895 ABOX: PCM streams and UAIF DAIs
  *
- * Playback goes through RDMA0 and the SPUS mixer (SIFS0) to a UAIF;
- * capture comes from a UAIF through NSRC0 and the SPUM into WDMA0. The
+ * Playback goes through RDMA0 and the SPUS mixer (SIFS0) to a UAIF, except
+ * on the speaker amplifier's UAIF4, which gets its own RDMA1 straight to
+ * SIFS1; capture comes from a UAIF through NSRC0 and the SPUM into WDMA1. The
  * firmware runs both DMAs: Linux hands it the buffer and the stream
  * parameters over IPC, and reads the position back from the DMA status.
  *
@@ -32,7 +33,12 @@
 /* SPUS_CTRL0: a 4-bit function chain per RDMA */
 #define SPUS_CHAIN_SHIFT(x)	((x) * 4)
 #define SPUS_CHAIN_ASRC		BIT(0)
+#define SPUS_CHAIN_OUT_SIFS1	(0 << 1)
 #define SPUS_CHAIN_OUT_SIFS0	(1 << 1)
+/* SPUS_CTRL1: which RDMA chain feeds SIFS1 */
+#define SPUS_SIFS1_SEL		GENMASK(18, 16)
+/* SPUS_CTRL3 */
+#define SPUS_SIFS1_FLUSH	BIT(0)
 
 /* SPUM_CTRL0: a 4-bit function chain per NSRC, from bit 4 */
 #define SPUM_CHAIN_SHIFT(x)	(4 + (x) * 4)
@@ -40,6 +46,7 @@
 /* ROUTE_CTRL0: UAIFx speaker source; ROUTE_CTRL1: NSRCx source */
 #define ROUTE_UAIF_SPK_SHIFT(x)	((x) * 4)
 #define ROUTE_UAIF_SPK_SIFS0	1
+#define ROUTE_UAIF_SPK_SIFS1	2
 #define ROUTE_NSRC_SHIFT(x)	((x) * 4)
 #define ROUTE_NSRC_UAIF(x)	(8 + (x))
 
@@ -60,7 +67,7 @@
 /* RDMA/WDMA status */
 #define DMA_STATUS_PROGRESS	BIT(31)
 #define DMA_STATUS_RBUF_OFFSET	GENMASK(28, 16)	/* in 16-byte units */
-#define DMA_STATUS_RBUF_CNT	GENMASK(12, 0)
+#define DMA_STATUS_RBUF_CNT	GENMASK(12, 0)	/* in 16-byte units too */
 
 /*
  * The mixer is set to the stream rate, so the rate converter isn't needed;
@@ -74,6 +81,17 @@ MODULE_PARM_DESC(asrc, "Route RDMA0 through ASRC0");
 #define CAP_NSRC		0
 #define CAP_WDMA		1
 
+/* The speaker amplifier's UAIF, played through RDMA1 and SIFS1 */
+#define SPK_UAIF		4
+#define SPK_RDMA		1
+
+enum {
+	ABOX_DMA_PLAYBACK,
+	ABOX_DMA_CAPTURE,
+	ABOX_DMA_SPEAKER,
+	ABOX_DMA_NUM,
+};
+
 struct abox_dma {
 	struct snd_pcm_substream *substream;
 	u32 id;			/* firmware channel id */
@@ -88,7 +106,7 @@ struct abox_dma {
 struct abox_pcm {
 	struct abox_data *abox;
 	unsigned long uaif_consumer;	/* bit per UAIF: BCLK comes from the pin */
-	struct abox_dma dma[2];		/* indexed by stream direction */
+	struct abox_dma dma[ABOX_DMA_NUM];
 };
 
 static const struct snd_pcm_hardware abox_pcm_hardware = {
@@ -125,7 +143,14 @@ static struct abox_pcm *dai_to_abox_pcm(struct snd_soc_dai *dai)
 static struct abox_dma *to_dma(struct snd_soc_component *component,
 			       struct snd_pcm_substream *substream)
 {
-	return &to_abox_pcm(component)->dma[substream->stream];
+	struct abox_pcm *pcm = to_abox_pcm(component);
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		return &pcm->dma[ABOX_DMA_CAPTURE];
+	if (snd_soc_rtd_to_cpu(rtd, 0)->id == SPK_UAIF)
+		return &pcm->dma[ABOX_DMA_SPEAKER];
+	return &pcm->dma[ABOX_DMA_PLAYBACK];
 }
 
 static int abox_dma_ipc(struct abox_pcm *pcm, struct abox_dma *dma, u32 type,
@@ -169,8 +194,10 @@ static void abox_pcm_irq(void *priv, unsigned int id,
 	struct snd_pcm_substream *substream;
 	int i;
 
+	/* Both RDMAs share the playback IPC id; the channel tells them apart. */
 	for (i = 0; i < ARRAY_SIZE(pcm->dma); i++) {
-		if (msg ? msg->ipcid == pcm->dma[i].ipcid :
+		if (msg ? msg->ipcid == pcm->dma[i].ipcid &&
+			  msg->msg.pcmtask.channel_id == pcm->dma[i].id :
 			  id == pcm->dma[i].irq)
 			dma = &pcm->dma[i];
 	}
@@ -178,8 +205,7 @@ static void abox_pcm_irq(void *priv, unsigned int id,
 		return;
 
 	if (msg) {
-		if (msg->msg.pcmtask.msgtype != PCM_PLTDAI_POINTER ||
-		    msg->msg.pcmtask.channel_id != dma->id)
+		if (msg->msg.pcmtask.msgtype != PCM_PLTDAI_POINTER)
 			return;
 		WRITE_ONCE(dma->pointer, msg->msg.pcmtask.param.pointer);
 	}
@@ -344,7 +370,13 @@ static snd_pcm_uframes_t abox_pcm_pointer(struct snd_soc_component *component,
 			if ((buffer_bytes & offset) == offset)
 				offset = buffer_bytes;
 		}
-		pos = offset + FIELD_GET(DMA_STATUS_RBUF_CNT, status);
+		/*
+		 * Downstream adds the count as bytes; measured against the
+		 * stream rate it counts 16-byte units like the offset.
+		 * Otherwise the position crawls and then jumps by a period,
+		 * and PulseAudio's timer scheduling underruns.
+		 */
+		pos = offset + (FIELD_GET(DMA_STATUS_RBUF_CNT, status) << 4);
 	}
 
 	if (pos < 0 || pos >= runtime->dma_bytes)
@@ -425,10 +457,36 @@ static int abox_uaif_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
 	return 0;
 }
 
+static void abox_route_speaker(struct abox_data *abox)
+{
+	u32 val;
+
+	/* RDMA1 -> SIFS1 -> UAIF4, no mixing: the amplifier paces it */
+	val = readl(abox->sfr + ABOX_SPUS_CTRL0);
+	val &= ~(0xf << SPUS_CHAIN_SHIFT(SPK_RDMA));
+	val |= SPUS_CHAIN_OUT_SIFS1 << SPUS_CHAIN_SHIFT(SPK_RDMA);
+	writel(val, abox->sfr + ABOX_SPUS_CTRL0);
+
+	val = readl(abox->sfr + ABOX_SPUS_CTRL1);
+	val &= ~SPUS_SIFS1_SEL;
+	val |= FIELD_PREP(SPUS_SIFS1_SEL, SPK_RDMA);
+	writel(val, abox->sfr + ABOX_SPUS_CTRL1);
+
+	val = readl(abox->sfr + ABOX_ROUTE_CTRL0);
+	val &= ~(0xf << ROUTE_UAIF_SPK_SHIFT(SPK_UAIF));
+	val |= ROUTE_UAIF_SPK_SIFS1 << ROUTE_UAIF_SPK_SHIFT(SPK_UAIF);
+	writel(val, abox->sfr + ABOX_ROUTE_CTRL0);
+
+	writel(SPUS_SIFS1_FLUSH, abox->sfr + ABOX_SPUS_CTRL3);
+}
+
 static void abox_route_playback(struct abox_data *abox, unsigned int uaif)
 {
 	u32 val;
 
+	if (uaif == SPK_UAIF)
+		return abox_route_speaker(abox);
+
 	/* RDMA0 -> (ASRC0) -> mixer (SIFS0) -> this UAIF */
 	val = readl(abox->sfr + ABOX_SPUS_CTRL0);
 	val &= ~(0xf << SPUS_CHAIN_SHIFT(0));
@@ -509,17 +567,26 @@ static int abox_uaif_hw_params(struct snd_pcm_substream *substream,
 			 FIELD_PREP(UAIF_VALID_END, width - 1);
 	writel(ctrl1, abox->sfr + ABOX_UAIF_CTRL1(dai->id));
 
+	if (!test_bit(dai->id, &pcm->uaif_consumer)) {
+		ret = abox_uaif_set_bclk(abox, dai->id,
+					 params_rate(params) * channels * width);
+		if (ret)
+			return ret;
+	}
 	abox_uaif_clk_enable(abox, dai->id,
 			     test_bit(dai->id, &pcm->uaif_consumer));
 
 	if (playback) {
+		/* SIFS0 is the mixer, SIFS1 the speaker's direct output */
+		u32 rate_msg = dai->id == SPK_UAIF ? SET_OUT1_SAMPLE_RATE :
+						      SET_MIXER_SAMPLE_RATE;
+		u32 fmt_msg = dai->id == SPK_UAIF ? SET_OUT1_FORMAT :
+						     SET_MIXER_FORMAT;
+
 		abox_route_playback(abox, dai->id);
-		/* The mixer runs at the UAIF rate. */
-		ret = abox_config_ipc(abox, SET_MIXER_SAMPLE_RATE,
-				      params_rate(params), 0);
+		ret = abox_config_ipc(abox, rate_msg, params_rate(params), 0);
 		if (!ret)
-			ret = abox_config_ipc(abox, SET_MIXER_FORMAT, width,
-					      channels);
+			ret = abox_config_ipc(abox, fmt_msg, width, channels);
 	} else {
 		abox_route_capture(abox, dai->id);
 		ret = abox_config_ipc(abox, SET_INMUX0_SAMPLE_RATE + CAP_NSRC,
@@ -626,14 +693,22 @@ int abox_pcm_register(struct abox_data *abox)
 		return -ENOMEM;
 	pcm->abox = abox;
 
-	pcm->dma[SNDRV_PCM_STREAM_PLAYBACK] = (struct abox_dma) {
+	pcm->dma[ABOX_DMA_PLAYBACK] = (struct abox_dma) {
 		.iova = 0x81000000,		/* RDMA0 buffer */
 		.status = ABOX_RDMA_STATUS(0),
 		.ctrl = ABOX_RDMA_CTRL0(0),
 		.ipcid = IPC_PCMPLAYBACK,
 		.irq = RDMA0_BUF_EMPTY,
 	};
-	pcm->dma[SNDRV_PCM_STREAM_CAPTURE] = (struct abox_dma) {
+	pcm->dma[ABOX_DMA_SPEAKER] = (struct abox_dma) {
+		.id = SPK_RDMA,
+		.iova = 0x81000000 + SPK_RDMA * SZ_1M,	/* RDMA1 buffer */
+		.status = ABOX_RDMA_STATUS(SPK_RDMA),
+		.ctrl = ABOX_RDMA_CTRL0(SPK_RDMA),
+		.ipcid = IPC_PCMPLAYBACK,
+		.irq = RDMA0_BUF_EMPTY + SPK_RDMA,
+	};
+	pcm->dma[ABOX_DMA_CAPTURE] = (struct abox_dma) {
 		.id = CAP_WDMA,
 		.iova = 0x82000000 + CAP_WDMA * SZ_1M,	/* WDMAx buffer */
 		.status = ABOX_WDMA_STATUS(CAP_WDMA),
