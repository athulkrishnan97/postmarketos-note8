From 6c938ac8b27098174db002799466bcbae6f83a95 Mon Sep 17 00:00:00 2001
From: Athul <athulkrishnan97@users.noreply.github.com>
Date: Thu, 8 Oct 2026 20:29:44 +0100
Subject: [PATCH 5/5] arm64: dts: exynos8895-greatlte: audio

CS47L93 codec on SPI3 (LDO32/LDO33, AIF pins, mono earpiece output),
ABOX with its SysMMU and firmware carve-out, the PMU clock output as the
codec's MCLK1, the sound card and the speaker amplifier's I2C bus.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/exynos/exynos8895-greatlte.dts   | 181 ++++++++++++++++++
 1 file changed, 181 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-greatlte.dts b/arch/arm64/boot/dts/exynos/exynos8895-greatlte.dts
index 6a3bb50cb..f9ff4fb9b 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-greatlte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-greatlte.dts
@@ -110,6 +110,14 @@ gnss-if@ffc00000 {
 			no-map;
 		};
 
+		/* ABOX: Calliope firmware DRAM, PCM buffers, IVA firmware */
+		abox_mem: abox-memory {
+			size = <0x3100000>;
+			alignment = <0 0x100000>;
+			alloc-ranges = <0 0xc0000000 0x10000000>;
+			no-map;
+		};
+
 		ramoops@92000000 {
 			compatible = "ramoops";
 			reg = <0 0x92000000 0x8000>;
@@ -441,3 +449,176 @@ charger: charger@69 {
 		reg = <0x69>;
 	};
 };
+
+/* CS47L93 audio codec (Cirrus Madera) on SPI3, powered from PMIC
+ * LDO32 (1.8 V, left on by the bootloader) and LDO33 (1.2 V DCVDD). */
+&s2mps17_pmic {
+	regulators {
+		codec_vdd_1p8: LDO32 {
+			regulator-name = "vdd_1p8_codec";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+			regulator-boot-on;
+		};
+
+		codec_vdd_1p2: LDO33 {
+			regulator-name = "vdd_1p2_codec";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-enable-ramp-delay = <5000>;
+		};
+	};
+};
+
+&pinctrl_alive {
+	codec_irq: codec-irq-pins {
+		samsung,pins = "gpa2-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&usi1 {
+	samsung,mode = <USI_MODE_SPI>;
+	status = "okay";
+};
+
+&spi_3 {
+	pinctrl-0 = <&spi3_bus &spi3_cs>;
+	cs-gpios = <&gpd1 6 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	cs47l93: codec@0 {
+		compatible = "cirrus,cs47l93";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+
+		interrupt-parent = <&gpa2>;
+		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		#sound-dai-cells = <1>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cs47l93_defaults>;
+
+		reset-gpios = <&gpe7 0 GPIO_ACTIVE_LOW>;
+
+
+		AVDD-supply = <&codec_vdd_1p8>;
+		DBVDD1-supply = <&codec_vdd_1p8>;
+		CPVDD1-supply = <&codec_vdd_1p8>;
+		CPVDD2-supply = <&codec_vdd_1p2>;
+		DCVDD-supply = <&codec_vdd_1p2>;
+
+		/* OUT3 (earpiece, differential) and OUT4 are mono, as on stock */
+		cirrus,out-mono = <0 0 1 1 0 0>;
+
+		/* AIF pins come up as GPIOs; hand them to the audio interfaces */
+		cs47l93_defaults: pin-settings {
+			aif1-pins {
+				groups = "aif1";
+				function = "aif1";
+				bias-bus-hold;
+			};
+
+			aif2-pins {
+				groups = "aif2";
+				function = "aif2";
+				bias-bus-hold;
+			};
+
+			aif3-pins {
+				groups = "aif3";
+				function = "aif3";
+				bias-bus-hold;
+			};
+		};
+
+		controller-data {
+			samsung,spi-feedback-delay = <1>;
+		};
+	};
+};
+
+&soc {
+	sysmmu_abox: iommu@13e30000 {
+		compatible = "samsung,exynos-sysmmu";
+		reg = <0x13e30000 0x1000>;
+		interrupts = <GIC_SPI 445 IRQ_TYPE_LEVEL_HIGH>;
+		/* Real gate (GATE_SMMU_ABOX) is in CMU_ABOX, not modelled yet. */
+		clocks = <&oscclk>;
+		clock-names = "sysmmu";
+		#iommu-cells = <0>;
+	};
+
+	abox: audio-controller@13e50000 {
+		compatible = "samsung,exynos8895-abox";
+		reg = <0x13e50000 0x10000>, <0x13e20000 0x10000>,
+		      <0x13f00000 0x31000>, <0x13ef1000 0x1000>,
+		      <0x13ef2000 0x1004>, <0x13e00000 0x4000>;
+		reg-names = "sfr", "sysreg", "sram", "gicd", "gicc", "cmu";
+		interrupts = <GIC_SPI 442 IRQ_TYPE_LEVEL_HIGH>;
+		iommus = <&sysmmu_abox>;
+		memory-region = <&abox_mem>;
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&aud_codec_mclk &aud_codec_bus &aud_spk_bus>;
+		#sound-dai-cells = <1>;
+	};
+};
+
+&pinctrl_abox {
+	aud_codec_mclk: aud-codec-mclk-pins {
+		samsung,pins = "gph0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	aud_codec_bus: aud-codec-bus-pins {
+		samsung,pins = "gph0-1", "gph0-2", "gph0-3", "gph0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	aud_spk_bus: aud-spk-bus-pins {
+		samsung,pins = "gph0-5", "gph0-6", "gph0-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+};
+
+/ {
+	sound {
+		compatible = "samsung,exynos8895-madera";
+		model = "Galaxy Note8";
+		samsung,cpu-dai = <&abox 0>;
+		samsung,codec-dai = <&cs47l93 0>;
+		clocks = <&pmu_system_controller 0>;
+		clock-names = "mclk";
+		/* CLKOUT0 source 1 is the 26 MHz TCXO (downstream OSCCLK_AUD) */
+		assigned-clocks = <&pmu_system_controller 0>;
+		assigned-clock-parents = <&oscclk>;
+	};
+};
+
+&pmu_system_controller {
+	#clock-cells = <1>;
+	clocks = <&oscclk>;
+	clock-names = "clkout1";
+};
+
+/* Speaker amplifier (MAX98506 at 0x31) bus */
+&usi3 {
+	samsung,mode = <USI_MODE_I2C>;
+	status = "okay";
+};
+
+&hsi2c_11 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+};
-- 
