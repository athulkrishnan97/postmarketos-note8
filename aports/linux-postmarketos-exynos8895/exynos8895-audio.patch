From 639e324f598ccc1d6c7f9c32a694a44b1e0c5a87 Mon Sep 17 00:00:00 2001
From: Athul <athulkrishnan97@users.noreply.github.com>
Date: Thu, 8 Oct 2026 13:45:20 +0100
Subject: [PATCH 1/5] regulator: s2mps11: add S2MPS17 LDO32/LDO33 (audio codec
 supplies)

LDO32 (1.8 V) and LDO33 (1.2 V) feed the CS47L93 codec on the
Galaxy Note 8. The bootloader leaves LDO33 off, so the codec cannot
be powered without it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/regulator/s2mps11.c         | 13 +++++++++++--
 include/linux/mfd/samsung/s2mps17.h |  4 ++++
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/drivers/regulator/s2mps11.c b/drivers/regulator/s2mps11.c
index 52159cd67..0fdb8519c 100644
--- a/drivers/regulator/s2mps11.c
+++ b/drivers/regulator/s2mps11.c
@@ -1809,6 +1809,10 @@ static const struct linear_range s2mps17_buck_voltage_ranges[] = {
 	.enable_mask	= S2MPS17_ENABLE_MASK,				\
 }
 
+static const struct linear_range s2mps17_ldo33_ranges[] = {
+	REGULATOR_LINEAR_RANGE(700000, 0, 0xff, 12500),
+};
+
 static const struct linear_range s2mps17_ldo34_ranges[] = {
 	REGULATOR_LINEAR_RANGE(700000, 0, 0xff, 25000),
 };
@@ -1842,9 +1846,14 @@ static const struct regulator_desc s2mps17_regulators[] = {
 	 * B6CTRL - same offsets as the linear B1..B5/B7..B10 layout.
 	 */
 	regulator_desc_s2mps17_buck(6),
-	/* tsp_io / tsp_avdd: touch screen supplies, LDO34 @0x5F / LDO35
-	 * @0x60 (single ctrl reg: vsel[5:0], enable[7:6]).
+	/* Audio codec 1.8 V / 1.2 V (LDO32 @0x5D / LDO33 @0x5E) and touch
+	 * screen supplies (LDO34 @0x5F / LDO35 @0x60); single ctrl reg:
+	 * vsel[5:0], enable[7:6].
 	 */
+	S2MPS17_LDO_COMMON(S2MPS17_LDO32, "LDO32", S2MPS17_REG_L32CTRL,
+			   s2mps17_ldo34_ranges),
+	S2MPS17_LDO_COMMON(S2MPS17_LDO33, "LDO33", S2MPS17_REG_L33CTRL,
+			   s2mps17_ldo33_ranges),
 	S2MPS17_LDO_COMMON(S2MPS17_LDO34, "LDO34", S2MPS17_REG_L34CTRL,
 			   s2mps17_ldo34_ranges),
 	S2MPS17_LDO_COMMON(S2MPS17_LDO35, "LDO35", S2MPS17_REG_L35CTRL,
diff --git a/include/linux/mfd/samsung/s2mps17.h b/include/linux/mfd/samsung/s2mps17.h
index cee1e63f9..32fbba517 100644
--- a/include/linux/mfd/samsung/s2mps17.h
+++ b/include/linux/mfd/samsung/s2mps17.h
@@ -31,6 +31,8 @@
 
 #define S2MPS17_REG_B1CTRL		0x19
 #define S2MPS17_REG_B1OUT			0x1A
+#define S2MPS17_REG_L32CTRL		0x5D
+#define S2MPS17_REG_L33CTRL		0x5E
 #define S2MPS17_REG_L34CTRL		0x5F
 #define S2MPS17_REG_L35CTRL		0x60
 #define S2MPS17_REG_B2CTRL		0x1B
@@ -73,6 +75,8 @@ enum s2mps17_regulators {
 	S2MPS17_BUCK2,
 	S2MPS17_BUCK3,
 	S2MPS17_BUCK6,
+	S2MPS17_LDO32,
+	S2MPS17_LDO33,
 	S2MPS17_LDO34,
 	S2MPS17_LDO35,
 };
