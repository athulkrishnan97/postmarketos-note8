+ */
+
+#ifndef __SND_SOC_SAMSUNG_ABOX_H
+#define __SND_SOC_SAMSUNG_ABOX_H
+
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+
+struct abox_ipc_msg;
+
+/* System */
+#define ABOX_VERSION			0x0004
+#define ABOX_SYSPOWER_CTRL		0x0010
+#define ABOX_SYSPOWER_CTRL_ON		BIT(0)
+#define ABOX_SYSPOWER_STATUS		0x0014
+#define ABOX_ROUTE_CTRL0		0x0040
+#define ABOX_ROUTE_CTRL1		0x0044
+#define ABOX_ROUTE_CTRL2		0x0048
+
+/* SPUS: playback mixer */
+#define ABOX_SPUS_CTRL0			0x0200
+#define ABOX_SPUS_CTRL1			0x0204
+#define ABOX_SPUS_CTRL2			0x0208
+#define ABOX_SPUS_CTRL3			0x020c
+
+/* SPUM: capture paths */
+#define ABOX_SPUM_CTRL0			0x0300
+#define ABOX_SPUM_CTRL1			0x0304
+#define ABOX_SPUM_CTRL2			0x0308
+#define ABOX_SPUM_CTRL3			0x030c
+
+/* UAIF: I2S/TDM interfaces */
+#define ABOX_UAIF_CTRL0(x)		(0x0500 + (x) * 0x10)
+#define ABOX_UAIF_CTRL1(x)		(0x0504 + (x) * 0x10)
+#define ABOX_UAIF_STATUS(x)		(0x050c + (x) * 0x10)
+
+/* RDMA: playback DMAs, programmed by the firmware */
+#define ABOX_RDMA_CTRL0(x)		(0x1000 + (x) * 0x100)
+#define ABOX_RDMA_STATUS(x)		(0x1020 + (x) * 0x100)
+
+/* WDMA: capture DMAs, programmed by the firmware */
+#define ABOX_WDMA_CTRL(x)		(0x2000 + (x) * 0x100)
+#define ABOX_WDMA_STATUS(x)		(0x2020 + (x) * 0x100)
+
+/* A7 debug */
+#define ABOX_CA7_PC			0x2c3c
+
+enum abox_state {
+	ABOX_STATE_OFF,
+	ABOX_STATE_BOOTING,
+	ABOX_STATE_RUNNING,
+};
+
+struct abox_data {
+	struct device *dev;
+	void __iomem *sfr;
+	void __iomem *cmu;
+	void __iomem *sysreg;
+	void __iomem *sram;
+	size_t sram_size;
+	void __iomem *gicd;
+	void __iomem *gicc;
+	phys_addr_t gicd_phys;
+	phys_addr_t gicc_phys;
+	struct regmap *pmu;
+	bool secure_gic;
+
+	struct iommu_domain *domain;
+	phys_addr_t dram_phys;
+	size_t dram_size;
+	void *dram;
+	phys_addr_t iva_phys;
+	void *iva;
+	phys_addr_t scratch_phys;	/* fake chip id page + dummy page */
+	void *scratch;
+
+	/* Bring-up: back faulting firmware accesses with a dummy page */
+	struct work_struct fault_work;
+	unsigned long fault_iova[16];
+	unsigned int fault_count;
+	unsigned int fault_mapped;
+	spinlock_t fault_lock;
+
+	struct mutex boot_lock;
+	spinlock_t ipc_lock;
+	struct completion boot_done;
+	enum abox_state state;
+	u32 fw_version;
+
+	void *log;
+	struct delayed_work log_work;
+
+	struct {
+		u32 id;
+		u32 gear;
+	} gear_req[8];			/* A7 clock requests from the firmware */
+
+	/* PCM side: DMA interrupts and IPC replies other than system ones */
+	void *pcm;
+	void (*dma_irq)(void *priv, unsigned int id,
+			const struct abox_ipc_msg *msg);
+	void *dma_irq_priv;
+};
+
+int abox_boot(struct abox_data *data);
+int abox_ipc_send(struct abox_data *data, const struct abox_ipc_msg *msg,
+		  size_t size);
+void *abox_iova_to_virt(struct abox_data *data, u32 iova);
+int abox_pcm_register(struct abox_data *data);
+void abox_uaif_clk_enable(struct abox_data *data, unsigned int id,
+			  bool external_bclk);
+
+#endif /* __SND_SOC_SAMSUNG_ABOX_H */
diff --git a/sound/soc/samsung/abox/abox_ipc.h b/sound/soc/samsung/abox/abox_ipc.h
new file mode 100644
index 000000000..6fb62a983
--- /dev/null
+++ b/sound/soc/samsung/abox/abox_ipc.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * IPC message layout shared with the Calliope firmware running on the
+ * ABOX Cortex-A7 (Exynos8895). From the Samsung downstream driver
+ * (include/sound/samsung/abox_ipc.h).
+ *
+ * Copyright (c) 2016 Samsung Electronics Co. Ltd.
+ */
+
+#ifndef __SND_SOC_ABOX_IPC_H
+#define __SND_SOC_ABOX_IPC_H
+
+#include <linux/types.h>
+
+enum abox_ipc_id {
+	IPC_RECEIVED,
+	IPC_SYSTEM = 1,
+	IPC_PCMPLAYBACK,
+	IPC_PCMCAPTURE,
+	IPC_OFFLOAD,
+	IPC_ERAP,
+	WDMA0_BUF_FULL = 0x8,
+	WDMA1_BUF_FULL = 0x9,
+	IPC_ABOX_CONFIG = 0xa,
+	RDMA0_BUF_EMPTY = 0xb,
+	RDMA1_BUF_EMPTY = 0xc,
+	RDMA2_BUF_EMPTY = 0xd,
+	RDMA3_BUF_EMPTY = 0xe,
+	IPC_ASB_TEST = 0xf,
+};
+
+enum abox_pcm_msg {
+	PCM_OPEN = 1,
+	PCM_CLOSE = 2,
+	PCM_CPUDAI_TRIGGER = 3,
+	PCM_CPUDAI_HW_PARAMS = 4,
+	PCM_CPUDAI_SET_FMT = 5,
+	PCM_CPUDAI_SET_CLKDIV = 6,
+	PCM_CPUDAI_SET_SYSCLK = 7,
+	PCM_CPUDAI_STARTUP = 8,
+	PCM_CPUDAI_SHUTDOWN = 9,
+	PCM_CPUDAI_DELAY = 10,
+	PCM_PLTDAI_OPEN = 11,
+	PCM_PLTDAI_CLOSE = 12,
+	PCM_PLTDAI_IOCTL = 13,
+	PCM_PLTDAI_HW_PARAMS = 14,
+	PCM_PLTDAI_HW_FREE = 15,
+	PCM_PLTDAI_PREPARE = 16,
+	PCM_PLTDAI_TRIGGER = 17,
+	PCM_PLTDAI_POINTER = 18,
+	PCM_PLTDAI_MMAP = 19,
+	PCM_SET_BUFFER = 20,
+	PCM_SYNCHRONIZE = 21,
+};
+
+struct abox_ipc_pcmtask {
+	u32 msgtype;			/* enum abox_pcm_msg */
+	s32 channel_id;
+	union {
+		struct {
+			s32 sample_rate;
+			s32 bit_depth;
+			s32 channels;
+		} hw_params;
+		struct {
+			s32 phyaddr;		/* ABOX (IOVA) address */
+			s32 size;
+			s32 count;
+		} setbuff;
+		u32 pointer;
+		s32 trigger;
+		s32 synchronize;
+	} param;
+};
+
+enum abox_config_msg {
+	SET_MIXER_SAMPLE_RATE = 1,
+	SET_OUT1_SAMPLE_RATE,
+	SET_OUT2_SAMPLE_RATE,
+	SET_RECP_SAMPLE_RATE,
+	SET_INMUX0_SAMPLE_RATE,
+	SET_INMUX1_SAMPLE_RATE,
+	SET_INMUX2_SAMPLE_RATE,
+	SET_INMUX3_SAMPLE_RATE,
+	SET_INMUX4_SAMPLE_RATE,
+	SET_MIXER_FORMAT = 0x10,
+	SET_OUT1_FORMAT,
+	SET_OUT2_FORMAT,
+	SET_RECP_FORMAT,
+	SET_INMUX0_FORMAT,
+	SET_INMUX1_FORMAT,
+	SET_INMUX2_FORMAT,
+	SET_INMUX3_FORMAT,
+	SET_INMUX4_FORMAT,
+};
+
+struct abox_ipc_config {
+	u32 msgtype;			/* enum abox_config_msg */
+	s32 param1;
+	s32 param2;
+};
+
+enum abox_system_msg {
+	ABOX_SUSPEND = 1,
+	ABOX_RESUME,
+	ABOX_BOOT_DONE,
+	ABOX_CHANGE_GEAR,
+	ABOX_START_L2C_CONTROL,
+	ABOX_END_L2C_CONTROL,
+	ABOX_REQUEST_SYSCLK,
+	ABOX_REQUEST_L2C,
+	ABOX_CHANGED_GEAR,
+	ABOX_REPORT_LOG = 0x10,
+	ABOX_FLUSH_LOG,
+	ABOX_REPORT_DUMP = 0x20,
+	ABOX_REQUEST_DUMP,
+	ABOX_FLUSH_DUMP,
+	ABOX_REPORT_SRAM = 0x40,
+	ABOX_START_CLAIM_SRAM,
+	ABOX_END_CLAIM_SRAM,
+	ABOX_START_RECLAIM_SRAM,
+	ABOX_END_RECLAIM_SRAM,
+	ABOX_REPORT_DRAM,
+	ABOX_START_VSS = 0xa0,
+	ABOX_REPORT_COMPONENT = 0xc0,
+	ABOX_UPDATE_COMPONENT_CONTROL,
+	ABOX_REQUEST_COMPONENT_CONTROL,
+	ABOX_REPORT_COMPONENT_CONTROL,
+	ABOX_REQUEST_DEBUG = 0xde,
+	ABOX_REPORT_FAULT = 0xfa,
+};
+
+struct abox_ipc_system {
+	u32 msgtype;			/* enum abox_system_msg */
+	s32 param1;
+	s32 param2;
+	s32 param3;
+	union {
+		s32 param_s32[185];
+		char param_bundle[740];
+	} bundle;
+};
+
+struct abox_log_buffer {
+	u32 index_writer;
+	u32 index_reader;
+	u32 size;
+	char buffer[];
+};
+
+struct abox_ipc_msg {
+	u32 ipcid;			/* enum abox_ipc_id */
+	s32 task_id;
+	union {
+		struct abox_ipc_system system;
+		struct abox_ipc_pcmtask pcmtask;
+		struct abox_ipc_config config;
+	} msg;
+};
+
+#endif /* __SND_SOC_ABOX_IPC_H */
diff --git a/sound/soc/samsung/abox/abox_pcm.c b/sound/soc/samsung/abox/abox_pcm.c
new file mode 100644
index 000000000..849dee3ce
--- /dev/null
+++ b/sound/soc/samsung/abox/abox_pcm.c
@@ -0,0 +1,651 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Exynos8895 ABOX: PCM streams and UAIF DAIs
+ *
+ * Playback goes through RDMA0 and the SPUS mixer (SIFS0) to a UAIF;
+ * capture comes from a UAIF through NSRC0 and the SPUM into WDMA0. The
+ * firmware runs both DMAs: Linux hands it the buffer and the stream
+ * parameters over IPC, and reads the position back from the DMA status.
+ *
+ * Based on the Samsung downstream driver (abox_rdma.c, abox_wdma.c, abox.c),
+ * Copyright (c) 2016 Samsung Electronics Co. Ltd.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mm.h>
+#include <linux/platform_device.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "abox.h"
+#include "abox_ipc.h"
+
+#define IOVA_BASE		0x80000000
+/*
+ * The DMA status reports its position in a 13-bit field of 16-byte units,
+ * which can't describe a 128 KiB buffer: streams with one stall.
+ */
+#define BUFFER_BYTES_MAX	SZ_64K
+
+/* SPUS_CTRL0: a 4-bit function chain per RDMA */
+#define SPUS_CHAIN_SHIFT(x)	((x) * 4)
+#define SPUS_CHAIN_ASRC		BIT(0)
+#define SPUS_CHAIN_OUT_SIFS0	(1 << 1)
+
+/* SPUM_CTRL0: a 4-bit function chain per NSRC, from bit 4 */
+#define SPUM_CHAIN_SHIFT(x)	(4 + (x) * 4)
+
+/* ROUTE_CTRL0: UAIFx speaker source; ROUTE_CTRL1: NSRCx source */
+#define ROUTE_UAIF_SPK_SHIFT(x)	((x) * 4)
+#define ROUTE_UAIF_SPK_SIFS0	1
+#define ROUTE_NSRC_SHIFT(x)	((x) * 4)
+#define ROUTE_NSRC_UAIF(x)	(8 + (x))
+
+/* UAIF_CTRL0 */
+#define UAIF_SPK_ENABLE		BIT(0)
+#define UAIF_MIC_ENABLE		BIT(1)
+#define UAIF_MODE_PROVIDER	BIT(2)	/* drive BCLK and LRCLK */
+/* UAIF_CTRL1 */
+#define UAIF_FORMAT		GENMASK(28, 24)
+#define UAIF_BCLK_POLARITY	BIT(23)
+#define UAIF_WS_MODE		BIT(22)
+#define UAIF_WS_POLAR		BIT(21)
+#define UAIF_SLOT_MAX		GENMASK(20, 18)
+#define UAIF_SBIT_MAX		GENMASK(17, 12)
+#define UAIF_VALID_STR		GENMASK(11, 6)
+#define UAIF_VALID_END		GENMASK(5, 0)
+
+/* RDMA/WDMA status */
+#define DMA_STATUS_PROGRESS	BIT(31)
+#define DMA_STATUS_RBUF_OFFSET	GENMASK(28, 16)	/* in 16-byte units */
+#define DMA_STATUS_RBUF_CNT	GENMASK(12, 0)
+
+/*
+ * The mixer is set to the stream rate, so the rate converter isn't needed;
+ * with the firmware's ASRC setup the sound comes out harsh.
+ */
+static bool asrc;
+module_param(asrc, bool, 0644);
+MODULE_PARM_DESC(asrc, "Route RDMA0 through ASRC0");
+
+/* Capture path as on stock: UAIF -> NSRC0 -> SPUM -> SIFM0 -> WDMA1 */
+#define CAP_NSRC		0
+#define CAP_WDMA		1
+
+struct abox_dma {
+	struct snd_pcm_substream *substream;
+	u32 id;			/* firmware channel id */
+	u32 iova;		/* buffer as the firmware sees it */
+	u32 status;		/* DMA status register */
+	u32 ctrl;		/* DMA control register */
+	u32 ipcid;
+	u32 irq;		/* buffer empty/full interrupt */
+	u32 pointer;		/* position reported by the firmware, if any */
+};
+
+struct abox_pcm {
+	struct abox_data *abox;
+	unsigned long uaif_consumer;	/* bit per UAIF: BCLK comes from the pin */
+	struct abox_dma dma[2];		/* indexed by stream direction */
+};
+
+static const struct snd_pcm_hardware abox_pcm_hardware = {
+	.info = SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_BLOCK_TRANSFER |
+		SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID,
+	.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+		   SNDRV_PCM_FMTBIT_S32_LE,
+	.rates = SNDRV_PCM_RATE_8000_192000,
+	.rate_min = 8000,
+	.rate_max = 192000,
+	.channels_min = 1,
+	.channels_max = 8,
+	.buffer_bytes_max = BUFFER_BYTES_MAX,
+	.period_bytes_min = 128,
+	.period_bytes_max = BUFFER_BYTES_MAX / 2,
+	.periods_min = 2,
+	.periods_max = 32,
+};
+
+static struct abox_pcm *to_abox_pcm(struct snd_soc_component *component)
+{
+	struct abox_data *abox = snd_soc_component_get_drvdata(component);
+
+	return abox->pcm;
+}
+
+static struct abox_pcm *dai_to_abox_pcm(struct snd_soc_dai *dai)
+{
+	struct abox_data *abox = snd_soc_dai_get_drvdata(dai);
+
+	return abox->pcm;
+}
+
+static struct abox_dma *to_dma(struct snd_soc_component *component,
+			       struct snd_pcm_substream *substream)
+{
+	return &to_abox_pcm(component)->dma[substream->stream];
+}
+
+static int abox_dma_ipc(struct abox_pcm *pcm, struct abox_dma *dma, u32 type,
+			void (*fill)(struct abox_ipc_pcmtask *, void *),
+			void *arg)
+{
+	struct abox_ipc_msg msg = {
+		.ipcid = dma->ipcid,
+		.task_id = dma->id,
+		.msg.pcmtask = {
+			.msgtype = type,
+			.channel_id = dma->id,
+		},
+	};
+
+	if (fill)
+		fill(&msg.msg.pcmtask, arg);
+	return abox_ipc_send(pcm->abox, &msg, sizeof(msg));
+}
+
+static int abox_config_ipc(struct abox_data *abox, u32 type, int p1, int p2)
+{
+	struct abox_ipc_msg msg = {
+		.ipcid = IPC_ABOX_CONFIG,
+		.msg.config = {
+			.msgtype = type,
+			.param1 = p1,
+			.param2 = p2,
+		},
+	};
+
+	return abox_ipc_send(abox, &msg, sizeof(msg));
+}
+
+/* Called from the ABOX IRQ thread for DMA interrupts and PCM messages. */
+static void abox_pcm_irq(void *priv, unsigned int id,
+			 const struct abox_ipc_msg *msg)
+{
+	struct abox_pcm *pcm = priv;
+	struct abox_dma *dma = NULL;
+	struct snd_pcm_substream *substream;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(pcm->dma); i++) {
+		if (msg ? msg->ipcid == pcm->dma[i].ipcid :
+			  id == pcm->dma[i].irq)
+			dma = &pcm->dma[i];
+	}
+	if (!dma)
+		return;
+
+	if (msg) {
+		if (msg->msg.pcmtask.msgtype != PCM_PLTDAI_POINTER ||
+		    msg->msg.pcmtask.channel_id != dma->id)
+			return;
+		WRITE_ONCE(dma->pointer, msg->msg.pcmtask.param.pointer);
+	}
+
+	substream = READ_ONCE(dma->substream);
+	if (substream)
+		snd_pcm_period_elapsed(substream);
+}
+
+static int abox_pcm_open(struct snd_soc_component *component,
+			 struct snd_pcm_substream *substream)
+{
+	struct abox_pcm *pcm = to_abox_pcm(component);
+	struct abox_dma *dma = to_dma(component, substream);
+	int ret;
+
+	ret = abox_boot(pcm->abox);
+	if (ret)
+		return ret;
+
+	snd_soc_set_runtime_hwparams(substream, &abox_pcm_hardware);
+	ret = snd_pcm_hw_constraint_step(substream->runtime, 0,
+					 SNDRV_PCM_HW_PARAM_PERIOD_BYTES, 16);
+	if (ret)
+		return ret;
+
+	dma->pointer = 0;
+	WRITE_ONCE(dma->substream, substream);
+
+	return abox_dma_ipc(pcm, dma, PCM_PLTDAI_OPEN, NULL, NULL);
+}
+
+static int abox_pcm_close(struct snd_soc_component *component,
+			  struct snd_pcm_substream *substream)
+{
+	struct abox_pcm *pcm = to_abox_pcm(component);
+	struct abox_dma *dma = to_dma(component, substream);
+	int ret, i;
+
+	ret = abox_dma_ipc(pcm, dma, PCM_PLTDAI_CLOSE, NULL, NULL);
+	for (i = 1000; i && (readl(pcm->abox->sfr + dma->ctrl) & BIT(0)); i--)
+		udelay(1);
+	WRITE_ONCE(dma->substream, NULL);
+
+	return ret;
+}
+
+struct abox_buf_args {
+	struct snd_pcm_hw_params *params;
+	u32 iova;
+};
+
+static void fill_setbuff(struct abox_ipc_pcmtask *t, void *arg)
+{
+	struct abox_buf_args *a = arg;
+
+	t->param.setbuff.phyaddr = a->iova;
+	t->param.setbuff.size = params_period_bytes(a->params);
+	t->param.setbuff.count = params_periods(a->params);
+}
+
+static void fill_hw_params(struct abox_ipc_pcmtask *t, void *arg)
+{
+	struct snd_pcm_hw_params *params = arg;
+
+	t->param.hw_params.sample_rate = params_rate(params);
+	t->param.hw_params.bit_depth = params_width(params);
+	t->param.hw_params.channels = params_channels(params);
+}
+
+static int abox_pcm_hw_params(struct snd_soc_component *component,
+			      struct snd_pcm_substream *substream,
+			      struct snd_pcm_hw_params *params)
+{
+	struct abox_pcm *pcm = to_abox_pcm(component);
+	struct abox_dma *dma = to_dma(component, substream);
+	struct abox_data *abox = pcm->abox;
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct abox_buf_args args = { .params = params, .iova = dma->iova };
+	int ret;
+
+	/* The buffers live at fixed spots in the ABOX carve-out. */
+	runtime->dma_area = abox->dram + (dma->iova - IOVA_BASE);
+	runtime->dma_addr = abox->dram_phys + (dma->iova - IOVA_BASE);
+	runtime->dma_bytes = params_buffer_bytes(params);
+
+	ret = abox_dma_ipc(pcm, dma, PCM_SET_BUFFER, fill_setbuff, &args);
+	if (ret)
+		return ret;
+	return abox_dma_ipc(pcm, dma, PCM_PLTDAI_HW_PARAMS, fill_hw_params,
+			    params);
+}
+
+static int abox_pcm_hw_free(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream)
+{
+	return abox_dma_ipc(to_abox_pcm(component), to_dma(component, substream),
+			    PCM_PLTDAI_HW_FREE, NULL, NULL);
+}
+
+static int abox_pcm_prepare(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream)
+{
+	struct abox_dma *dma = to_dma(component, substream);
+
+	dma->pointer = 0;
+	return abox_dma_ipc(to_abox_pcm(component), dma, PCM_PLTDAI_PREPARE,
+			    NULL, NULL);
+}
+
+static void fill_trigger(struct abox_ipc_pcmtask *t, void *arg)
+{
+	t->param.trigger = (long)arg;
+}
+
+static int abox_pcm_trigger(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream, int cmd)
+{
+	struct abox_pcm *pcm = to_abox_pcm(component);
+	struct abox_dma *dma = to_dma(component, substream);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		return abox_dma_ipc(pcm, dma, PCM_PLTDAI_TRIGGER, fill_trigger,
+				    (void *)1L);
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		return abox_dma_ipc(pcm, dma, PCM_PLTDAI_TRIGGER, fill_trigger,
+				    (void *)0L);
+	default:
+		return -EINVAL;
+	}
+}
+
+static snd_pcm_uframes_t abox_pcm_pointer(struct snd_soc_component *component,
+					  struct snd_pcm_substream *substream)
+{
+	struct abox_pcm *pcm = to_abox_pcm(component);
+	struct abox_dma *dma = to_dma(component, substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	u32 pointer = READ_ONCE(dma->pointer);
+	u32 status = readl(pcm->abox->sfr + dma->status);
+	ssize_t buffer_bytes = snd_pcm_lib_buffer_bytes(substream);
+	ssize_t period_bytes = snd_pcm_lib_period_bytes(substream);
+	ssize_t offset, pos = 0;
+
+	if (pointer > dma->iova) {
+		/* the firmware reported a position */
+		pos = pointer - dma->iova;
+	} else if (status & DMA_STATUS_PROGRESS) {
+		/*
+		 * The DMA reports the start of the chunk it is working on and
+		 * how far into it it is. As downstream does, round the chunk
+		 * start down to a period boundary.
+		 */
+		offset = FIELD_GET(DMA_STATUS_RBUF_OFFSET, status) << 4;
+		while ((offset % period_bytes) && buffer_bytes >= 0) {
+			buffer_bytes -= period_bytes;
+			if ((buffer_bytes & offset) == offset)
+				offset = buffer_bytes;
+		}
+		pos = offset + FIELD_GET(DMA_STATUS_RBUF_CNT, status);
+	}
+
+	if (pos < 0 || pos >= runtime->dma_bytes)
+		pos = 0;
+
+	return bytes_to_frames(runtime, pos);
+}
+
+static int abox_pcm_mmap(struct snd_soc_component *component,
+			 struct snd_pcm_substream *substream,
+			 struct vm_area_struct *vma)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+
+	vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
+	return remap_pfn_range(vma, vma->vm_start,
+			       runtime->dma_addr >> PAGE_SHIFT,
+			       vma->vm_end - vma->vm_start, vma->vm_page_prot);
+}
+
+/* UAIF DAIs */
+
+static int abox_uaif_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct abox_pcm *pcm = dai_to_abox_pcm(dai);
+	struct abox_data *abox = pcm->abox;
+	u32 ctrl0 = readl(abox->sfr + ABOX_UAIF_CTRL0(dai->id));
+	u32 ctrl1 = readl(abox->sfr + ABOX_UAIF_CTRL1(dai->id));
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		ctrl1 &= ~UAIF_WS_MODE;
+		break;
+	case SND_SOC_DAIFMT_DSP_A:
+		ctrl1 |= UAIF_WS_MODE;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	ctrl1 &= ~(UAIF_BCLK_POLARITY | UAIF_WS_POLAR);
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		ctrl1 |= UAIF_BCLK_POLARITY;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		ctrl1 |= UAIF_BCLK_POLARITY | UAIF_WS_POLAR;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		ctrl1 |= UAIF_WS_POLAR;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * ASoC hands a CPU DAI the format from its own point of view. Note the
+	 * MODE bit: set, the UAIF drives the clocks; downstream's comments get
+	 * this the wrong way round.
+	 */
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_CBC_CFC:
+		ctrl0 &= ~UAIF_MODE_PROVIDER;
+		set_bit(dai->id, &pcm->uaif_consumer);
+		break;
+	case SND_SOC_DAIFMT_CBP_CFP:
+		ctrl0 |= UAIF_MODE_PROVIDER;
+		clear_bit(dai->id, &pcm->uaif_consumer);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	writel(ctrl0, abox->sfr + ABOX_UAIF_CTRL0(dai->id));
+	writel(ctrl1, abox->sfr + ABOX_UAIF_CTRL1(dai->id));
+	return 0;
+}
+
+static void abox_route_playback(struct abox_data *abox, unsigned int uaif)
+{
+	u32 val;
+
+	/* RDMA0 -> (ASRC0) -> mixer (SIFS0) -> this UAIF */
+	val = readl(abox->sfr + ABOX_SPUS_CTRL0);
+	val &= ~(0xf << SPUS_CHAIN_SHIFT(0));
+	val |= ((asrc ? SPUS_CHAIN_ASRC : 0) | SPUS_CHAIN_OUT_SIFS0) <<
+	       SPUS_CHAIN_SHIFT(0);
+	writel(val, abox->sfr + ABOX_SPUS_CTRL0);
+
+	val = readl(abox->sfr + ABOX_ROUTE_CTRL0);
+	val &= ~(0xf << ROUTE_UAIF_SPK_SHIFT(uaif));
+	val |= ROUTE_UAIF_SPK_SIFS0 << ROUTE_UAIF_SPK_SHIFT(uaif);
+	writel(val, abox->sfr + ABOX_ROUTE_CTRL0);
+
+	/*
+	 * Restart the mixer and the SIFS paths. Without this the mixer
+	 * free-runs instead of following the UAIF clock.
+	 */
+	writel(BIT(0), abox->sfr + ABOX_SPUS_CTRL2);
+	writel(BIT(2) | BIT(1) | BIT(0), abox->sfr + ABOX_SPUS_CTRL3);
+}
+
+static void abox_route_capture(struct abox_data *abox, unsigned int uaif)
+{
+	unsigned int n = CAP_NSRC;
+	u32 val;
+
+	/* this UAIF -> NSRC -> SPUM chain (ASRC on, as stock) -> WDMA */
+	val = readl(abox->sfr + ABOX_ROUTE_CTRL1);
+	val &= ~(0xf << ROUTE_NSRC_SHIFT(n));
+	val |= ROUTE_NSRC_UAIF(uaif) << ROUTE_NSRC_SHIFT(n);
+	writel(val, abox->sfr + ABOX_ROUTE_CTRL1);
+
+	val = readl(abox->sfr + ABOX_SPUM_CTRL0);
+	val &= ~(0xf << SPUM_CHAIN_SHIFT(n));
+	val |= BIT(0) << SPUM_CHAIN_SHIFT(n);
+	writel(val, abox->sfr + ABOX_SPUM_CTRL0);
+
+	/* flush the record and SIFM paths */
+	writel(BIT(0), abox->sfr + ABOX_SPUM_CTRL2);
+	writel(0xf, abox->sfr + ABOX_SPUM_CTRL3);
+}
+
+static int abox_uaif_hw_params(struct snd_pcm_substream *substream,
+			       struct snd_pcm_hw_params *params,
+			       struct snd_soc_dai *dai)
+{
+	struct abox_pcm *pcm = dai_to_abox_pcm(dai);
+	struct abox_data *abox = pcm->abox;
+	bool playback = substream->stream == SNDRV_PCM_STREAM_PLAYBACK;
+	unsigned int channels = params_channels(params);
+	unsigned int width = params_width(params);
+	u32 ctrl1 = readl(abox->sfr + ABOX_UAIF_CTRL1(dai->id));
+	u32 format;
+	int ret;
+
+	format = channels - 1;
+	switch (width) {
+	case 16:
+		format |= 1 << 3;
+		break;
+	case 24:
+		format |= 2 << 3;
+		break;
+	case 32:
+		format |= 3 << 3;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* Both directions of a UAIF share the frame format. */
+	ctrl1 &= ~(UAIF_FORMAT | UAIF_SLOT_MAX | UAIF_SBIT_MAX |
+		   UAIF_VALID_STR | UAIF_VALID_END);
+	ctrl1 |= FIELD_PREP(UAIF_FORMAT, format) |
+		 FIELD_PREP(UAIF_SLOT_MAX, channels - 1) |
+		 FIELD_PREP(UAIF_SBIT_MAX, width - 1);
+	if (channels != 2)
+		ctrl1 |= FIELD_PREP(UAIF_VALID_STR, width - 1) |
+			 FIELD_PREP(UAIF_VALID_END, width - 1);
+	writel(ctrl1, abox->sfr + ABOX_UAIF_CTRL1(dai->id));
+
+	abox_uaif_clk_enable(abox, dai->id,
+			     test_bit(dai->id, &pcm->uaif_consumer));
+
+	if (playback) {
+		abox_route_playback(abox, dai->id);
+		/* The mixer runs at the UAIF rate. */
+		ret = abox_config_ipc(abox, SET_MIXER_SAMPLE_RATE,
+				      params_rate(params), 0);
+		if (!ret)
+			ret = abox_config_ipc(abox, SET_MIXER_FORMAT, width,
+					      channels);
+	} else {
+		abox_route_capture(abox, dai->id);
+		ret = abox_config_ipc(abox, SET_INMUX0_SAMPLE_RATE + CAP_NSRC,
+				      params_rate(params), 0);
+		if (!ret)
+			ret = abox_config_ipc(abox, SET_INMUX0_FORMAT + CAP_NSRC,
+					      width, channels);
+	}
+	return ret;
+}
+
+static u32 uaif_enable_bit(struct snd_pcm_substream *substream)
+{
+	return substream->stream == SNDRV_PCM_STREAM_PLAYBACK ?
+	       UAIF_SPK_ENABLE : UAIF_MIC_ENABLE;
+}
+
+static int abox_uaif_trigger(struct snd_pcm_substream *substream, int cmd,
+			     struct snd_soc_dai *dai)
+{
+	struct abox_pcm *pcm = dai_to_abox_pcm(dai);
+	void __iomem *reg = pcm->abox->sfr + ABOX_UAIF_CTRL0(dai->id);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		writel(readl(reg) | uaif_enable_bit(substream), reg);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		/* playback is left enabled until shutdown to avoid pops */
+		if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+			writel(readl(reg) & ~UAIF_MIC_ENABLE, reg);
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static void abox_uaif_shutdown(struct snd_pcm_substream *substream,
+			       struct snd_soc_dai *dai)
+{
+	struct abox_pcm *pcm = dai_to_abox_pcm(dai);
+	void __iomem *reg = pcm->abox->sfr + ABOX_UAIF_CTRL0(dai->id);
+
+	writel(readl(reg) & ~uaif_enable_bit(substream), reg);
+}
+
+static const struct snd_soc_dai_ops abox_uaif_ops = {
+	.set_fmt = abox_uaif_set_fmt,
+	.hw_params = abox_uaif_hw_params,
+	.trigger = abox_uaif_trigger,
+	.shutdown = abox_uaif_shutdown,
+};
+
+#define ABOX_UAIF_STREAM(_id, _dir) {					\
+	.stream_name = "UAIF" #_id " " _dir,				\
+	.channels_min = 1,						\
+	.channels_max = 8,						\
+	.rates = SNDRV_PCM_RATE_8000_192000,				\
+	.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |	\
+		   SNDRV_PCM_FMTBIT_S32_LE,				\
+}
+
+#define ABOX_UAIF_DAI(_id) {						\
+	.name = "UAIF" #_id,						\
+	.id = _id,							\
+	.playback = ABOX_UAIF_STREAM(_id, "Playback"),			\
+	.capture = ABOX_UAIF_STREAM(_id, "Capture"),			\
+	.ops = &abox_uaif_ops,						\
+}
+
+static struct snd_soc_dai_driver abox_dais[] = {
+	ABOX_UAIF_DAI(0),
+	ABOX_UAIF_DAI(1),
+	ABOX_UAIF_DAI(2),
+	ABOX_UAIF_DAI(3),
+	ABOX_UAIF_DAI(4),
+};
+
+static const struct snd_soc_component_driver abox_component = {
+	.name = "samsung-abox",
+	.open = abox_pcm_open,
+	.close = abox_pcm_close,
+	.hw_params = abox_pcm_hw_params,
+	.hw_free = abox_pcm_hw_free,
+	.prepare = abox_pcm_prepare,
+	.trigger = abox_pcm_trigger,
+	.pointer = abox_pcm_pointer,
+	.mmap = abox_pcm_mmap,
+	.legacy_dai_naming = 1,
+};
+
+int abox_pcm_register(struct abox_data *abox)
+{
+	struct device *dev = abox->dev;
+	struct abox_pcm *pcm;
+
+	pcm = devm_kzalloc(dev, sizeof(*pcm), GFP_KERNEL);
+	if (!pcm)
+		return -ENOMEM;
+	pcm->abox = abox;
+
+	pcm->dma[SNDRV_PCM_STREAM_PLAYBACK] = (struct abox_dma) {
+		.iova = 0x81000000,		/* RDMA0 buffer */
+		.status = ABOX_RDMA_STATUS(0),
+		.ctrl = ABOX_RDMA_CTRL0(0),
+		.ipcid = IPC_PCMPLAYBACK,
+		.irq = RDMA0_BUF_EMPTY,
+	};
+	pcm->dma[SNDRV_PCM_STREAM_CAPTURE] = (struct abox_dma) {
+		.id = CAP_WDMA,
+		.iova = 0x82000000 + CAP_WDMA * SZ_1M,	/* WDMAx buffer */
+		.status = ABOX_WDMA_STATUS(CAP_WDMA),
+		.ctrl = ABOX_WDMA_CTRL(CAP_WDMA),
+		.ipcid = IPC_PCMCAPTURE,
+		.irq = WDMA0_BUF_FULL + CAP_WDMA,
+	};
+
+	abox->pcm = pcm;
+	abox->dma_irq_priv = pcm;
+	abox->dma_irq = abox_pcm_irq;
+
+	return devm_snd_soc_register_component(dev, &abox_component, abox_dais,
+					       ARRAY_SIZE(abox_dais));
+}
diff --git a/sound/soc/samsung/exynos8895_madera.c b/sound/soc/samsung/exynos8895_madera.c
new file mode 100644
index 000000000..1de7f372a
--- /dev/null
+++ b/sound/soc/samsung/exynos8895_madera.c
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Machine driver for Exynos8895 phones with a Cirrus Logic CS47L93 codec
+ * behind the ABOX audio subsystem (Samsung Galaxy Note 8).
+ *
+ * ABOX UAIF0 <-> codec AIF1 carries playback to the headphone jack
+ * (HPOUT2) and the earpiece (HPOUT3/4). The codec is the I2S clock
+ * provider: as provider, ABOX's UAIF puts no bit clock on the pins. The
+ * codec's FLL1 runs from the 26 MHz TCXO clock (PMU CLKOUT0) on MCLK1.
+ */
+
+#include <linux/clk.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/soc-dapm.h>
+
+#include <linux/mfd/madera/core.h>
+#include <linux/mfd/madera/registers.h>
+
+#include "../codecs/madera.h"
+
+#define MCLK_RATE		26000000
+#define MADERA_32K_SRC_SYSCLK	2
+#define SYSCLK_RATE_48K		98304000
+#define SYSCLK_RATE_44K1	90316800
+
+struct exynos8895_madera {
+	struct clk *mclk;	/* codec MCLK1: PMU CLKOUT0 from the 26 MHz TCXO */
+	unsigned int sysclk;
+};
+
+static int exynos8895_madera_set_sysclk(struct snd_soc_component *codec,
+					unsigned int rate)
+{
+	int ret;
+
+	ret = snd_soc_component_set_pll(codec, MADERA_FLL1_REFCLK,
+					MADERA_FLL_SRC_MCLK1, MCLK_RATE, rate);
+	if (ret) {
+		dev_err(codec->dev, "failed to start FLL1: %d\n", ret);
+		return ret;
+	}
+
+	ret = snd_soc_component_set_sysclk(codec, MADERA_CLK_SYSCLK_1,
+					   MADERA_CLK_SRC_FLL1, rate,
+					   SND_SOC_CLOCK_IN);
+	if (ret) {
+		dev_err(codec->dev, "failed to set SYSCLK: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * Nothing drives the codec's MCLK2, which the madera core uses for
+	 * the 32 kHz clock. Volume ramps run from it, so without it any
+	 * digital attenuation turns the output into noise. Derive it from
+	 * SYSCLK instead.
+	 */
+	return snd_soc_component_update_bits(codec, MADERA_CLOCK_32K_1,
+					     MADERA_CLK_32K_SRC_MASK,
+					     MADERA_32K_SRC_SYSCLK);
+}
+
+static int exynos8895_madera_hw_params(struct snd_pcm_substream *substream,
+				       struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct exynos8895_madera *priv = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	unsigned int rate = params_rate(params) % 4000 ?
+			    SYSCLK_RATE_44K1 : SYSCLK_RATE_48K;
+	int ret;
+
+	if (rate != priv->sysclk) {
+		ret = exynos8895_madera_set_sysclk(codec_dai->component, rate);
+		if (ret)
+			return ret;
+		priv->sysclk = rate;
+	}
+
+	return snd_soc_dai_set_sysclk(codec_dai, MADERA_CLK_SYSCLK_1, rate,
+				      SND_SOC_CLOCK_IN);
+}
+
+static int exynos8895_madera_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct exynos8895_madera *priv = snd_soc_card_get_drvdata(rtd->card);
+
+	return clk_prepare_enable(priv->mclk);
+}
+
+static void exynos8895_madera_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct exynos8895_madera *priv = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+
+	/* Stop the FLL before its reference goes away. */
+	snd_soc_component_set_sysclk(codec_dai->component, MADERA_CLK_SYSCLK_1,
+				     0, 0, SND_SOC_CLOCK_IN);
+	snd_soc_component_set_pll(codec_dai->component, MADERA_FLL1_REFCLK,
+				  MADERA_FLL_SRC_NONE, 0, 0);
+	priv->sysclk = 0;
+	clk_disable_unprepare(priv->mclk);
+}
+
+static const struct snd_soc_ops exynos8895_madera_ops = {
+	.startup = exynos8895_madera_startup,
+	.shutdown = exynos8895_madera_shutdown,
+	.hw_params = exynos8895_madera_hw_params,
+};
+
+/*
+ * The output volumes go up to +31.5 dB, which clips full-scale audio; the
+ * earpiece distorts above about -6 dB (0.5 dB steps, 128 = 0 dB).
+ */
+#define EARPIECE_VOLUME_MAX	116
+#define HEADPHONE_VOLUME_MAX	128
+
+static int exynos8895_madera_late_probe(struct snd_soc_card *card)
+{
+	int ret;
+
+	ret = snd_soc_limit_volume(card, "HPOUT3 Digital Volume",
+				   EARPIECE_VOLUME_MAX);
+	if (ret)
+		return ret;
+	return snd_soc_limit_volume(card, "HPOUT2 Digital Volume",
+				    HEADPHONE_VOLUME_MAX);
+}
+
+static const struct snd_soc_dapm_widget exynos8895_madera_widgets[] = {
+	SND_SOC_DAPM_HP("Headphone", NULL),
+	SND_SOC_DAPM_SPK("Earpiece", NULL),
+};
+
+static const struct snd_soc_dapm_route exynos8895_madera_routes[] = {
+	{ "Headphone", NULL, "HPOUT2L" },
+	{ "Headphone", NULL, "HPOUT2R" },
+	{ "Earpiece", NULL, "HPOUT3L" },
+	{ "Earpiece", NULL, "HPOUT3R" },
+	{ "Earpiece", NULL, "HPOUT4L" },
+	{ "Earpiece", NULL, "HPOUT4R" },
+};
+
+static const struct snd_kcontrol_new exynos8895_madera_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Headphone"),
+	SOC_DAPM_PIN_SWITCH("Earpiece"),
+};
+
+SND_SOC_DAILINK_DEFS(codec,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link exynos8895_madera_links[] = {
+	{
+		.name = "Codec",
+		.stream_name = "Codec",
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			   SND_SOC_DAIFMT_CBP_CFP,
+		.ops = &exynos8895_madera_ops,
+		SND_SOC_DAILINK_REG(codec),
+	},
+};
+
+static struct snd_soc_card exynos8895_madera_card = {
+	.owner = THIS_MODULE,
+	.dai_link = exynos8895_madera_links,
+	.num_links = ARRAY_SIZE(exynos8895_madera_links),
+	.dapm_widgets = exynos8895_madera_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(exynos8895_madera_widgets),
+	.dapm_routes = exynos8895_madera_routes,
+	.num_dapm_routes = ARRAY_SIZE(exynos8895_madera_routes),
+	.controls = exynos8895_madera_controls,
+	.num_controls = ARRAY_SIZE(exynos8895_madera_controls),
+	.fully_routed = true,
+	.late_probe = exynos8895_madera_late_probe,
+};
+
+static int exynos8895_madera_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct snd_soc_card *card = &exynos8895_madera_card;
+	struct snd_soc_dai_link *link = &exynos8895_madera_links[0];
+	struct exynos8895_madera *priv;
+	struct of_phandle_args args;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(priv->mclk))
+		return dev_err_probe(dev, PTR_ERR(priv->mclk), "no codec MCLK\n");
+
+	card->dev = dev;
+	snd_soc_card_set_drvdata(card, priv);
+
+	ret = snd_soc_of_parse_card_name(card, "model");
+	if (ret)
+		return ret;
+
+	ret = of_parse_phandle_with_args(dev->of_node, "samsung,cpu-dai",
+					 "#sound-dai-cells", 0, &args);
+	if (ret)
+		return dev_err_probe(dev, ret, "no samsung,cpu-dai\n");
+	link->cpus->of_node = args.np;
+	ret = snd_soc_get_dai_name(&args, &link->cpus->dai_name);
+	if (ret) {
+		of_node_put(args.np);
+		return dev_err_probe(dev, ret, "cpu dai not ready\n");
+	}
+	link->platforms->of_node = args.np;
+
+	ret = of_parse_phandle_with_args(dev->of_node, "samsung,codec-dai",
+					 "#sound-dai-cells", 0, &args);
+	if (ret)
+		return dev_err_probe(dev, ret, "no samsung,codec-dai\n");
+	link->codecs->of_node = args.np;
+	ret = snd_soc_get_dai_name(&args, &link->codecs->dai_name);
+	if (ret) {
+		of_node_put(args.np);
+		return dev_err_probe(dev, ret, "codec dai not ready\n");
+	}
+
+	return devm_snd_soc_register_card(dev, card);
+}
+
+static const struct of_device_id exynos8895_madera_of_match[] = {
+	{ .compatible = "samsung,exynos8895-madera" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos8895_madera_of_match);
+
+static struct platform_driver exynos8895_madera_driver = {
+	.probe = exynos8895_madera_probe,
+	.driver = {
+		.name = "exynos8895-madera",
+		.of_match_table = exynos8895_madera_of_match,
+		.pm = &snd_soc_pm_ops,
+	},
+};
+module_platform_driver(exynos8895_madera_driver);
+
+MODULE_DESCRIPTION("Exynos8895 ABOX + CS47L93 machine driver");
+MODULE_LICENSE("GPL");
-- 
