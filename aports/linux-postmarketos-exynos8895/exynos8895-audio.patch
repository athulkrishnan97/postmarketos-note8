diff --git a/sound/soc/samsung/abox/abox.c b/sound/soc/samsung/abox/abox.c
new file mode 100644
index 000000000..1756b8a50
--- /dev/null
+++ b/sound/soc/samsung/abox/abox.c
@@ -0,0 +1,848 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Exynos8895 ABOX audio subsystem
+ *
+ * ABOX contains the audio DMAs (RDMA/WDMA), a mixer (SPUS/SPUM), the I2S
+ * style interfaces to the codec and amplifiers (UAIF) and a Cortex-A7 that
+ * runs Samsung's "Calliope" firmware. The PCM DMAs are programmed by the
+ * firmware; Linux loads it, boots the A7 and talks to it over a mailbox in
+ * the ABOX SRAM, with software generated interrupts on a small GIC inside
+ * ABOX in both directions.
+ *
+ * Based on the Samsung downstream driver (sound/soc/samsung/abox/abox.c),
+ * Copyright (c) 2016 Samsung Electronics Co. Ltd.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/math64.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/timekeeping.h>
+
+#include "abox.h"
+#include "abox_ipc.h"
+
+/* PMU (offsets in the PMU syscon) */
+#define PMU_ABOX_MAGIC			0x0814
+#define PMU_ABOX_MAGIC_VALUE		0xab0cab0c
+#define PMU_GPIO_MODE_ABOX_SYS_PWR	0x1308
+#define PMU_ABOX_CA7_CONFIGURATION	0x2520
+#define PMU_ABOX_CA7_LOCAL_PWR_CFG	BIT(0)
+#define PMU_ABOX_CA7_STATUS		0x2524
+#define PMU_ABOX_CA7_STATUS_ON		BIT(0)
+#define PMU_ABOX_CA7_STATUS_WFI		BIT(28)
+#define PMU_ABOX_CA7_OPTION		0x2528
+#define PMU_ABOX_CA7_ENABLE_CPU		BIT(15)
+#define PMU_PAD_RETENTION_ABOX_OPTION	0x3048
+
+/* CMU_ABOX (no common clock driver yet) */
+#define CMU_MUX_CLK_ABOX_UAIF(x)	(0x1004 + (x) * 4)
+#define CMU_GATE_MANUAL_ON		(BIT(21) | BIT(20))
+#define CMU_DIV_CLK_ABOX_PLL		0x1820	/* A7 clock: PLL_AUD / (n + 1) */
+#define AUD_PLL_RATE_HZ			1179648000UL
+#define CPU_GEAR_MAX			16
+#define CMU_GATE_AUD_CODEC_MCLK		0x2004
+#define CMU_GATE_BCLK_UAIF(x)		(0x2024 + (x) * 4)
+#define CMU_GATE_RSTNSYNC_UAIF(x)	(0x209c + (x) * 4)
+
+/* ABOX sysreg */
+#define SYSREG_L2_CACHE_CON		0x0328
+#define SYSREG_MISC_CON			0x032c
+
+/* ABOX GIC (GICv2 distributor / CPU interface) */
+#define GICD_CTLR			0x000
+#define GICD_IGROUPR			0x080
+#define GICD_IPRIORITYR			0x400
+#define GICD_SGIR			0xf00
+#define GICC_CTLR			0x000
+#define GICC_PMR			0x004
+#define GICC_IAR			0x00c
+#define GICC_EOIR			0x010
+#define GICC_DIR			0x1000
+#define GICC_IAR_ID			GENMASK(9, 0)
+
+#define SMC_ABOX_PREPARE		0x82000501
+
+#define CHIPID_BASE			0x10000000
+
+/* Memory as seen by the A7 through the ABOX SysMMU */
+#define IOVA_DRAM_FIRMWARE		0x80000000
+#define DRAM_FIRMWARE_SIZE		(SZ_8M + SZ_4M)
+#define IOVA_DMA_BUFFERS		0x81000000
+#define DMA_BUFFERS_SIZE		(SZ_32M)
+#define IOVA_IVA_FIRMWARE		0x90000000
+#define IVA_FIRMWARE_SIZE		SZ_512K
+
+/* Mailbox in the ABOX SRAM */
+#define IPC_TX_OFFSET			0x30000
+#define IPC_TX_ACK_OFFSET		0x302fc
+#define IPC_RX_OFFSET			0x30300
+#define IPC_RX_ACK_OFFSET		0x305fc
+#define IPC_COMPAT_OFFSET		0x30040
+
+#define BOOT_DONE_TIMEOUT_MS		3000
+
+
+/*
+ * Downstream programs these through the EL3 monitor (SMC_CMD_REG), which
+ * never returns on this phone. The AP's accesses reach the ABOX GIC as
+ * secure ones (GICD_CTLR takes both group enables), so write them directly.
+ */
+static void abox_gic_init(struct abox_data *data)
+{
+	int i;
+
+	writel(0xff, data->gicc + GICC_PMR);
+	writel(0x3, data->gicd + GICD_CTLR);
+	if (data->secure_gic)
+		writel(0xffffffff, data->gicd + GICD_IGROUPR);
+	for (i = 0; i < 40; i++)
+		writel(0x10101010, data->gicd + GICD_IPRIORITYR + i * 4);
+	writel(0x3, data->gicc + GICC_CTLR);
+}
+
+static void abox_gic_send(struct abox_data *data, unsigned int sgi)
+{
+	writel(BIT(16) | (sgi & 0xf), data->gicd + GICD_SGIR);
+}
+
+/*
+ * The UAIF bit clock and codec clock gates are left under hardware control
+ * by default, which keeps them off; hold them on.
+ */
+static void abox_cmu_init(struct abox_data *data)
+{
+	writel(CMU_GATE_MANUAL_ON, data->cmu + CMU_GATE_AUD_CODEC_MCLK);
+}
+
+void abox_uaif_clk_enable(struct abox_data *data, unsigned int id,
+			  bool external_bclk)
+{
+	writel(external_bclk ? 1 : 0, data->cmu + CMU_MUX_CLK_ABOX_UAIF(id));
+	writel(CMU_GATE_MANUAL_ON, data->cmu + CMU_GATE_BCLK_UAIF(id));
+	writel(CMU_GATE_MANUAL_ON, data->cmu + CMU_GATE_RSTNSYNC_UAIF(id));
+}
+EXPORT_SYMBOL_GPL(abox_uaif_clk_enable);
+
+static void abox_cpu_power(struct abox_data *data, bool on)
+{
+	regmap_update_bits(data->pmu, PMU_ABOX_CA7_CONFIGURATION,
+			   PMU_ABOX_CA7_LOCAL_PWR_CFG,
+			   on ? PMU_ABOX_CA7_LOCAL_PWR_CFG : 0);
+}
+
+/*
+ * Without translation the A7 would see physical memory at its firmware
+ * addresses (0x80000000 is Linux RAM), so never start it unless the ABOX
+ * SysMMU is actually translating.
+ */
+#define SYSMMU_ABOX_BASE		0x13e30000
+#define SYSMMU_CTRL_ENABLE		BIT(0)
+
+static bool abox_sysmmu_enabled(struct abox_data *data)
+{
+	void __iomem *ctrl = ioremap(SYSMMU_ABOX_BASE, 4);
+	u32 val;
+
+	if (!ctrl)
+		return false;
+	val = readl(ctrl);
+	iounmap(ctrl);
+	dev_dbg(data->dev, "SysMMU ctrl %#x\n", val);
+	return val & SYSMMU_CTRL_ENABLE;
+}
+
+static int abox_cpu_enable(struct abox_data *data, bool enable)
+{
+	unsigned int status;
+
+	regmap_update_bits(data->pmu, PMU_ABOX_CA7_OPTION,
+			   PMU_ABOX_CA7_ENABLE_CPU,
+			   enable ? PMU_ABOX_CA7_ENABLE_CPU : 0);
+	if (!enable)
+		return 0;
+
+	return regmap_read_poll_timeout(data->pmu, PMU_ABOX_CA7_STATUS, status,
+					status & PMU_ABOX_CA7_STATUS_ON,
+					10, 100000);
+}
+
+int abox_ipc_send(struct abox_data *data, const struct abox_ipc_msg *msg,
+		  size_t size)
+{
+	void __iomem *ack = data->sram + IPC_TX_ACK_OFFSET;
+	unsigned long flags;
+	int i, ret = 0;
+
+	if (data->state != ABOX_STATE_RUNNING)
+		return -EAGAIN;
+
+	spin_lock_irqsave(&data->ipc_lock, flags);
+	memcpy_toio(data->sram + IPC_TX_OFFSET, msg, size);
+	writel(1, ack);
+	abox_gic_send(data, msg->ipcid);
+	for (i = 1000; i && readl(ack); i--)
+		udelay(1);
+	if (readl(ack)) {
+		dev_warn_ratelimited(data->dev, "IPC %u timed out\n",
+				     msg->ipcid);
+		ret = -ETIMEDOUT;
+	}
+	spin_unlock_irqrestore(&data->ipc_lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(abox_ipc_send);
+
+static int abox_ipc_system(struct abox_data *data, u32 type, int p1, int p2,
+			   int p3)
+{
+	struct abox_ipc_msg msg = {
+		.ipcid = IPC_SYSTEM,
+		.msg.system = {
+			.msgtype = type,
+			.param1 = p1,
+			.param2 = p2,
+			.param3 = p3,
+		},
+	};
+
+	return abox_ipc_send(data, &msg, sizeof(msg));
+}
+
+void *abox_iova_to_virt(struct abox_data *data, u32 iova)
+{
+	if (iova >= IOVA_DRAM_FIRMWARE &&
+	    iova < IOVA_DRAM_FIRMWARE + data->dram_size)
+		return data->dram + (iova - IOVA_DRAM_FIRMWARE);
+	return NULL;
+}
+
+static void abox_log_flush(struct abox_data *data)
+{
+	struct abox_log_buffer *log = data->log;
+	u32 w, r, size, n;
+	char line[128];
+
+	if (!log)
+		return;
+
+	size = READ_ONCE(log->size);
+	w = READ_ONCE(log->index_writer);
+	r = READ_ONCE(log->index_reader);
+	if (!size || w >= size || r >= size)
+		return;
+
+	while (r != w) {
+		n = 0;
+		while (r != w && n < sizeof(line) - 1) {
+			char c = READ_ONCE(log->buffer[r]);
+
+			r = (r + 1) % size;
+			if (c == '\n' || c == '\0')
+				break;
+			line[n++] = c;
+		}
+		line[n] = '\0';
+		if (n)
+			dev_dbg(data->dev, "fw: %s\n", line);
+	}
+	WRITE_ONCE(log->index_reader, r);
+}
+
+static void abox_log_work(struct work_struct *work)
+{
+	struct abox_data *data = container_of(work, struct abox_data,
+					      log_work.work);
+
+	abox_log_flush(data);
+	if (data->log)
+		schedule_delayed_work(&data->log_work, msecs_to_jiffies(500));
+}
+
+/*
+ * The firmware asks for a faster A7 clock ("gear": PLL_AUD divided by the
+ * gear) when it starts heavy processing such as the ASRCs, and waits for
+ * the new rate to be confirmed. Requests are tracked per requester id and
+ * the fastest one wins.
+ */
+static void abox_change_gear(struct abox_data *data, u32 gear, u32 id)
+{
+	struct abox_ipc_msg msg = {
+		.ipcid = IPC_SYSTEM,
+		.msg.system.msgtype = ABOX_CHANGED_GEAR,
+	};
+	unsigned int i, slot = ARRAY_SIZE(data->gear_req), best = CPU_GEAR_MAX;
+	u64 ns = ktime_get_ns();
+	unsigned long rate;
+
+	for (i = 0; i < ARRAY_SIZE(data->gear_req); i++) {
+		if (data->gear_req[i].id == id ||
+		    (!data->gear_req[i].id && slot == ARRAY_SIZE(data->gear_req)))
+			slot = i;
+		if (data->gear_req[i].id == id)
+			break;
+	}
+	if (slot < ARRAY_SIZE(data->gear_req)) {
+		data->gear_req[slot].id = id;
+		data->gear_req[slot].gear = gear;
+	}
+	for (i = 0; i < ARRAY_SIZE(data->gear_req); i++)
+		if (data->gear_req[i].id && data->gear_req[i].gear &&
+		    data->gear_req[i].gear < best)
+			best = data->gear_req[i].gear;
+	best = clamp(best, 1U, (unsigned int)CPU_GEAR_MAX);
+
+	writel(best - 1, data->cmu + CMU_DIV_CLK_ABOX_PLL);
+	rate = AUD_PLL_RATE_HZ / best;
+	dev_dbg(data->dev, "CPU gear %u (request %u from %#x): %lu Hz\n", best,
+		gear, id, rate);
+
+	msg.msg.system.param1 = rate;
+	msg.msg.system.param2 = div_u64(ns, NSEC_PER_SEC);
+	msg.msg.system.param3 = do_div(ns, NSEC_PER_SEC);
+	abox_ipc_send(data, &msg, sizeof(msg));
+}
+
+static void abox_handle_system(struct abox_data *data,
+			       const struct abox_ipc_system *sys)
+{
+	struct device *dev = data->dev;
+	u32 version;
+
+	switch (sys->msgtype) {
+	case ABOX_BOOT_DONE:
+		version = sys->param3;
+		data->fw_version = version;
+		dev_info(dev, "Calliope booted, firmware version %c%c%c%c\n",
+			 (version >> 24) & 0xff, (version >> 16) & 0xff,
+			 (version >> 8) & 0xff, version & 0xff);
+		data->state = ABOX_STATE_RUNNING;
+		complete(&data->boot_done);
+		break;
+	case ABOX_CHANGE_GEAR:
+		abox_change_gear(data, sys->param1, sys->param2);
+		break;
+	case ABOX_REPORT_LOG:
+		data->log = abox_iova_to_virt(data, sys->param2);
+		dev_dbg(dev, "firmware log buffer %u at %#x\n", sys->param1,
+			sys->param2);
+		if (data->log)
+			schedule_delayed_work(&data->log_work, 0);
+		break;
+	case ABOX_REPORT_FAULT:
+		dev_err(dev, "firmware fault %d (%#x, %#x)\n", sys->param1,
+			sys->param2, sys->param3);
+		abox_log_flush(data);
+		break;
+	default:
+		dev_dbg(dev, "system message %#x (%#x, %#x, %#x)\n",
+			sys->msgtype, sys->param1, sys->param2, sys->param3);
+		break;
+	}
+}
+
+static irqreturn_t abox_irq_thread(int irq, void *dev_id)
+{
+	struct abox_data *data = dev_id;
+	struct abox_ipc_msg msg;
+	u32 iar, id;
+
+	for (;;) {
+		iar = readl(data->gicc + GICC_IAR);
+		id = iar & GICC_IAR_ID;
+		if (id >= 1020)
+			break;
+		writel(iar, data->gicc + GICC_EOIR);
+		if (id >= 16)
+			continue;
+		writel(iar, data->gicc + GICC_DIR);
+
+		switch (id) {
+		case RDMA0_BUF_EMPTY ... RDMA3_BUF_EMPTY:
+		case WDMA0_BUF_FULL:
+		case WDMA1_BUF_FULL:
+			if (data->dma_irq)
+				data->dma_irq(data->dma_irq_priv, id, NULL);
+			continue;
+		}
+
+		memcpy_fromio(&msg, data->sram + IPC_RX_OFFSET, sizeof(msg));
+		writel(0, data->sram + IPC_RX_ACK_OFFSET);
+
+		switch (msg.ipcid) {
+		case IPC_RECEIVED:
+			break;
+		case IPC_SYSTEM:
+			abox_handle_system(data, &msg.msg.system);
+			break;
+		default:
+			if (data->dma_irq)
+				data->dma_irq(data->dma_irq_priv, msg.ipcid,
+					      &msg);
+			else
+				dev_dbg(data->dev, "unhandled IPC %u\n",
+					msg.ipcid);
+			break;
+		}
+	}
+
+	return IRQ_HANDLED;
+}
+
+static bool map_pmu;
+module_param(map_pmu, bool, 0644);
+MODULE_PARM_DESC(map_pmu, "Let the firmware reach the PMU and chip id (bring-up)");
+
+static void abox_fault_work(struct work_struct *work)
+{
+	struct abox_data *data = container_of(work, struct abox_data,
+					      fault_work);
+	unsigned long iova, flags;
+
+	for (;;) {
+		spin_lock_irqsave(&data->fault_lock, flags);
+		if (data->fault_mapped == data->fault_count) {
+			spin_unlock_irqrestore(&data->fault_lock, flags);
+			break;
+		}
+		iova = data->fault_iova[data->fault_mapped++];
+		spin_unlock_irqrestore(&data->fault_lock, flags);
+
+		if (iommu_iova_to_phys(data->domain, iova))
+			continue;
+		dev_info(data->dev, "backing firmware access at %#lx with a dummy page\n",
+			 iova);
+		iommu_map(data->domain, iova, data->scratch_phys + SZ_4K, SZ_4K,
+			  IOMMU_READ | IOMMU_WRITE, GFP_KERNEL);
+	}
+}
+
+/*
+ * A faulting access is stalled and retried, so an unmapped address turns
+ * into an interrupt storm. Log it and back the page with a dummy page from
+ * process context (mapping here would take the SysMMU lock we're under).
+ */
+static int abox_iommu_fault(struct iommu_domain *domain, struct device *dev,
+			    unsigned long iova, int flags, void *token)
+{
+	struct abox_data *data = token;
+	unsigned long page = iova & PAGE_MASK;
+	unsigned int i;
+
+	spin_lock(&data->fault_lock);
+	for (i = data->fault_mapped; i < data->fault_count; i++)
+		if (data->fault_iova[i] == page)
+			break;
+	if (i == data->fault_count &&
+	    data->fault_count < ARRAY_SIZE(data->fault_iova)) {
+		data->fault_iova[data->fault_count++] = page;
+		dev_dbg(dev, "SysMMU fault at %#lx (%s), A7 pc %#x\n", iova,
+			flags & IOMMU_FAULT_WRITE ? "write" : "read",
+			readl(data->sfr + ABOX_CA7_PC));
+		queue_work(system_unbound_wq, &data->fault_work);
+	}
+	spin_unlock(&data->fault_lock);
+
+	return 0;
+}
+
+static int abox_map(struct abox_data *data, unsigned long iova,
+		    phys_addr_t paddr, size_t size, int prot)
+{
+	int ret = iommu_map(data->domain, iova, paddr, size, prot, GFP_KERNEL);
+
+	if (ret)
+		dev_err(data->dev, "failed to map %#lx -> %pa (%zu): %d\n",
+			iova, &paddr, size, ret);
+	return ret;
+}
+
+static int abox_setup_memory(struct abox_data *data)
+{
+	struct device *dev = data->dev;
+	struct resource res;
+	int prot = IOMMU_READ | IOMMU_WRITE;
+	int ret;
+
+	ret = of_reserved_mem_region_to_resource(dev->of_node, 0, &res);
+	if (ret)
+		return dev_err_probe(dev, ret, "no memory-region\n");
+	if (resource_size(&res) < DRAM_FIRMWARE_SIZE + DMA_BUFFERS_SIZE +
+				  IVA_FIRMWARE_SIZE + SZ_8K)
+		return dev_err_probe(dev, -EINVAL, "memory-region too small\n");
+
+	/*
+	 * Layout of the carve-out: firmware DRAM, then the PCM buffers, both
+	 * at fixed offsets so that one linear mapping covers them, then the
+	 * IVA firmware.
+	 */
+	data->dram_phys = res.start;
+	data->dram_size = IOVA_DMA_BUFFERS - IOVA_DRAM_FIRMWARE +
+			  DMA_BUFFERS_SIZE;
+	data->dram = devm_memremap(dev, data->dram_phys, data->dram_size,
+				   MEMREMAP_WC);
+	if (IS_ERR(data->dram))
+		return PTR_ERR(data->dram);
+	data->iva_phys = res.start + data->dram_size;
+	data->iva = devm_memremap(dev, data->iva_phys, IVA_FIRMWARE_SIZE,
+				  MEMREMAP_WC);
+	if (IS_ERR(data->iva))
+		return PTR_ERR(data->iva);
+
+	/* 8K after the IVA image: fake chip id page, then a dummy page. */
+	data->scratch_phys = data->iva_phys + IVA_FIRMWARE_SIZE;
+	data->scratch = devm_memremap(dev, data->scratch_phys, SZ_8K,
+				      MEMREMAP_WC);
+	if (IS_ERR(data->scratch))
+		return PTR_ERR(data->scratch);
+	memset(data->scratch, 0, SZ_8K);
+	/*
+	 * The chip id block faults on reads from ABOX as well as from the
+	 * AP. The firmware only checks the revision (0x10) to pick A7
+	 * prefetch settings; report EVT1.0 for the conservative path.
+	 */
+	((u32 *)data->scratch)[0] = 0xe8895000;
+	((u32 *)data->scratch)[4] = 0x00100000;
+
+	data->domain = iommu_paging_domain_alloc(dev);
+	if (IS_ERR(data->domain))
+		return dev_err_probe(dev, PTR_ERR(data->domain),
+				     "no iommu domain\n");
+	iommu_set_fault_handler(data->domain, abox_iommu_fault, data);
+	ret = iommu_attach_device(data->domain, dev);
+	if (ret) {
+		iommu_domain_free(data->domain);
+		return dev_err_probe(dev, ret, "iommu attach failed\n");
+	}
+
+	ret = abox_map(data, IOVA_DRAM_FIRMWARE, data->dram_phys,
+		       data->dram_size, prot);
+	if (!ret)
+		ret = abox_map(data, IOVA_IVA_FIRMWARE, data->iva_phys,
+			       IVA_FIRMWARE_SIZE, prot);
+	/* The firmware pokes the PMU and the chip id directly. */
+	if (!ret && map_pmu)
+		ret = abox_map(data, 0x16480000, 0x16480000, SZ_64K,
+			       prot | IOMMU_MMIO);
+	if (!ret)
+		ret = abox_map(data, CHIPID_BASE, data->scratch_phys, SZ_4K,
+			       IOMMU_READ);
+	if (ret) {
+		iommu_detach_device(data->domain, dev);
+		iommu_domain_free(data->domain);
+	}
+	return ret;
+}
+
+static int abox_load_firmware(struct abox_data *data)
+{
+	const struct firmware *fw;
+	struct device *dev = data->dev;
+	int ret;
+
+	ret = request_firmware(&fw, "calliope_sram.bin", dev);
+	if (ret)
+		return ret;
+	if (fw->size > data->sram_size) {
+		release_firmware(fw);
+		return -EFBIG;
+	}
+	memset_io(data->sram, 0, data->sram_size);
+	memcpy_toio(data->sram, fw->data, fw->size);
+	release_firmware(fw);
+
+	ret = request_firmware(&fw, "calliope_dram.bin", dev);
+	if (ret)
+		return ret;
+	if (fw->size > DRAM_FIRMWARE_SIZE) {
+		release_firmware(fw);
+		return -EFBIG;
+	}
+	memset(data->dram, 0, DRAM_FIRMWARE_SIZE);
+	memcpy(data->dram, fw->data, fw->size);
+	release_firmware(fw);
+
+	ret = request_firmware(&fw, "calliope_iva.bin", dev);
+	if (!ret) {
+		if (fw->size <= IVA_FIRMWARE_SIZE)
+			memcpy(data->iva, fw->data, fw->size);
+		release_firmware(fw);
+	} else {
+		dev_warn(dev, "no IVA firmware: %d\n", ret);
+	}
+
+	/* Make the copies visible to the A7 before it starts. */
+	wmb();
+	return 0;
+}
+
+int abox_boot(struct abox_data *data)
+{
+	struct device *dev = data->dev;
+	unsigned int val;
+	int i, ret;
+
+	mutex_lock(&data->boot_lock);
+	if (data->state == ABOX_STATE_RUNNING) {
+		ret = 0;
+		goto out;
+	}
+
+	abox_cpu_enable(data, false);
+	abox_cpu_power(data, false);
+
+	if (data->secure_gic) {
+		regmap_write(data->pmu, PMU_ABOX_MAGIC, 0);
+		{
+			struct arm_smccc_res res;
+
+			arm_smccc_smc(SMC_ABOX_PREPARE, 0, 0, 0, 0, 0, 0, 0,
+				      &res);
+		}
+		for (i = 1000; i; i--) {
+			regmap_read(data->pmu, PMU_ABOX_MAGIC, &val);
+			if (val == PMU_ABOX_MAGIC_VALUE)
+				break;
+		}
+		if (val != PMU_ABOX_MAGIC_VALUE)
+			dev_warn(dev, "ABOX magic timeout\n");
+		abox_cpu_enable(data, false);
+		abox_cpu_power(data, false);
+	}
+
+	writel(0x1, data->sysreg + SYSREG_MISC_CON);
+	writel(0x1, data->sysreg + SYSREG_L2_CACHE_CON);
+
+	abox_gic_init(data);
+
+	ret = abox_load_firmware(data);
+	if (ret) {
+		dev_err(dev, "failed to load firmware: %d\n", ret);
+		goto out;
+	}
+
+	/* Keep DRAM out of self-refresh while the A7 boots. */
+	writel(ABOX_SYSPOWER_CTRL_ON, data->sfr + ABOX_SYSPOWER_CTRL);
+
+	if (!abox_sysmmu_enabled(data)) {
+		dev_err(dev, "SysMMU is not translating, not starting the A7\n");
+		ret = -ENODEV;
+		goto out;
+	}
+
+	reinit_completion(&data->boot_done);
+	data->state = ABOX_STATE_BOOTING;
+	abox_cpu_power(data, true);
+	ret = abox_cpu_enable(data, true);
+	if (ret) {
+		dev_err(dev, "A7 did not power up\n");
+		goto fail;
+	}
+
+	/* Release the ABOX pads from retention. */
+	regmap_update_bits(data->pmu, PMU_PAD_RETENTION_ABOX_OPTION,
+			   BIT(28), BIT(28));
+	regmap_update_bits(data->pmu, PMU_GPIO_MODE_ABOX_SYS_PWR, BIT(0),
+			   BIT(0));
+
+	if (!wait_for_completion_timeout(&data->boot_done,
+					 msecs_to_jiffies(BOOT_DONE_TIMEOUT_MS))) {
+		regmap_read(data->pmu, PMU_ABOX_CA7_STATUS, &val);
+		dev_err(dev, "no boot-done from firmware (A7 status %#x, pc %#x)\n",
+			val, readl(data->sfr + ABOX_CA7_PC));
+		ret = -ETIMEDOUT;
+		goto fail;
+	}
+
+	if (data->fw_version >> 24 == 'A')
+		dev_warn(dev, "firmware reports an incompatible version\n");
+
+	ret = abox_ipc_system(data, ABOX_RESUME, 0, 0, 0);
+	if (ret)
+		dev_warn(dev, "resume IPC failed: %d\n", ret);
+	goto out;
+
+fail:
+	data->state = ABOX_STATE_OFF;
+	abox_cpu_enable(data, false);
+	abox_cpu_power(data, false);
+out:
+	mutex_unlock(&data->boot_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(abox_boot);
+
+static ssize_t boot_store(struct device *dev, struct device_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct abox_data *data = dev_get_drvdata(dev);
+	int ret = abox_boot(data);
+
+	return ret ? ret : count;
+}
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct abox_data *data = dev_get_drvdata(dev);
+	unsigned int status = 0;
+
+	regmap_read(data->pmu, PMU_ABOX_CA7_STATUS, &status);
+	return sysfs_emit(buf, "state %d version %#x a7-status %#x pc %#x\n",
+			  data->state, data->fw_version, status,
+			  readl(data->sfr + ABOX_CA7_PC));
+}
+
+
+static DEVICE_ATTR_WO(boot);
+static DEVICE_ATTR_RO(state);
+
+static struct attribute *abox_attrs[] = {
+	&dev_attr_boot.attr,
+	&dev_attr_state.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(abox);
+
+static void abox_teardown(void *arg)
+{
+	struct abox_data *data = arg;
+
+	data->state = ABOX_STATE_OFF;
+	data->log = NULL;
+	cancel_delayed_work_sync(&data->log_work);
+	cancel_work_sync(&data->fault_work);
+	abox_cpu_enable(data, false);
+	abox_cpu_power(data, false);
+	iommu_detach_device(data->domain, data->dev);
+	iommu_domain_free(data->domain);
+	pm_runtime_put(data->dev);
+}
+
+static int abox_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct abox_data *data;
+	struct resource *res;
+	int irq, ret;
+
+	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	data->dev = dev;
+	platform_set_drvdata(pdev, data);
+	mutex_init(&data->boot_lock);
+	spin_lock_init(&data->ipc_lock);
+	init_completion(&data->boot_done);
+	INIT_DELAYED_WORK(&data->log_work, abox_log_work);
+	INIT_WORK(&data->fault_work, abox_fault_work);
+	spin_lock_init(&data->fault_lock);
+
+	data->sfr = devm_platform_ioremap_resource_byname(pdev, "sfr");
+	if (IS_ERR(data->sfr))
+		return PTR_ERR(data->sfr);
+	data->cmu = devm_platform_ioremap_resource_byname(pdev, "cmu");
+	if (IS_ERR(data->cmu))
+		return PTR_ERR(data->cmu);
+	data->sysreg = devm_platform_ioremap_resource_byname(pdev, "sysreg");
+	if (IS_ERR(data->sysreg))
+		return PTR_ERR(data->sysreg);
+	data->sram = devm_platform_get_and_ioremap_resource(pdev, 2, &res);
+	if (IS_ERR(data->sram))
+		return PTR_ERR(data->sram);
+	data->sram_size = resource_size(res);
+	data->gicd = devm_platform_get_and_ioremap_resource(pdev, 3, &res);
+	if (IS_ERR(data->gicd))
+		return PTR_ERR(data->gicd);
+	data->gicd_phys = res->start;
+	data->gicc = devm_platform_get_and_ioremap_resource(pdev, 4, &res);
+	if (IS_ERR(data->gicc))
+		return PTR_ERR(data->gicc);
+	data->gicc_phys = res->start;
+
+	data->pmu = syscon_regmap_lookup_by_phandle(dev->of_node,
+						    "samsung,pmu-syscon");
+	if (IS_ERR(data->pmu))
+		return dev_err_probe(dev, PTR_ERR(data->pmu), "no PMU\n");
+
+	abox_cmu_init(data);
+
+	/*
+	 * Only EVT0 silicon has a secure-only ABOX GIC (downstream checks the
+	 * chip id, which faults when read from here). Retail phones are EVT1.
+	 */
+	data->secure_gic = false;
+
+	/*
+	 * exynos-iommu only enables translation while the master is
+	 * runtime-active (it resumes the SysMMU through the device link).
+	 */
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret)
+		return ret;
+
+	ret = abox_setup_memory(data);
+	if (ret) {
+		pm_runtime_put(dev);
+		return ret;
+	}
+
+	/* The A7 must be held off until the firmware is in place. */
+	abox_cpu_enable(data, false);
+	abox_cpu_power(data, false);
+
+	ret = devm_add_action_or_reset(dev, abox_teardown, data);
+	if (ret)
+		return ret;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_threaded_irq(dev, irq, NULL, abox_irq_thread,
+					IRQF_ONESHOT, dev_name(dev), data);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "ABOX %#x, carve-out %pa, secure GIC %d\n",
+		 readl(data->sfr + ABOX_VERSION), &data->dram_phys,
+		 data->secure_gic);
+
+	return abox_pcm_register(data);
+}
+
+static const struct of_device_id abox_of_match[] = {
+	{ .compatible = "samsung,exynos8895-abox" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, abox_of_match);
+
+static struct platform_driver abox_driver = {
+	.probe = abox_probe,
+	.driver = {
+		.name = "samsung-abox",
+		.of_match_table = abox_of_match,
+		.dev_groups = abox_groups,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(abox_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos8895 ABOX audio subsystem");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE("calliope_sram.bin");
+MODULE_FIRMWARE("calliope_dram.bin");
+MODULE_FIRMWARE("calliope_iva.bin");
