From 10e2c20d5a5a28047b65d66894040ddcc385ab93 Mon Sep 17 00:00:00 2001
From: Athul <athulkrishnan97@users.noreply.github.com>
Date: Fri, 9 Oct 2026 16:31:27 +0100
Subject: [PATCH 1/3] ASoC: samsung: abox: back the VSS window and retry resume
 after boot

The Calliope firmware writes into the voice firmware (VSS) window at
IOVA 0xa0000000 as soon as it boots. Downstream maps the modem's VSS
memory there; with nothing mapped, every access is a SysMMU fault and
the fault storm (thousands of console lines from IRQ context) stalls
the system when PulseAudio first opens the card during boot.

Map the whole 8 MiB window to the dummy page at probe, and retry the
resume IPC for a short while: right after boot-done the firmware may
not have acknowledged it yet.
---
 sound/soc/samsung/abox/abox.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/sound/soc/samsung/abox/abox.c b/sound/soc/samsung/abox/abox.c
index 1756b8a50..4af658ce0 100644
--- a/sound/soc/samsung/abox/abox.c
+++ b/sound/soc/samsung/abox/abox.c
@@ -82,6 +82,8 @@
 #define DMA_BUFFERS_SIZE		(SZ_32M)
 #define IOVA_IVA_FIRMWARE		0x90000000
 #define IVA_FIRMWARE_SIZE		SZ_512K
+#define IOVA_VSS_FIRMWARE		0xa0000000
+#define VSS_FIRMWARE_SIZE		SZ_8M
 
 /* Mailbox in the ABOX SRAM */
 #define IPC_TX_OFFSET			0x30000
@@ -473,6 +475,7 @@ static int abox_setup_memory(struct abox_data *data)
 	struct device *dev = data->dev;
 	struct resource res;
 	int prot = IOMMU_READ | IOMMU_WRITE;
+	unsigned long iova;
 	int ret;
 
 	ret = of_reserved_mem_region_to_resource(dev->of_node, 0, &res);
@@ -538,6 +541,17 @@ static int abox_setup_memory(struct abox_data *data)
 	if (!ret)
 		ret = abox_map(data, CHIPID_BASE, data->scratch_phys, SZ_4K,
 			       IOMMU_READ);
+	/*
+	 * Downstream maps the modem's voice firmware (VSS) here. There is no
+	 * modem support, but the firmware writes into this window as soon as
+	 * it boots; left unmapped, that is a SysMMU fault storm which can
+	 * lock up the phone. Back the window with the dummy page.
+	 */
+	for (iova = IOVA_VSS_FIRMWARE;
+	     !ret && iova < IOVA_VSS_FIRMWARE + VSS_FIRMWARE_SIZE;
+	     iova += SZ_4K)
+		ret = abox_map(data, iova, data->scratch_phys + SZ_4K, SZ_4K,
+			       prot);
 	if (ret) {
 		iommu_detach_device(data->domain, dev);
 		iommu_domain_free(data->domain);
@@ -668,7 +682,13 @@ int abox_boot(struct abox_data *data)
 	if (data->fw_version >> 24 == 'A')
 		dev_warn(dev, "firmware reports an incompatible version\n");
 
-	ret = abox_ipc_system(data, ABOX_RESUME, 0, 0, 0);
+	/* The firmware may still be busy setting up right after boot-done. */
+	for (i = 0; i < 20; i++) {
+		ret = abox_ipc_system(data, ABOX_RESUME, 0, 0, 0);
+		if (ret != -ETIMEDOUT)
+			break;
+		msleep(5);
+	}
 	if (ret)
 		dev_warn(dev, "resume IPC failed: %d\n", ret);
 	goto out;
-- 
