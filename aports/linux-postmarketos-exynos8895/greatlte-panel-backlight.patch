From 1c010fceec328896b7b12b296a2c2f32f218f0bd Mon Sep 17 00:00:00 2001
From: Athul <athulkrishnan97@users.noreply.github.com>
Date: Fri, 9 Oct 2026 16:31:27 +0100
Subject: [PATCH 3/3] drm/panel: s6e3ha6: add brightness control through AOR

The panel has no backlight, so the compositor had to dim in software,
an extra full-screen pass per frame. Register a backlight device that
sets the AMOLED off ratio (0xb1, latched with 0xf7) on top of the gamma
the bootloader programmed, from 0x000c (full) to 0x0b75 (the downstream
lowest level), on a square-law curve.
---
 drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c | 60 ++++++++++++++++++-
 1 file changed, 59 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c
index 024bed4ff..c122fdd1f 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c
@@ -10,6 +10,7 @@
  * Copyright (c) 2026 The postmarketOS project
  */
 
+#include <linux/backlight.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
@@ -28,6 +29,7 @@ struct s6e3ha6 {
 	struct mipi_dsi_device *dsi;
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+	struct backlight_device *bl;
 	bool initialized;
 	bool asleep;
 };
@@ -94,6 +96,49 @@ static int s6e3ha6_power_on(struct s6e3ha6 *priv)
 	return 0;
 }
 
+/*
+ * Brightness through AOR (AMOLED off ratio, 0xb1): the number of lines per
+ * frame the pixels are kept dark. Gamma stays at what the bootloader set,
+ * so this only ever dims from there; the full downstream scheme also
+ * reprograms gamma per luminance from the MTP calibration data.
+ */
+#define S6E3HA6_AOR_MIN		0x000c	/* downstream at full brightness */
+#define S6E3HA6_AOR_MAX		0x0b75	/* downstream at the lowest level */
+#define S6E3HA6_BL_MAX		1023
+
+static int s6e3ha6_set_brightness(struct backlight_device *bl)
+{
+	struct s6e3ha6 *priv = bl_get_data(bl);
+	struct mipi_dsi_multi_context ctx = { .dsi = priv->dsi };
+	u64 level = backlight_get_brightness(bl);
+	u16 aor;
+	u8 cmd[3];
+
+	if (!priv->initialized || priv->asleep)
+		return 0;
+
+	/* Square law, so the slider feels even at the dark end. */
+	level = level * level;
+	aor = S6E3HA6_AOR_MAX -
+	      div_u64(level * (S6E3HA6_AOR_MAX - S6E3HA6_AOR_MIN),
+		      S6E3HA6_BL_MAX * S6E3HA6_BL_MAX);
+
+	priv->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	s6e3ha6_key2_on(&ctx);
+	cmd[0] = 0xb1;
+	cmd[1] = aor >> 8;
+	cmd[2] = aor & 0xff;
+	mipi_dsi_dcs_write_buffer_multi(&ctx, cmd, sizeof(cmd));
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xf7, 0x03);	/* latch */
+	s6e3ha6_key2_off(&ctx);
+
+	return ctx.accum_err;
+}
+
+static const struct backlight_ops s6e3ha6_bl_ops = {
+	.update_status = s6e3ha6_set_brightness,
+};
+
 static int s6e3ha6_read_id(struct s6e3ha6 *priv, u8 *id)
 {
 	struct mipi_dsi_device *dsi = priv->dsi;
@@ -225,8 +270,10 @@ static int s6e3ha6_prepare(struct drm_panel *panel)
 	}
 
 	mipi_dsi_dcs_set_display_on_multi(&ctx);
+	if (ctx.accum_err)
+		return ctx.accum_err;
 
-	return ctx.accum_err;
+	return s6e3ha6_set_brightness(priv->bl);
 }
 
 /*
@@ -326,6 +373,17 @@ static int s6e3ha6_probe(struct mipi_dsi_device *dsi)
 	priv->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, priv);
 
+	priv->bl = devm_backlight_device_register(dev, dev_name(dev), dev, priv,
+						  &s6e3ha6_bl_ops,
+						  &(const struct backlight_properties) {
+		.type = BACKLIGHT_RAW,
+		.brightness = S6E3HA6_BL_MAX,
+		.max_brightness = S6E3HA6_BL_MAX,
+	});
+	if (IS_ERR(priv->bl))
+		return dev_err_probe(dev, PTR_ERR(priv->bl),
+				     "failed to register backlight\n");
+
 	dsi->lanes = 4;
 	dsi->format = MIPI_DSI_FMT_RGB888;
 	dsi->mode_flags = MIPI_DSI_MODE_LPM;
-- 
2.53.0

