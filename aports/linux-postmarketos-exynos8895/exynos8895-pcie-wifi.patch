+/*
+ * s2mps17.h - Register definitions for the Samsung S2MPS17 PMIC
+ *
+ * The S2MPS17 is reachable over a Samsung SPEEDY bus and exposes several
+ * register pages, selected by the slave address:
+ *   0x00: top level (chip id, interrupt source)
+ *   0x01: PMIC (bucks, LDOs, interrupts) - the page modelled here
+ *   0x02: RTC
+ *   0x0f: debug
+ *
