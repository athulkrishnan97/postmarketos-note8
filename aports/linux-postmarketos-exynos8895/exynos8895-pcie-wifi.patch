+/*
+ * The Broadcom device is used with legacy INTx interrupts only; keep
+ * the designware core from instantiating an (unserviceable) MSI domain.
+ */
+static int exynos8895_pcie_msi_init(struct dw_pcie_rp *pp)
+{
+	return 0;
+}
