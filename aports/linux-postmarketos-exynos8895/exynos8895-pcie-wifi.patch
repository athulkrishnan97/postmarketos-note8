diff --git a/drivers/i2c/busses/i2c-speedy.c b/drivers/i2c/busses/i2c-speedy.c
new file mode 100644
index 000000000..1dedba7fb
--- /dev/null
+++ b/drivers/i2c/busses/i2c-speedy.c
@@ -0,0 +1,453 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Driver for the Samsung SPEEDY bus controller (Serial Protocol in an
+ * EffEctive Digital waY), found e.g. in the Exynos 8895.
+ *
+ * SPEEDY is a Samsung proprietary 1-wire serial bus.  A transaction is
+ * a single packet, programmed through the SPEEDY_CMD register:
+ *
+ *	CMD[18:15] = device (slave page, 4 bits)
+ *	CMD[14: 7] = register offset (8 bits)
+ *	CMD[   19] = access type (0 burst / 1 random, single byte)
+ *	CMD[   20] = direction (0 read / 1 write)
+ *
+ * The transfer length is programmed in SPEEDY_FIFO_CTRL (RX count in
+ * bits [4:0], TX count in bits [12:8]); the payload byte is pushed to
+ * SPEEDY_TX_DATA after the command, and a read result is pulled from
+ * SPEEDY_RX_DATA once SPEEDY_INT_STATUS bit 0 (TRANSFER_DONE) shows up.
+ * This register-level sequence follows the exynos-speedy host
+ * controller driver by Markuss Broks / Maksym Holovach (linux-arm-kernel,
+ * December 2024); the Exynos 8895 uses the same SPEEDY block as the
+ * Exynos 9810 that driver targets, hence the compatible
+ * "samsung,exynos-speedy" instead of the 9810-specific name.
+ *
+ * The I2C adapter fuses the regmap-style "write register offset, then
+ * read data" message pair into one SPEEDY transaction, taking the
+ * register offset from the first byte of the write message.  Only
+ * single-byte random transactions are used; larger regmap transfers are
+ * decomposed into per-byte transactions so the hardware sees exactly
+ * the sequence the reference driver proves.
+ *
+ * All waits are bounded by a hard iteration count plus a jiffies
+ * deadline.  The only recovery after a failure is a register dump and a
+ * controller reset; no register is ever written while a transaction is
+ * in flight beyond that, so a misbehaving slave costs time, never a
+ * hang.
+ *
+ * Copyright (C) 2015 Samsung Electronics Ltd.
+ *	Youngmin Nam <youngmin.nam@samsung.com>
+ * Copyright (C) 2024 Markuss Broks <markuss.broks@gmail.com>
+ * Copyright (C) 2024 Maksym Holovach <nergzd723@gmail.com>
+ * Copyright (C) 2026 Linux Exynos community
+ */
+
+#include <linux/atomic.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/i2c.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+
+/* SPEEDY register map */
+#define SPEEDY_CTRL				0x000
+#define SPEEDY_FIFO_CTRL			0x004
+#define SPEEDY_CMD				0x008
+#define SPEEDY_INT_ENABLE			0x00C
+#define SPEEDY_INT_STATUS			0x010
+#define SPEEDY_FIFO_STATUS			0x030
+#define SPEEDY_TX_DATA				0x034
+#define SPEEDY_RX_DATA				0x038
+#define SPEEDY_CTRL_STATUS			0x104
+
+/* SPEEDY_CTRL bits */
+#define SPEEDY_ENABLE				(1 << 0)
+#define SPEEDY_REMOTE_RESET_REQ			(1 << 30)
+#define SPEEDY_SW_RST				(1 << 31)
+
+/* SPEEDY_FIFO_CTRL bits: transfer lengths (and FIFO reset) */
+#define SPEEDY_FIFO_RESET			(1 << 31)
+#define SPEEDY_RX_LENGTH(n)			(((n) & 0x1f) << 0)
+#define SPEEDY_TX_LENGTH(n)			(((n) & 0x1f) << 8)
+
+/* SPEEDY_CMD bits */
+#define SPEEDY_DEVICE(x)			(((x) & 0xf) << 15)
+#define SPEEDY_ADDRESS(x)			(((x) & 0xff) << 7)
+#define SPEEDY_ACCESS_RANDOM			(1 << 19)
+#define SPEEDY_DIRECTION_READ			(0 << 20)
+#define SPEEDY_DIRECTION_WRITE			(1 << 20)
+
+/* SPEEDY_INT_ENABLE / SPEEDY_INT_STATUS bits */
+#define SPEEDY_TRANSFER_DONE			(1 << 0)
+#define SPEEDY_TIMEOUT_CMD			(1 << 1)
+#define SPEEDY_TIMEOUT_STANDBY			(1 << 2)
+#define SPEEDY_TIMEOUT_DATA			(1 << 3)
+#define SPEEDY_FIFO_TX_ALMOST_EMPTY		(1 << 4)
+#define SPEEDY_FIFO_RX_ALMOST_FULL		(1 << 8)
+#define SPEEDY_RX_FIFO_INT_TRAILER		(1 << 9)
+#define SPEEDY_RX_MODEBIT_ERR			(1 << 16)
+#define SPEEDY_RX_GLITCH_ERR			(1 << 17)
+#define SPEEDY_RX_ENDBIT_ERR			(1 << 18)
+#define SPEEDY_TX_LINE_BUSY_ERR			(1 << 20)
+#define SPEEDY_TX_STOPBIT_ERR			(1 << 21)
+#define SPEEDY_REMOTE_RESET_REQ_EN		(1 << 31)
+
+/* Error bits that terminate a transfer as -EIO. */
+#define SPEEDY_INT_ERRORS		(SPEEDY_TIMEOUT_CMD |		\
+				 SPEEDY_TIMEOUT_STANDBY |	\
+				 SPEEDY_TIMEOUT_DATA |		\
+				 SPEEDY_RX_MODEBIT_ERR |	\
+				 SPEEDY_RX_GLITCH_ERR |		\
+				 SPEEDY_RX_ENDBIT_ERR |		\
+				 SPEEDY_TX_LINE_BUSY_ERR |	\
+				 SPEEDY_TX_STOPBIT_ERR)
+
+/* Bound every wait: 50 ms matches the reference driver's timeout. */
+#define SPEEDY_XFER_TIMEOUT_US	(50 * USEC_PER_MSEC)
+
+struct exynos_speedy {
+	struct i2c_adapter	adap;
+	void __iomem		*regs;
+	struct clk		*clk;
+	struct device		*dev;
+};
+
+static void speedy_int_clear(struct exynos_speedy *speedy)
+{
+	writel(0xFFFFFFFF, speedy->regs + SPEEDY_INT_STATUS);
+	udelay(10);
+}
+
+static void speedy_dump_registers(struct exynos_speedy *speedy)
+{
+	dev_err(speedy->dev,
+		"SPEEDY registers: CTRL 0x%08x FIFO_CTRL 0x%08x CMD 0x%08x INT_EN 0x%08x INT_STAT 0x%08x FIFO_STAT 0x%08x CTRL_STAT 0x%08x\n",
+		readl(speedy->regs + SPEEDY_CTRL),
+		readl(speedy->regs + SPEEDY_FIFO_CTRL),
+		readl(speedy->regs + SPEEDY_CMD),
+		readl(speedy->regs + SPEEDY_INT_ENABLE),
+		readl(speedy->regs + SPEEDY_INT_STATUS),
+		readl(speedy->regs + SPEEDY_FIFO_STATUS),
+		readl(speedy->regs + SPEEDY_CTRL_STATUS));
+}
+
+/*
+ * Reset the controller (called with no transaction in flight).  The
+ * reset bit is self-clearing on this IP; clear it by hand as well (and
+ * wait, bounded) so the driver works even on a revision where it is
+ * not.  SPEEDY_ENABLE does not survive the reset, set it again.
+ */
+static void speedy_swreset(struct exynos_speedy *speedy)
+{
+	unsigned long deadline = jiffies + usecs_to_jiffies(1000) + 1;
+	unsigned int iter = 0;
+
+	writel(readl(speedy->regs + SPEEDY_CTRL) | SPEEDY_SW_RST,
+	       speedy->regs + SPEEDY_CTRL);
+	udelay(20);
+
+	/* Wait, bounded, for the self-clearing reset bit; clear it by
+	 * hand as well so the driver works even where it is not
+	 * self-clearing.
+	 */
+	while (iter++ < 10000) {
+		if (!(readl(speedy->regs + SPEEDY_CTRL) & SPEEDY_SW_RST))
+			break;
+		if (time_after(jiffies, deadline)) {
+			writel(readl(speedy->regs + SPEEDY_CTRL) & ~SPEEDY_SW_RST,
+			       speedy->regs + SPEEDY_CTRL);
+			break;
+		}
+		udelay(5);
+	}
+	udelay(20);
+
+	writel(readl(speedy->regs + SPEEDY_CTRL) | SPEEDY_ENABLE,
+	       speedy->regs + SPEEDY_CTRL);
+}
+
+/* Recovery after a failed transaction, called with nothing in flight. */
+static int speedy_recover(struct exynos_speedy *speedy, int ret)
+{
+	speedy_dump_registers(speedy);
+	speedy_swreset(speedy);
+
+	return ret;
+}
+
+/*
+ * Front-end, mirroring the reference driver: reset the FIFO, program
+ * the transfer length (one byte each way), clear stale interrupt
+ * status, enable the interrupts used for completion.
+ */
+static void speedy_setup_xfer(struct exynos_speedy *speedy, bool read)
+{
+	writel(SPEEDY_FIFO_RESET, speedy->regs + SPEEDY_FIFO_CTRL);
+	udelay(10);
+	writel(SPEEDY_RX_LENGTH(1) | SPEEDY_TX_LENGTH(1),
+	       speedy->regs + SPEEDY_FIFO_CTRL);
+
+	speedy_int_clear(speedy);
+
+	if (read) {
+		writel(SPEEDY_TRANSFER_DONE | SPEEDY_FIFO_RX_ALMOST_FULL |
+		       SPEEDY_RX_FIFO_INT_TRAILER | SPEEDY_RX_MODEBIT_ERR |
+		       SPEEDY_RX_GLITCH_ERR | SPEEDY_RX_ENDBIT_ERR |
+		       SPEEDY_REMOTE_RESET_REQ_EN,
+		       speedy->regs + SPEEDY_INT_ENABLE);
+	} else {
+		writel(SPEEDY_TRANSFER_DONE | SPEEDY_FIFO_TX_ALMOST_EMPTY |
+		       SPEEDY_TX_LINE_BUSY_ERR | SPEEDY_TX_STOPBIT_ERR |
+		       SPEEDY_REMOTE_RESET_REQ_EN,
+		       speedy->regs + SPEEDY_INT_ENABLE);
+	}
+}
+
+/*
+ * Wait for a transfer to finish, bounded.  Any error bit or a timeout
+ * triggers the single recovery path (dump + reset).
+ */
+static int speedy_wait_done(struct exynos_speedy *speedy)
+{
+	unsigned long deadline = jiffies +
+				 usecs_to_jiffies(SPEEDY_XFER_TIMEOUT_US) + 1;
+	unsigned int iter = 0;
+	u32 status;
+
+	while (iter++ < 100000) {
+		status = readl(speedy->regs + SPEEDY_INT_STATUS);
+		if (status & SPEEDY_INT_ERRORS)
+			return speedy_recover(speedy, -EIO);
+		if (status & SPEEDY_TRANSFER_DONE)
+			return 0;
+		if (time_after(jiffies, deadline))
+			break;
+		udelay(5);
+	}
+
+	return speedy_recover(speedy, -ETIMEDOUT);
+}
+
+/* One single-byte random transaction.  @full is the packed 12-bit
+ * address: device[3:0] in bits [11:8], register[7:0] in bits [7:0].
+ */
+static int speedy_do_read(struct exynos_speedy *speedy, u16 full, u8 *buf)
+{
+	u32 cmd;
+	int ret;
+
+	speedy_setup_xfer(speedy, true);
+
+	cmd = SPEEDY_ACCESS_RANDOM | SPEEDY_DIRECTION_READ |
+	      SPEEDY_DEVICE(full >> 8) | SPEEDY_ADDRESS(full & 0xff);
+	writel(cmd, speedy->regs + SPEEDY_CMD);
+
+	ret = speedy_wait_done(speedy);
+	if (ret)
+		return ret;
+
+	*buf = readl(speedy->regs + SPEEDY_RX_DATA);
+	speedy_int_clear(speedy);
+
+	return 0;
+}
+
+static int speedy_do_write(struct exynos_speedy *speedy, u16 full, u8 val)
+{
+	u32 cmd;
+	int ret;
+
+	speedy_setup_xfer(speedy, false);
+
+	cmd = SPEEDY_ACCESS_RANDOM | SPEEDY_DIRECTION_WRITE |
+	      SPEEDY_DEVICE(full >> 8) | SPEEDY_ADDRESS(full & 0xff);
+	writel(cmd, speedy->regs + SPEEDY_CMD);
+
+	/* Payload after the command, like the reference driver. */
+	writel(val, speedy->regs + SPEEDY_TX_DATA);
+
+	ret = speedy_wait_done(speedy);
+	if (ret)
+		return ret;
+
+	speedy_int_clear(speedy);
+
+	return 0;
+}
+
+static int exynos_speedy_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+			      int num)
+{
+	struct exynos_speedy *speedy = adap->algo_data;
+	u16 base;
+	int ret;
+	unsigned int i, len;
+
+	{
+		static atomic_t bootlog = ATOMIC_INIT(64);
+
+		if (atomic_dec_if_positive(&bootlog) >= 0)
+			pr_info("speedy: xfer num=%d flags0=0x%x len0=%d addr0=0x%02x%s\n",
+				num, msgs[0].flags, msgs[0].len, msgs[0].addr,
+				num > 1 ? " +RD" : "");
+	}
+
+	/*
+	 * regmap "read": write message carrying the register offset, then
+	 * a read message.  Fuse them: the register offset becomes the
+	 * SPEEDY register address, the transfer is one transaction per
+	 * byte.
+	 */
+	if (num == 2 && !(msgs[0].flags & I2C_M_RD) && msgs[0].len == 1 &&
+	    (msgs[1].flags & I2C_M_RD)) {
+		base = ((msgs[0].addr & 0xF) << 8) | msgs[0].buf[0];
+		len = msgs[1].len;
+
+		for (i = 0; i < len; i++) {
+			ret = speedy_do_read(speedy, base + i, &msgs[1].buf[i]);
+			if (ret)
+				return ret;
+		}
+
+		return num;
+	}
+
+	/* regmap "write": register offset in byte 0, payload behind it. */
+	if (num == 1 && !(msgs[0].flags & I2C_M_RD) && msgs[0].len >= 2) {
+		base = ((msgs[0].addr & 0xF) << 8) | msgs[0].buf[0];
+		len = msgs[0].len - 1;
+
+		for (i = 0; i < len; i++) {
+			ret = speedy_do_write(speedy, base + i, msgs[0].buf[1 + i]);
+			if (ret)
+				return ret;
+		}
+
+		return num;
+	}
+
+	/* Single read without a register phase (e.g. SMBus receive byte):
+	 * synthesize register offset 0. */
+	if (num == 1 && (msgs[0].flags & I2C_M_RD)) {
+		base = (msgs[0].addr & 0xF) << 8;
+		len = msgs[0].len;
+
+		for (i = 0; i < len; i++) {
+			ret = speedy_do_read(speedy, base + i, &msgs[0].buf[i]);
+			if (ret)
+				return ret;
+		}
+
+		return num;
+	}
+
+	dev_err_ratelimited(speedy->dev,
+			    "unsupported transfer: num %d, len %d, flags 0x%x\n",
+			    num, msgs[0].len, msgs[0].flags);
+
+	return -EOPNOTSUPP;
+}
+
+static u32 exynos_speedy_func(struct i2c_adapter *adap)
+{
+	return I2C_FUNC_I2C | I2C_FUNC_SMBUS_EMUL;
+}
+
+static const struct i2c_algorithm exynos_speedy_algorithm = {
+	.master_xfer	= exynos_speedy_xfer,
+	.functionality	= exynos_speedy_func,
+};
+
+static int exynos_speedy_probe(struct platform_device *pdev)
+{
+	struct exynos_speedy *speedy;
+	struct resource *mem;
+	int ret;
+
+	speedy = devm_kzalloc(&pdev->dev, sizeof(*speedy), GFP_KERNEL);
+	if (!speedy)
+		return -ENOMEM;
+
+	speedy->dev = &pdev->dev;
+
+	speedy->clk = devm_clk_get(&pdev->dev, "gate_speedy");
+	if (IS_ERR(speedy->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(speedy->clk),
+				     "cannot get gate_speedy clock\n");
+
+	/* The clock must be running before any SFR is touched. */
+	ret = clk_prepare_enable(speedy->clk);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "cannot enable gate_speedy clock\n");
+
+	mem = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	speedy->regs = devm_ioremap_resource(&pdev->dev, mem);
+	if (IS_ERR(speedy->regs)) {
+		ret = PTR_ERR(speedy->regs);
+		goto err_clk;
+	}
+
+	/* Start from a clean slate, like the reference driver. */
+	speedy_int_clear(speedy);
+	speedy_swreset(speedy);
+
+	snprintf(speedy->adap.name, sizeof(speedy->adap.name), "exynos-speedy");
+	speedy->adap.owner = THIS_MODULE;
+	speedy->adap.algo = &exynos_speedy_algorithm;
+	speedy->adap.algo_data = speedy;
+	speedy->adap.dev.parent = &pdev->dev;
+	speedy->adap.dev.of_node = pdev->dev.of_node;
+	speedy->adap.retries = 0;
+
+	platform_set_drvdata(pdev, speedy);
+
+	ret = i2c_add_adapter(&speedy->adap);
+	if (ret) {
+		dev_err(&pdev->dev, "failed to register adapter\n");
+		goto err_clk;
+	}
+
+	dev_info(&pdev->dev, "SPEEDY adapter registered\n");
+
+	return 0;
+
+err_clk:
+	clk_disable_unprepare(speedy->clk);
+	return ret;
+}
+
+static void exynos_speedy_remove(struct platform_device *pdev)
+{
+	struct exynos_speedy *speedy = platform_get_drvdata(pdev);
+
+	i2c_del_adapter(&speedy->adap);
+	clk_disable_unprepare(speedy->clk);
+}
+
+static const struct of_device_id exynos_speedy_match[] = {
+	{ .compatible = "samsung,exynos-speedy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos_speedy_match);
+
+static struct platform_driver exynos_speedy_driver = {
+	.probe	= exynos_speedy_probe,
+	.remove	= exynos_speedy_remove,
+	.driver	= {
+		.name	= "exynos-speedy",
+		.of_match_table = exynos_speedy_match,
+	},
+};
+module_platform_driver(exynos_speedy_driver);
+
+MODULE_DESCRIPTION("Exynos SPEEDY bus adapter");
+MODULE_AUTHOR("Youngmin Nam <youngmin.nam@samsung.com>");
+MODULE_AUTHOR("Markuss Broks <markuss.broks@gmail.com>");
+MODULE_LICENSE("GPL");
diff --git a/drivers/mfd/sec-common.c b/drivers/mfd/sec-common.c
index bd8b5f968..e00d42169 100644
--- a/drivers/mfd/sec-common.c
