+#define PCIE_8895_ELBI_APP_LTSSM_ENABLE	0x02c
+#define PCIE_8895_ELBI_L1_BUG_FIX	0x038
+#define PCIE_8895_ELBI_RDLH_LINKUP	0x074
+#define PCIE_8895_ELBI_APP_REQ_EXIT_L1	0x0f4
+#define PCIE_8895_ELBI_LINKDOWN_RST_CTRL_SEL 0x1b8
+#define PCIE_8895_ELBI_SOFT_CORE_RESET	0x1d0
+#define PCIE_8895_ELBI_STATE_HISTORY	0x274
+#define PCIE_8895_ELBI_QCH_SEL		0x2c8
+
+#include "pcie-8895-tables.h"
