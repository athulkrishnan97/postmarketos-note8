+	.regulators_node = of_match_ptr("regulators"),			\
+	.ops		= &s2mps15_reg_buck_ops,			\
+	.type		= REGULATOR_VOLTAGE,				\
+	.owner		= THIS_MODULE,					\
+	.linear_ranges	= s2mps17_buck_voltage_ranges,			\
+	.n_linear_ranges = ARRAY_SIZE(s2mps17_buck_voltage_ranges),	\
+	.n_voltages	= S2MPS17_BUCK_N_VOLTAGES,			\
+	.ramp_delay	= 12500,					\
+	.vsel_reg	= S2MPS17_REG_B1OUT + ((num) - 1) * 2,		\
+	.vsel_mask	= S2MPS17_BUCK_VSEL_MASK,			\
+	.enable_reg	= S2MPS17_REG_B1CTRL + ((num) - 1) * 2,	\
+	.enable_mask	= S2MPS17_ENABLE_MASK,				\
+}
