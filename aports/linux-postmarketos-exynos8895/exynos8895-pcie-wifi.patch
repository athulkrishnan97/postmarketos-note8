+static int exynos8895_pcie_host_init(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct exynos_pcie *ep = to_exynos_pcie(pci);
+	void __iomem *phy = ioremap(0x116d0000, 0x400);
+	void __iomem *pcs = ioremap(0x116c0000, 0x200);
+	void __iomem *sysreg = ioremap(0x11421044, 0x10);
+	void __iomem *pmu = ioremap(0x16480000, 0x1000);
+	u32 val;
+	int i;
+
+	pp->bridge->ops = &exynos_pci_ops;
+
+	/*
+	 * The designware core reserved the config aperture in the
+	 * resource tree (dw_pcie_host_get_resources). That punches a
+	 * hole into the single host bridge window on this SoC and the
+	 * PCI core then fails to assign endpoint BARs around it ("can't
+	 * assign; no space"). Config TLPs are routed by the outbound
+	 * iATU window index 0 and do not need the reservation, so drop
+	 * it here - still before pci_host_probe() - and let the BARs
+	 * span the whole window.
+	 */
+	if (pp->cfg0_size) {
+		dev_info(pci->dev, "DBG: releasing cfg0 reservation at %pa\n",
+			 &pp->cfg0_base);
+		release_mem_region(pp->cfg0_base, pp->cfg0_size);
+	}
+
+	/*
+	 * The Exynos8895 iATU registers are laid out inline in the DBI
+	 * config space (viewport at 0x900, region window at 0x904..0x91c),
+	 * not in a separate window at DEFAULT_DBI_ATU_OFFSET as the
+	 * designware core assumes. Point atu_base at the exynos layout so
+	 * the core's generic ATU offsets line up, otherwise the outbound
+	 * window is never programmed and endpoint BAR reads abort.
+	 */
+	pci->atu_base = pci->dbi_base + PCIE_ATU_VIEWPORT + 4;
+
+	dev_info(ep->pci.dev, "DBG: perst+wlan_en assert\n");
+	gpiod_set_value_cansleep(ep->perst_gpio, 1);
+	dev_info(ep->pci.dev, "DBG: perst set ok\n");
+	gpiod_set_value_cansleep(ep->wlan_en_gpio, 1);
+	dev_info(ep->pci.dev, "DBG: wlan_en set ok\n");
+	mdelay(100);
+	dev_info(ep->pci.dev, "DBG: after mdelay\n");
+
+	dev_info(ep->pci.dev, "DBG: pre sysreg read\n");
+	val = readl(sysreg + 0x0);
+	dev_info(ep->pci.dev, "DBG: sysreg[0]=0x%x\n", val);
+	writel(val & ~BIT(1), sysreg + 0x0);
+	dev_info(ep->pci.dev, "DBG: A sysreg pcie_ctrl done\n");
+
+	dev_info(ep->pci.dev, "DBG: B lane ctrl\n");
+	val = readl(sysreg + 0xc);
+	val &= ~(0xf << 4);
+	val &= ~(0xf << 2);
+	val |= (0x3 << 2);
+	val &= ~BIT(1);
+	writel(val, sysreg + 0xc);
+
+	dev_info(ep->pci.dev, "DBG: C pmu isolation release\n");
+	writel(readl(pmu + 0x71c) | BIT(0), pmu + 0x71c);
+
+	dev_info(ep->pci.dev, "DBG: D phy cal cmn\n");
+	for (i = 0; i < ARRAY_SIZE(dbg_cmn); i++)
+		writel(dbg_cmn[i], phy + i * 4);
+
+	dev_info(ep->pci.dev, "DBG: D2 phy cal trsv\n");
+	for (i = 0; i < ARRAY_SIZE(dbg_trsv); i++)
+		writel(dbg_trsv[i], phy + (0x30 + i) * 4);
+
+	dev_info(ep->pci.dev, "DBG: E pcs\n");
+	writel(0x70, pcs + 0xf8);
+	writel(0x87, pcs + 0x100);
+	writel(0x50, pcs + 0x104);
+	val = readl(pcs + 0xc);
+	val &= ~BIT(1);
+	val |= BIT(4);
+	writel(val, pcs + 0xc);
+
+	dev_info(ep->pci.dev, "DBG: F soft core reset\n");
+	exynos_pcie_writel(pci->elbi_base, 0, PCIE_8895_ELBI_SOFT_CORE_RESET);
+	udelay(20);
+	exynos_pcie_writel(pci->elbi_base, 1, PCIE_8895_ELBI_SOFT_CORE_RESET);
+
+	dev_info(ep->pci.dev, "DBG: G elbi glue\n");
+	val = exynos_pcie_readl(pci->elbi_base, PCIE_8895_ELBI_APP_REQ_EXIT_L1);
+	val |= 0x1 | (0x1 << 4);
+	exynos_pcie_writel(pci->elbi_base, val, PCIE_8895_ELBI_APP_REQ_EXIT_L1);
+	exynos_pcie_writel(pci->elbi_base, 0x2, PCIE_8895_ELBI_LINKDOWN_RST_CTRL_SEL);
+	val = exynos_pcie_readl(pci->elbi_base, PCIE_8895_ELBI_QCH_SEL);
+	val &= ~0xfff;
+	exynos_pcie_writel(pci->elbi_base, val, PCIE_8895_ELBI_QCH_SEL);
+	exynos_pcie_writel(pci->elbi_base, 1, PCIE_8895_ELBI_L1_BUG_FIX);
+	val = exynos_pcie_readl(pci->elbi_base, PCIE_8895_ELBI_STATE_HISTORY);
+	val |= 0x1;
+	exynos_pcie_writel(pci->elbi_base, val, PCIE_8895_ELBI_STATE_HISTORY);
+
+	dev_info(ep->pci.dev, "DBG: H irq pulse\n");
+	exynos_pcie_writel(pci->elbi_base, 0xf, PCIE_8895_ELBI_IRQ_EN_PULSE);
+
+	dev_info(ep->pci.dev, "DBG: host_init done (perst held)\n");
+	return 0;
+}
