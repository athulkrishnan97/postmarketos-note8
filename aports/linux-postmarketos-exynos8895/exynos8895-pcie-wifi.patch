+/*
+ * The DWC core only programs outbound MEM iATU windows from the bridge
+ * ranges when the bridge uses dw_child_pcie_ops or ECAM. This driver
+ * installs its own child config ops (the config aperture needs its own
+ * viewport setup), so the MEM windows are programmed here instead.
+ * Outbound window index 0 stays reserved for config accesses.
+ */
+static void exynos8895_pcie_prog_mem_atu(struct dw_pcie *pci)
+{
+	struct exynos_pcie *ep = to_exynos_pcie(pci);
+
+	/*
+	 * The SoC address decoder only routes 0x11800000-0x11c00000 (4 MiB)
+	 * to the PCIe AXI slave, and the bridge window is fully consumed by
+	 * BAR2 (4 MiB, assigned at 0x11800000). The last ~1 MiB of the
+	 * routed region cannot hold BAR2-sized space, so:
+	 *
+	 *  - idx1: CPU 0x11800000-0x11afffff -> PCI 0x11800000
+	 *    (BAR2 low 3 MiB, identity; the chip decodes the full 4 MiB
+	 *    BAR2 but host firmware/ring traffic lives below 3 MiB)
+	 *  - idx2: CPU 0x11b00000-0x11b07fff -> PCI 0x11c00000
+	 *    (BAR0 alias; BAR0 is assigned 0x11c00000, past the routed
+	 *    region, and the brcmfmac driver is patched to map regs at
+	 *    the alias)
+	 *
+	 * idx0 stays reserved for config TLPs at 0x11bff000.
+	 */
+	exynos_pcie_writel(pci->dbi_base, PCIE_ATU_REGION_DIR_OB | 1,
+			   EXYNOS_ATU_VIEWPORT);
+	exynos_pcie_writel(pci->dbi_base, EXYNOS_ATU_TYPE_MEM, EXYNOS_ATU_CR1);
+	exynos_pcie_writel(pci->dbi_base, 0x11800000, EXYNOS_ATU_LOWER_BASE);
+	exynos_pcie_writel(pci->dbi_base, 0, EXYNOS_ATU_UPPER_BASE);
+	exynos_pcie_writel(pci->dbi_base, 0x11afffff, EXYNOS_ATU_LIMIT);
+	exynos_pcie_writel(pci->dbi_base, 0x11800000, EXYNOS_ATU_LOWER_TARGET);
+	exynos_pcie_writel(pci->dbi_base, 0, EXYNOS_ATU_UPPER_TARGET);
+	exynos_pcie_writel(pci->dbi_base, EXYNOS_ATU_REGION_ENABLE,
+			   EXYNOS_ATU_CR2);
+	dev_info(ep->pci.dev,
+		 "DBG: ATU ob win1 0x11800000-0x11afffff -> 0x11800000 (BAR2 low 3M)\n");
+
+	exynos_pcie_writel(pci->dbi_base, PCIE_ATU_REGION_DIR_OB | 2,
+			   EXYNOS_ATU_VIEWPORT);
+	exynos_pcie_writel(pci->dbi_base, EXYNOS_ATU_TYPE_MEM, EXYNOS_ATU_CR1);
+	exynos_pcie_writel(pci->dbi_base, 0x11b00000, EXYNOS_ATU_LOWER_BASE);
+	exynos_pcie_writel(pci->dbi_base, 0, EXYNOS_ATU_UPPER_BASE);
+	exynos_pcie_writel(pci->dbi_base, 0x11b07fff, EXYNOS_ATU_LIMIT);
+	exynos_pcie_writel(pci->dbi_base, 0x11c00000, EXYNOS_ATU_LOWER_TARGET);
+	exynos_pcie_writel(pci->dbi_base, 0, EXYNOS_ATU_UPPER_TARGET);
+	exynos_pcie_writel(pci->dbi_base, EXYNOS_ATU_REGION_ENABLE,
+			   EXYNOS_ATU_CR2);
+	dev_info(ep->pci.dev,
+		 "DBG: ATU ob win2 0x11b00000-0x11b07fff -> 0x11c00000 (BAR0 alias)\n");
+}
+
+/*
+ * Start the link the way the downstream driver does: release PERST,
+ * give the endpoint time to come out of reset, assert the LTSSM and
+ * poll the RDLH link status with bounded retries.
+ */
+static int exynos8895_pcie_start_link(struct dw_pcie *pci)
+{
+	struct exynos_pcie *ep = to_exynos_pcie(pci);
+	int tries, count;
+	u32 val;
+
+	/*
+	 * The DWC core resets with MEM/LIMIT = 0, which decodes as a bogus
+	 * 1 MiB window at PCI address 0. Left set, the PCI resource core
+	 * treats it as fixed and refuses to assign endpoint BARs into the
+	 * host aperture. Disable it (with DBI writes unlocked) so the core
+	 * programs a real window from the host bridge ranges during the
+	 * upcoming bus scan.
+	 */
+	dw_pcie_dbi_ro_wr_en(pci);
+	dw_pcie_writew_dbi(pci, PCI_MEMORY_BASE, 0xfff0);
+	dw_pcie_writew_dbi(pci, PCI_MEMORY_LIMIT, 0x0000);
+	dw_pcie_writew_dbi(pci, PCI_PREF_MEMORY_BASE, 0xfff0);
+	dw_pcie_writew_dbi(pci, PCI_PREF_MEMORY_LIMIT, 0x0000);
+	dw_pcie_writel_dbi(pci, PCI_PREF_BASE_UPPER32, 0);
+	dw_pcie_writel_dbi(pci, PCI_PREF_LIMIT_UPPER32, 0);
+	dw_pcie_dbi_ro_wr_dis(pci);
+	dev_info(ep->pci.dev, "DBG: bridge windows disabled\n");
+
+	dev_info(ep->pci.dev, "DBG: start_link: release perst\n");
+	gpiod_set_value_cansleep(ep->perst_gpio, 0);
+	usleep_range(18000, 20000);
+
+	for (tries = 0; tries < 10; tries++) {
+		exynos_pcie_writel(pci->elbi_base, 0x1,
+				   PCIE_8895_ELBI_APP_LTSSM_ENABLE);
+		count = 0;
+		while (count < 1000) {
+			val = exynos_pcie_readl(pci->elbi_base,
+						PCIE_8895_ELBI_RDLH_LINKUP) & 0x1f;
+			if (val >= 0x0d && val <= 0x14)
+				break;
+			count++;
+			udelay(10);
+		}
+		if (count < 1000) {
+			dev_info(ep->pci.dev, "DBG: link up, rdlh=0x%x\n", val);
+			exynos8895_pcie_prog_mem_atu(pci);
+			return 0;
+		}
+		dev_info(ep->pci.dev, "DBG: link try %d failed rdlh=0x%x\n",
+			 tries, val);
+		gpiod_set_value_cansleep(ep->perst_gpio, 1);
+		usleep_range(9000, 11000);
+		gpiod_set_value_cansleep(ep->perst_gpio, 0);
+		usleep_range(18000, 20000);
+	}
+
+	return -ETIMEDOUT;
+}
