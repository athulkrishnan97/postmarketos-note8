+#define S2MPS17_REG_B3OUT			0x1E
+#define S2MPS17_REG_B4CTRL		0x1F
+#define S2MPS17_REG_B4OUT			0x20
+#define S2MPS17_REG_B5CTRL		0x21
+#define S2MPS17_REG_B5OUT			0x22
