+static void __init exynos8895_cmu_g3d_init(struct device_node *np)
+{
+	/*
+	 * Clock registration only.  The hardware bootstrap (embedded
+	 * power domain, PLL, gates) cannot run here: at of_clk_init time
+	 * the G3D block may not be clocked yet (its PCLK derives from
+	 * the very mux/PLL being set up), and writes get dropped.  It is
+	 * done by the g3d bootstrap initcall below, which runs after DT
+	 * population with the clk framework fully up, and before
+	 * panfrost probes.
+	 */
+	exynos_arm64_register_cmu(NULL, np, &g3d_cmu_info);
+}
+
+CLK_OF_DECLARE(exynos8895_cmu_g3d, "samsung,exynos8895-cmu-g3d",
+	       exynos8895_cmu_g3d_init);
+
+/*
+ * G3D bootstrap - bisection harness.
+ *
+ * Round-4/5 lesson: with the register sequence executed at boot, some
+ * write poisoned clocks of unrelated subsystems (speedy, serial,
+ * pcie-phy) and wedged the system.  To find the offending step without
+ * spending a flash cycle per guess, nothing runs at boot anymore:
+ * this initcall only maps the CMU_G3D registers and creates a debugfs
+ * control file.  Each step is executed manually ("echo N > g3d_step"),
+ * one at a time, with every sub-write read back and logged, so the
+ * tester can check the rest of the system (serial/BT, speedy, pcie)
+ * after each step and pinpoint the poison.
+ *
+ * Steps:
+ *   1 - pmucal g3d_on pre-writes (0x148, 0x140, 0x100)
+ *   2 - enable the cmu_g3d "switch" clock (CMU_TOP chain)
+ *   3 - busd mux -> switch_user (alternate parent)
+ *   4 - PLL locktime + CON0 MPS|ENABLE, bounded STABLE poll
+ *   5 - busd mux -> fout_g3d_pll
+ *   6 - ungate AGPU (0x201c) + CMU PCLK (0x2004)
+ *   9 - steps 1-6 in order
+ * Reading the file dumps the raw registers.
+ */
+#include <linux/debugfs.h>
+#include <linux/uaccess.h>
+
+static void __iomem *g3d_base;
+static struct device_node *g3d_np;
+static struct clk *g3d_switch_clk;
+
+static int g3d_reg_update(void __iomem *base, u32 off, u32 mask, u32 val,
+			  const char *name)
+{
+	u32 readback;
+	int t;
+
+	for (t = 0; t < 3; t++) {
+		readback = (readl(base + off) & ~mask) | (val & mask);
+		writel(readback, base + off);
+		readback = readl(base + off);
+		if ((readback & mask) == (val & mask)) {
+			pr_info("g3d: %s reg[0x%03x] = 0x%x (ok)\n",
+				name, off, readback);
+			return 0;
+		}
+		pr_info("g3d: %s reg[0x%03x] write retry %d (readback 0x%x)\n",
+			name, off, t + 1, readback);
+		udelay(10);
+	}
+	pr_err("g3d: %s reg[0x%03x] write NOT sticking (readback 0x%x)\n",
+	       name, off, readback);
+	return -EIO;
+}
+
+static int g3d_step_pre(void)
+{
+	g3d_reg_update(g3d_base, 0x148, 0xffffffff, 0x30000003,
+		       "pmucal PLL_CON2 (0x148)");
+	g3d_reg_update(g3d_base, 0x140, BIT(4), BIT(4),
+		       "pmucal PLL_CON0 enable (0x140)");
+	g3d_reg_update(g3d_base, PLL_CON0_MUX_CLKCMU_G3D_SWITCH_USER,
+		       BIT(4), BIT(4), "switch_user mux select (0x100)");
+	return 0;
+}
+
+static int g3d_step_switch(void)
+{
+	int ret;
+
+	if (!g3d_np) {
+		pr_err("g3d: cmu_g3d node not saved\n");
+		return -ENODEV;
+	}
+	if (!g3d_switch_clk) {
+		g3d_switch_clk = of_clk_get_by_name(g3d_np, "switch");
+		if (IS_ERR(g3d_switch_clk)) {
+			pr_warn("g3d: switch clock lookup failed (%ld)\n",
+				PTR_ERR(g3d_switch_clk));
+			g3d_switch_clk = NULL;
+			return -ENOENT;
+		}
+	}
+	ret = clk_prepare_enable(g3d_switch_clk);
+	pr_info("g3d: switch clock %s, rate %lu\n",
+		ret ? "FAILED to enable" : "enabled",
+		clk_get_rate(g3d_switch_clk));
+	return ret;
+}
+
+static struct clk *g3d_busd_clk;
+
+static int g3d_step_mux_ccf(unsigned int idx, const char *what)
+{
+	struct device_node *gpu_np;
+	struct clk_hw *hw, *parent;
+	int i, ret;
+
+	/*
+	 * Switch the busd parent THROUGH the clock framework: a raw
+	 * register write leaves CCF believing the parent is still the
+	 * (off) PLL, and panfrost's clk_set_rate() then propagates to
+	 * the PLL instead of the TOP switch.  The samsung mux's
+	 * set_parent performs the hardware write; we just verify it.
+	 */
+	if (!g3d_busd_clk) {
+		gpu_np = of_find_compatible_node(NULL, NULL, "arm,mali-bifrost");
+		if (!gpu_np)
+			return -ENODEV;
+		g3d_busd_clk = of_clk_get(gpu_np, 0);
+		of_node_put(gpu_np);
+		if (IS_ERR(g3d_busd_clk)) {
+			pr_warn("g3d: busd clock lookup failed (%ld)\n",
+				PTR_ERR(g3d_busd_clk));
+			g3d_busd_clk = NULL;
+			return -ENOENT;
+		}
+	}
+	hw = __clk_get_hw(g3d_busd_clk);
+	parent = clk_hw_get_parent_by_index(hw, idx);
+	if (!parent)
+		return -ENOENT;
+	ret = clk_hw_set_parent(hw, parent);
+	if (ret)
+		pr_err("g3d: CCF parent switch to %s failed (%d)\n",
+		       clk_hw_get_name(parent), ret);
+	else
+		pr_info("g3d: CCF parent -> %s\n", clk_hw_get_name(parent));
+	for (i = 0; i < 10000; i++) {
+		if (!(readl(g3d_base + CLK_CON_MUX_MUX_CLK_G3D_BUSD) & BIT(16)))
+			break;
+		udelay(10);
+	}
+	pr_info("g3d: busd mux %s reg 0x%x\n", what,
+		readl(g3d_base + CLK_CON_MUX_MUX_CLK_G3D_BUSD));
+	return ret;
+}
+
+static int g3d_step_mux_alt(void)
+{
+	return g3d_step_mux_ccf(1, "-> switch_user");
+}
+
+static int g3d_step_pll(void)
+{
+	u32 con0;
+	bool on = false;
+	int i, t;
+
+	if (!readl(g3d_base + PLL_LOCKTIME_PLL_G3D))
+		g3d_reg_update(g3d_base, PLL_LOCKTIME_PLL_G3D, 0xffffffff,
+			       0x258, "locktime");
+
+	for (t = 0; t < 3 && !on; t++) {
+		con0 = readl(g3d_base + PLL_CON0_PLL_G3D);
+		pr_info("g3d: PLL CON0 = 0x%x\n", con0);
+		if (con0 & BIT(29)) {
+			on = true;
+			break;
+		}
+		con0 &= ~((0x3ff << 16) | (0x3f << 8) | 0x7);
+		con0 |= (168 << 16) | (4 << 8) | 1 | BIT(31);
+		writel(con0, g3d_base + PLL_CON0_PLL_G3D);
+		for (i = 0; i < 10000; i++) {
+			con0 = readl(g3d_base + PLL_CON0_PLL_G3D);
+			if (con0 & BIT(29)) {
+				on = true;
+				break;
+			}
+			udelay(10);
+		}
+		pr_info("g3d: PLL lock attempt %d %s (CON0 0x%x)\n",
+			t + 1, on ? "ok" : "FAILED", con0);
+	}
+	if (!on)
+		pr_err("g3d: PLL did not lock\n");
+	return on ? 0 : -ETIMEDOUT;
+}
+
+static int g3d_step_mux_pll(void)
+{
+	return g3d_step_mux_ccf(0, "-> g3d_pll");
+}
+
+static int g3d_step_gates(void)
+{
+	g3d_reg_update(g3d_base, CLK_CON_GAT_GATE_CLK_G3D_AGPU,
+		       BIT(21) | BIT(20), BIT(21) | BIT(20), "AGPU gate");
+	g3d_reg_update(g3d_base,
+		       CLK_CON_GAT_CLK_BLK_G3D_UID_G3D_CMU_G3D_IPCLKPORT_PCLK,
+		       BIT(21) | BIT(20), BIT(21) | BIT(20), "CMU PCLK gate");
+	return 0;
+}
+
+static ssize_t g3d_step_read(struct file *file, char __user *ubuf,
+			     size_t count, loff_t *ppos)
+{
+	char buf[512];
+	int len;
+
+	if (!g3d_base)
+		return simple_read_from_buffer(ubuf, count, ppos,
+					       "g3d: not mapped\n", 17);
+
+	len = scnprintf(buf, sizeof(buf),
+		"g3d regs: locktime[0x000]=0x%x pre[0x100]=0x%x [0x140]=0x%x [0x148]=0x%x pll[0x120]=0x%x con1[0x124]=0x%x mux[0x1000]=0x%x cmu_pclk[0x2004]=0x%x agpu[0x201c]=0x%x\n",
+		readl(g3d_base + PLL_LOCKTIME_PLL_G3D),
+		readl(g3d_base + PLL_CON0_MUX_CLKCMU_G3D_SWITCH_USER),
+		readl(g3d_base + 0x140),
+		readl(g3d_base + 0x148),
+		readl(g3d_base + PLL_CON0_PLL_G3D),
+		readl(g3d_base + 0x124),
+		readl(g3d_base + CLK_CON_MUX_MUX_CLK_G3D_BUSD),
+		readl(g3d_base +
+		      CLK_CON_GAT_CLK_BLK_G3D_UID_G3D_CMU_G3D_IPCLKPORT_PCLK),
+		readl(g3d_base + CLK_CON_GAT_GATE_CLK_G3D_AGPU));
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static ssize_t g3d_step_write(struct file *file, const char __user *ubuf,
+			      size_t count, loff_t *ppos)
+{
+	char buf[8];
+	unsigned long step;
+	int (*fn)(void) = NULL;
+	int ret = 0;
+
+	if (!g3d_base || count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+	if (kstrtoul(buf, 0, &step))
+		return -EINVAL;
+
+	pr_info("g3d: step %lu requested\n", step);
+	switch (step) {
+	case 1:
+		fn = g3d_step_pre;
+		break;
+	case 2:
+		fn = g3d_step_switch;
+		break;
+	case 3:
+		fn = g3d_step_mux_alt;
+		break;
+	case 4:
+		fn = g3d_step_pll;
+		break;
+	case 5:
+		fn = g3d_step_mux_pll;
+		break;
+	case 6:
+		fn = g3d_step_gates;
+		break;
+	case 9:
+		ret |= g3d_step_pre();
+		ret |= g3d_step_switch();
+		ret |= g3d_step_mux_alt();
+		ret |= g3d_step_pll();
+		ret |= g3d_step_mux_pll();
+		ret |= g3d_step_gates();
+		pr_info("g3d: full sequence done (%d)\n", ret);
+		return count;
+	default:
+		return -EINVAL;
+	}
+
+	ret = fn();
+	pr_info("g3d: step %lu done (%d)\n", step, ret);
+	return count;
+}
+
+static const struct file_operations g3d_step_fops = {
+	.read = g3d_step_read,
+	.write = g3d_step_write,
+	.owner = THIS_MODULE,
+};
+
+static int __init exynos8895_g3d_bootstrap_init(void)
+{
+	g3d_np = of_find_compatible_node(NULL, NULL,
+					 "samsung,exynos8895-cmu-g3d");
+	if (!g3d_np) {
+		pr_err("g3d: cmu_g3d node not found\n");
+		return 0;
+	}
+	g3d_base = of_iomap(g3d_np, 0);
+	if (!g3d_base) {
+		of_node_put(g3d_np);
+		g3d_np = NULL;
+		pr_err("g3d: cannot map CMU_G3D registers\n");
+		return 0;
+	}
+
+	debugfs_create_file("g3d_step", 0644, NULL, NULL, &g3d_step_fops);
+	pr_info("g3d: bootstrap idle (runtime-steppable via debugfs g3d_step)\n");
+	return 0;
+}
+device_initcall(exynos8895_g3d_bootstrap_init);
+
