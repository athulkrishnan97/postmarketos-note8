# Reference: <https://postmarketos.org/devicepkg>
maintainer="athul <athul@postmarketos.org>"
pkgname=device-samsung-greatlte
pkgdesc="Samsung Galaxy Note 8"
pkgver=1
pkgrel=2
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	device-samsung-greatlte-kernel
	mkbootimg
	postmarketos-base
	uniloader-samsung-greatlte
"
makedepends="devicepkg-dev"
subpackages="$pkgname-kernel:kernel"
source="deviceinfo"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

kernel() {
	pkgdesc="Kernel for the Samsung Galaxy Note 8"
	depends="$pkgname linux-postmarketos-exynos8895"
	mkdir "$subpkgdir"
}

