#!/bin/sh
# greatlte: after boot, let schedutil scale both clusters up to the stock
# maxima (2.314 GHz big / 1.69 GHz little). The TMU thermal zone throttles
# from 83 C. Switching only after boot: running at full speed while udev
# loads modules has oopsed before.
n=0
while [ $n -lt 60 ]; do
	[ -d /sys/devices/system/cpu/cpu4/cpufreq ] && break
	sleep 2
	n=$((n+1))
done
sleep 3
for p in /sys/devices/system/cpu/cpu0/cpufreq /sys/devices/system/cpu/cpu4/cpufreq; do
	[ -d "$p" ] && echo schedutil > "$p/scaling_governor" 2>/dev/null
done
echo "cpuspeed: governors set" > /dev/kmsg 2>/dev/null
