#!/bin/sh
# greatlte: after boot, raise CPUs to the validated max (1.7GHz big /
# 1.69GHz little) with voltage scaling. Booting AT these speeds races
# udev module loading and can oops; switching after boot is proven.
n=0
while [ $n -lt 60 ]; do
	[ -d /sys/devices/system/cpu/cpu4/cpufreq ] && break
	sleep 2
	n=$((n+1))
done
sleep 3
for p in /sys/devices/system/cpu/cpu0/cpufreq /sys/devices/system/cpu/cpu4/cpufreq; do
	[ -d "$p" ] && echo performance > "$p/scaling_governor" 2>/dev/null
done
echo "cpuspeed: governors set" > /dev/kmsg 2>/dev/null
